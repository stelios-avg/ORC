# ─────────────────────────────────────────────────────────────
# ORC Osteopathy & Rehabilitation Center — environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# Fresha booking URL the pre-booking form redirects to after validation.
# Public (exposed to the browser) because the redirect happens client-side.
PUBLIC_FRESHA_BOOKING_URL="https://www.fresha.com/a/orc-til-96322622-osteopathitikos-haralampos-neokleoys-strovolos-aitolon-aitolon-bnk279fh"

# ── Sanity (Headless CMS) — wired up later ──
# These are read in src/lib/sanity.ts. Leave blank until Sanity is set up.
PUBLIC_SANITY_PROJECT_ID=""
PUBLIC_SANITY_DATASET="production"
PUBLIC_SANITY_API_VERSION="2024-01-01"
# Server-only token (NEVER prefix with PUBLIC_). Only needed for drafts/writes.
SANITY_API_READ_TOKEN=""

# ── Optional: where pre-booking lead submissions are POSTed ──
# If empty, the form skips the network call and redirects straight to Fresha.
PUBLIC_LEAD_ENDPOINT=""
