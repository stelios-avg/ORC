---
import { SITE } from "../config/site";
import { useTranslations, type Lang } from "../i18n";

interface Props { lang?: Lang; }
const { lang = "el" } = Astro.props;
const t = useTranslations(lang);

const base = lang === "el" ? "" : "/en";
const navLinks = [
  { label: t.nav.home,     href: `${base}/` },
  { label: t.nav.bio,      href: `${base}/bio/` },
  { label: t.nav.services, href: `${base}/services/` },
  { label: t.nav.gallery,  href: `${base}/gallery/` },
  { label: t.nav.contact,  href: `${base}/contact/` },
];

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-spine-900 text-slate-300">
  {/* Ambient background video behind a heavy overlay for readability */}
  <video
    class="absolute inset-0 h-full w-full object-cover"
    autoplay muted loop playsinline preload="metadata"
    aria-hidden="true"
  >
    <source src="/videos/footer-bg.mp4" type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-gradient-to-b from-spine-900/95 via-spine-900/85 to-spine-900/95"></div>

  <div class="relative mx-auto max-w-7xl px-5 pb-10 pt-16 sm:px-6 sm:pt-20 lg:px-8">

    {/* Editorial statement row */}
    <div class="border-b border-white/10 pb-12 sm:pb-16">
      <img
        src={SITE.logo}
        alt={SITE.name}
        width="200"
        height="88"
        class="h-14 w-auto object-contain brightness-0 invert sm:h-16"
        loading="lazy"
      />
      <p class="mt-5 max-w-md text-base leading-relaxed text-slate-400 sm:text-lg">
        {t.footer.tagline}
      </p>
    </div>

    {/* Info columns — medwest-style labels */}
    <div class="grid grid-cols-1 gap-10 py-12 sm:grid-cols-2 sm:py-16 lg:grid-cols-4">
      <div>
        <h3 class="text-xs font-semibold tracking-wide text-spine-300">{t.footer.findUs}</h3>
        <p class="mt-4 text-base leading-relaxed text-slate-300">
          {SITE.name}<br />
          {t.address}
        </p>
      </div>

      <div>
        <h3 class="text-xs font-semibold tracking-wide text-spine-300">{t.footer.hoursTitle}</h3>
        <ul class="mt-4 space-y-1.5 text-base text-slate-300">
          {t.hours.map((h) => (
            <li class="flex justify-between gap-4 sm:max-w-[230px]">
              <span class="text-slate-400">{h.day}</span>
              <span>{h.time}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold tracking-wide text-spine-300">{t.footer.sayHello}</h3>
        <p class="mt-4 space-y-1 text-base">
          <a href={SITE.phoneHref} class="link-draw block w-fit py-1 text-slate-300 transition hover:text-white">{SITE.phone}</a>
          <a href={`mailto:${SITE.email}`} class="link-draw block w-fit py-1 text-slate-300 transition hover:text-white">{SITE.email}</a>
        </p>
      </div>

      <div>
        <h3 class="text-xs font-semibold tracking-wide text-spine-300">{t.footer.followUs}</h3>
        <ul class="mt-4 flex items-center gap-3">
          <li>
            <a
              href={SITE.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="flex h-12 w-12 items-center justify-center rounded-full border border-white/20 text-slate-300 transition-all duration-300 hover:scale-110 hover:border-white hover:bg-white hover:text-spine-900"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect>
                <circle cx="12" cy="12" r="4.2"></circle>
                <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none"></circle>
              </svg>
            </a>
          </li>
          <li>
            <a
              href={SITE.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              class="flex h-12 w-12 items-center justify-center rounded-full border border-white/20 text-slate-300 transition-all duration-300 hover:scale-110 hover:border-white hover:bg-white hover:text-spine-900"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M13.5 21v-7h2.4l.45-3H13.5V9.1c0-.87.28-1.6 1.66-1.6h1.34V4.8c-.65-.09-1.36-.17-2.2-.17-2.18 0-3.8 1.33-3.8 4.1V11H8v3h2.5v7h3z"></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom bar */}
    <div class="flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center">
      <p class="text-xs text-slate-500">
        &copy; {year} {SITE.name}. {t.footer.rights}
        {" "}
        <span class="text-slate-600">·</span>
        {" "}
        <a
          href="https://pixel-studio.design"
          target="_blank"
          rel="noopener noreferrer"
          class="transition hover:text-white"
        >
          Pixel Studio Design
        </a>
      </p>
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="text-xs text-slate-500 transition hover:text-white">{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
