---
import { SITE } from "../config/site";
import { useTranslations, type Lang } from "../i18n";

interface Props { lang?: Lang; }
const { lang = "el" } = Astro.props;
const t = useTranslations(lang);

const base = lang === "el" ? "" : "/en";
const navLinks = [
  { label: t.nav.home,     href: `${base}/` },
  { label: t.nav.bio,      href: `${base}/bio/` },
  { label: t.nav.services, href: `${base}/services/` },
  { label: t.nav.gallery,  href: `${base}/gallery/` },
  { label: t.nav.contact,  href: `${base}/contact/` },
];

const year = new Date().getFullYear();
---

<footer class="bg-spine-900 text-slate-300">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-4">
      {/* Brand */}
      <div class="md:col-span-1">
        <div class="inline-flex rounded-xl bg-white p-3">
          <img
            src={SITE.logo}
            alt={SITE.name}
            width="200"
            height="64"
            class="h-14 w-auto object-contain"
            loading="lazy"
          />
        </div>
        <p class="mt-4 text-sm leading-relaxed text-slate-400">
          {t.footer.tagline}
        </p>
      </div>

      {/* Quick links */}
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">{t.footer.exploreTitle}</h3>
        <ul class="mt-4 space-y-2 text-sm">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-slate-400 transition hover:text-white">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      {/* Contact */}
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">{t.footer.contactTitle}</h3>
        <ul class="mt-4 space-y-2 text-sm text-slate-400">
          <li><a href={SITE.phoneHref} class="transition hover:text-white">{SITE.phone}</a></li>
          <li><a href={`mailto:${SITE.email}`} class="transition hover:text-white">{SITE.email}</a></li>
          <li>{SITE.address}</li>
        </ul>
      </div>

      {/* Hours + CTA */}
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">{t.footer.hoursTitle}</h3>
        <ul class="mt-4 space-y-1.5 text-sm text-slate-400">
          {SITE.hours.map((h) => (
            <li class="flex justify-between gap-4">
              <span>{h.day}</span>
              <span class="text-slate-300">{h.time}</span>
            </li>
          ))}
        </ul>
        <button
          type="button"
          data-book-trigger
          class="mt-5 w-full rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-spine-900 transition hover:bg-spine-50"
        >
          {t.footer.cta}
        </button>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row">
      <p class="text-xs text-slate-500">
        &copy; {year} {SITE.name}. {t.footer.rights}
      </p>
      <div class="flex items-center gap-4 text-slate-400">
        <a href={SITE.social.instagram} aria-label="Instagram" class="transition hover:text-white">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.1.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.1-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.1-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.1 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.1 0-3.5 0-4.7.1-1.1 0-1.7.2-2.1.4-.5.2-.9.4-1.2.8-.4.3-.6.7-.8 1.2-.2.4-.3 1-.4 2.1C2.8 9.8 2.8 10.2 2.8 12s0 2.2.1 3.4c0 1.1.2 1.7.4 2.1.2.5.4.9.8 1.2.3.4.7.6 1.2.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1 0 1.7-.2 2.1-.4.5-.2.9-.4 1.2-.8.4-.3.6-.7.8-1.2.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-3.4s0-2.2-.1-3.4c0-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.2-.3-.4-.7-.6-1.2-.8-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1Zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 1.8a3.1 3.1 0 1 0 0 6.2 3.1 3.1 0 0 0 0-6.2Zm5.1-.7a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z"></path></svg>
        </a>
        <a href={SITE.social.facebook} aria-label="Facebook" class="transition hover:text-white">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z"></path></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
