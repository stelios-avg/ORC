---
import { SITE } from "../config/site";
import { useTranslations, getAlternatePath, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
}
const { lang = "el" } = Astro.props;
const t = useTranslations(lang);

const { pathname } = Astro.url;
const base = lang === "el" ? "" : "/en";
const navLinks = [
  { label: t.nav.home,     href: `${base}/` },
  { label: t.nav.bio,      href: `${base}/bio/` },
  { label: t.nav.services, href: `${base}/services/` },
  { label: t.nav.gallery,  href: `${base}/gallery/` },
  { label: t.nav.contact,  href: `${base}/contact/` },
];
const isActive = (href: string) =>
  href === `${base}/` ? pathname === href : pathname.startsWith(href);

const alternatePath = getAlternatePath(pathname, lang);
---

{/* ── Minimal fixed top bar ─────────────────────────────────────────── */}
<header id="site-header" data-state="dark" class="fixed inset-x-0 top-0 z-[95]">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-4 lg:px-8">
    <a
      href={`${base}/`}
      class="flex items-center"
      aria-label={`${SITE.name} — ${lang === "el" ? "αρχική" : "home"}`}
    >
      <img
        id="nav-logo"
        src={SITE.logo}
        alt={SITE.name}
        width="220"
        height="70"
        class="nav-logo h-11 w-auto object-contain sm:h-14"
        loading="eager"
      />
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      {/* Language switcher */}
      <a
        href={alternatePath}
        class="nav-pill rounded-full border px-3 py-2 font-display text-xs font-semibold transition-colors duration-300"
        aria-label={t.nav.switchLangLabel}
        hreflang={lang === "el" ? "en" : "el"}
      >
        {t.nav.switchLang}
      </a>

      {/* Book CTA — short label on mobile, full on sm+ */}
      <button
        type="button"
        data-book-trigger
        class="nav-cta rounded-full px-4 py-2 font-display text-xs font-semibold transition-colors duration-300 sm:px-5 sm:py-2.5 sm:text-sm"
      >
        <span class="sm:hidden">{t.nav.bookShort}</span>
        <span class="hidden sm:inline">{t.nav.book}</span>
      </button>

      {/* Menu toggle — medwest-style outlined box with label */}
      <button
        id="menu-btn"
        type="button"
        class="nav-burger flex h-11 items-center gap-2.5 rounded-md border px-3 transition-colors duration-300 sm:px-4"
        aria-controls="nav-overlay"
        aria-expanded="false"
        aria-label={t.nav.menu}
      >
        <span class="menu-label hidden font-display text-xs font-bold tracking-wide sm:inline">
          {t.nav.menu}
        </span>
        <span class="relative flex h-4 w-5 items-center justify-center">
          <span class="burger-line absolute h-[2px] w-5 -translate-y-[4px] rounded-full transition-all duration-300"></span>
          <span class="burger-line absolute h-[2px] w-5 translate-y-[4px] rounded-full transition-all duration-300"></span>
        </span>
      </button>
    </div>
  </nav>
</header>

{/* ── Fullscreen overlay menu (light, dot-grid — medwest style) ─────── */}
<div
  id="nav-overlay"
  class="fixed inset-0 z-[90] flex flex-col bg-sand"
  aria-hidden="true"
>
  {/* Faded watermark, like medwest's faded photo backdrop */}
  <img
    src={SITE.logo}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute bottom-[-4%] right-[-6%] w-[70%] max-w-3xl select-none opacity-[0.05]"
  />

  <div class="relative flex min-h-0 flex-1 flex-col overflow-y-auto px-6 pb-8 pt-28 sm:px-10 lg:px-16">
    {/* Dot-grid nav links */}
    <nav class="my-auto">
      <ul class="grid grid-cols-1 gap-x-10 gap-y-7 sm:grid-cols-2 sm:gap-y-12 lg:grid-cols-3">
        {navLinks.map((link, i) => (
          <li class="menu-item" style={`--i: ${i}`}>
            <a
              href={link.href}
              class:list={[
                "menu-link group flex min-h-12 items-center gap-5 sm:gap-6",
                i % 2 === 1 ? "max-sm:flex-row-reverse" : "",
              ]}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              <span
                class:list={[
                  "menu-dot relative h-14 w-14 flex-none rounded-full bg-spine transition-transform duration-500 ease-out sm:h-12 sm:w-12",
                  isActive(link.href)
                    ? "scale-[1.35] sm:scale-[1.6]"
                    : "group-hover:scale-[1.5] sm:group-hover:scale-[1.9]",
                ]}
              ></span>
              <span
                class:list={[
                  "font-display text-lg font-semibold transition-colors duration-300 sm:text-xl",
                  isActive(link.href) ? "text-spine" : "text-charcoal group-hover:text-spine",
                ]}
              >
                {link.label}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* Bottom: contact + book */}
    <div class="menu-item mt-10 grid gap-6 border-t border-charcoal/10 pt-6 sm:grid-cols-3 sm:items-end" style="--i: 5">
      <div>
        <p class="text-xs font-semibold tracking-wide text-spine">{t.footer.findUs}</p>
        <p class="mt-2 text-sm leading-relaxed text-charcoal-muted">{t.address}</p>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-wide text-spine">{t.footer.sayHello}</p>
        <p class="mt-2 text-sm text-charcoal-muted">
          <a href={SITE.phoneHref} class="block py-0.5 transition hover:text-spine">{SITE.phone}</a>
          <a href={`mailto:${SITE.email}`} class="block py-0.5 transition hover:text-spine">{SITE.email}</a>
        </p>
      </div>
      <button
        type="button"
        data-book-trigger
        class="w-full rounded-full bg-spine px-6 py-4 font-display text-base font-semibold text-white transition hover:bg-spine-600 sm:w-auto"
      >
        {t.nav.book}
      </button>
    </div>
  </div>
</div>

<style>
  /* ── Header colour states ── */
  #site-header {
    transition: background-color 0.35s ease, box-shadow 0.35s ease;
  }

  /* dark = over hero/page-header (transparent, white items) */
  #site-header[data-state="dark"] .nav-logo { filter: brightness(0) invert(1); }
  #site-header[data-state="dark"] .nav-pill { border-color: rgb(255 255 255 / 0.4); color: rgb(255 255 255 / 0.85); }
  #site-header[data-state="dark"] .nav-pill:hover { border-color: #fff; color: #fff; }
  #site-header[data-state="dark"] .nav-cta { border: 1px solid rgb(255 255 255 / 0.7); background: rgb(255 255 255 / 0.1); color: #fff; backdrop-filter: blur(8px); }
  #site-header[data-state="dark"] .nav-cta:hover { background: rgb(255 255 255 / 0.22); }
  #site-header[data-state="dark"] .nav-burger { border-color: rgb(255 255 255 / 0.55); color: #fff; }
  #site-header[data-state="dark"] .nav-burger:hover { background: rgb(255 255 255 / 0.12); border-color: #fff; }
  #site-header[data-state="dark"] .burger-line { background: #fff; }

  /* solid = scrolled (white bar, brand items) */
  #site-header[data-state="solid"] { background: rgb(255 255 255 / 0.92); backdrop-filter: blur(10px); box-shadow: 0 1px 2px rgb(10 22 34 / 0.06); }
  #site-header[data-state="solid"] .nav-pill { border-color: var(--color-spine-100); color: var(--color-charcoal-muted); }
  #site-header[data-state="solid"] .nav-pill:hover { border-color: var(--color-spine); color: var(--color-spine); }
  #site-header[data-state="solid"] .nav-cta { background: var(--color-spine); color: #fff; }
  #site-header[data-state="solid"] .nav-cta:hover { background: var(--color-spine-600); }
  #site-header[data-state="solid"] .nav-burger { border-color: var(--color-spine); color: var(--color-spine); }
  #site-header[data-state="solid"] .nav-burger:hover { background: var(--color-spine-50); }
  #site-header[data-state="solid"] .burger-line { background: var(--color-spine); }

  /* menu open: overlay is LIGHT, so header items go brand/charcoal */
  #site-header[data-menu="open"] { background: transparent; box-shadow: none; }
  #site-header[data-menu="open"] .nav-logo { filter: none; }
  #site-header[data-menu="open"] .nav-pill { border-color: var(--color-spine-100); color: var(--color-charcoal-muted); }
  #site-header[data-menu="open"] .nav-pill:hover { border-color: var(--color-spine); color: var(--color-spine); }
  #site-header[data-menu="open"] .nav-cta { border: none; background: var(--color-spine); color: #fff; backdrop-filter: none; }
  #site-header[data-menu="open"] .nav-cta:hover { background: var(--color-spine-600); }
  #site-header[data-menu="open"] .nav-burger { border-color: var(--color-spine); color: var(--color-spine); }
  #site-header[data-menu="open"] .burger-line { background: var(--color-spine); }
  #site-header[data-menu="open"] .burger-line:first-child { transform: translateY(0) rotate(45deg); }
  #site-header[data-menu="open"] .burger-line:last-child { transform: translateY(0) rotate(-45deg); }

  /* ── Overlay open/close + staggered items ── */
  #nav-overlay {
    visibility: hidden;
    opacity: 0;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 0.6s cubic-bezier(0.76, 0, 0.24, 1),
      opacity 0.4s ease,
      visibility 0s linear 0.6s;
  }
  #nav-overlay.open {
    visibility: visible;
    opacity: 1;
    clip-path: inset(0 0 0% 0);
    transition:
      clip-path 0.6s cubic-bezier(0.76, 0, 0.24, 1),
      opacity 0.3s ease,
      visibility 0s;
  }
  .menu-item {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #nav-overlay.open .menu-item {
    opacity: 1;
    transform: none;
    transition-delay: calc(150ms + var(--i) * 60ms);
  }

  @media (prefers-reduced-motion: reduce) {
    #nav-overlay, #nav-overlay.open { transition: opacity 0.2s ease, visibility 0s; clip-path: none; }
    .menu-item, #nav-overlay.open .menu-item { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  const header  = document.getElementById("site-header")!;
  const overlay = document.getElementById("nav-overlay")!;
  const menuBtn = document.getElementById("menu-btn")!;

  let menuOpen = false;

  // ── Scroll: dark (transparent) at top → solid after threshold ──
  const onScroll = () => {
    if (menuOpen) return;
    header.dataset.state = window.scrollY > 60 ? "solid" : "dark";
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // ── Fullscreen menu toggle ──
  const setMenu = (open: boolean) => {
    menuOpen = open;
    overlay.classList.toggle("open", open);
    overlay.setAttribute("aria-hidden", String(!open));
    menuBtn.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("no-scroll", open);
    if (open) {
      header.dataset.menu = "open";
    } else {
      delete header.dataset.menu;
      onScroll();
    }
  };

  menuBtn.addEventListener("click", () => setMenu(!menuOpen));

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menuOpen) setMenu(false);
  });

  // Book button inside the menu: close the menu so the modal is unobstructed.
  overlay.querySelectorAll<HTMLElement>("[data-book-trigger]").forEach((el) => {
    el.addEventListener("click", () => setMenu(false));
  });

  // Nav links: the dot expands to cover the screen, then we navigate (medwest).
  const REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  overlay.querySelectorAll<HTMLAnchorElement>("a.menu-link").forEach((link) => {
    link.addEventListener("click", (e) => {
      // Let modified clicks (new tab etc.) and reduced-motion users through.
      if (REDUCED || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) {
        setMenu(false);
        return;
      }
      const dot = link.querySelector<HTMLElement>(".menu-dot");
      if (!dot) return;
      e.preventDefault();
      const r = dot.getBoundingClientRect();
      const scale = Math.ceil((Math.hypot(window.innerWidth, window.innerHeight) * 2) / r.width);
      dot.style.zIndex = "60";
      dot.style.transition = "transform 0.6s cubic-bezier(0.76, 0, 0.24, 1)";
      dot.style.transform = `scale(${scale})`;
      window.setTimeout(() => window.location.assign(link.href), 600);
    });
  });
</script>
