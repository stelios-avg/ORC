---
interface Member {
  name: string;
  role: string;
  img: string;
  bio: string | readonly string[];
}

interface Props {
  team: readonly Member[];
  promiseTitle: string;
  promiseBody: string;
  promiseCta: string;
}

const { team, promiseTitle, promiseBody, promiseCta } = Astro.props;

const members = team.map((m) => ({
  name: m.name,
  role: m.role,
  img: m.img,
  bio: Array.isArray(m.bio) ? [...m.bio] : [m.bio],
}));
---

<section class="bg-white py-16 sm:py-20">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="space-y-10 sm:space-y-14">
      {members.map((m) => (
        <article class="team-card reveal overflow-hidden rounded-2xl bg-sand shadow-sm ring-1 ring-slate-100 sm:grid sm:grid-cols-[200px_1fr] lg:grid-cols-[240px_1fr]">
          <div class="aspect-[4/5] overflow-hidden sm:aspect-auto sm:min-h-full">
            <img
              src={m.img}
              alt={m.name}
              width="640"
              height="800"
              class="h-full w-full object-cover object-top"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col justify-center p-5 sm:p-8">
            <h2 class="font-display text-xl font-bold text-charcoal sm:text-2xl">{m.name}</h2>
            <p class="mt-1 font-display text-sm font-semibold text-spine">{m.role}</p>
            {m.bio.map((p) => (
              <p class="mt-3 text-[15px] leading-7 text-charcoal-muted sm:text-base">{p}</p>
            ))}
          </div>
        </article>
      ))}
    </div>

    <div class="reveal mx-auto mt-12 max-w-3xl rounded-2xl border border-spine-100 bg-spine-50 p-6 text-center sm:mt-14 sm:p-8">
      <p class="font-display text-lg font-semibold text-charcoal">{promiseTitle}</p>
      <p class="mt-2 text-charcoal-muted">{promiseBody}</p>
      <button type="button" data-book-trigger
        class="mt-5 inline-flex items-center justify-center rounded-full bg-spine px-6 py-3 font-display font-semibold text-white transition hover:bg-spine-600">
        {promiseCta}
      </button>
    </div>
  </div>
</section>

<style>
  .team-card img {
    transform: scale(1.08);
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .team-card.revealed img {
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .team-card img,
    .team-card.revealed img {
      transform: none;
      transition: none;
    }
  }
</style>
