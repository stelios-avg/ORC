---
interface Member {
  name: string;
  role: string;
  img: string;
  bio: string | readonly string[];
}

interface Props {
  team: readonly Member[];
  promiseTitle: string;
  promiseBody: string;
  promiseCta: string;
  readMore: string;
  closeLabel: string;
}

const { team, promiseTitle, promiseBody, promiseCta, readMore, closeLabel } = Astro.props;

const members = team.map((m) => ({
  name: m.name,
  role: m.role,
  img: m.img,
  bio: Array.isArray(m.bio) ? [...m.bio] : [m.bio],
}));
---

<section class="bg-white py-16 sm:py-20">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    {/* Mobile: compact tappable rows */}
    <div class="space-y-3 sm:hidden">
      {members.map((m, i) => (
        <button
          type="button"
          class="flex w-full items-center gap-3.5 rounded-2xl bg-sand p-3.5 text-left shadow-sm ring-1 ring-slate-100 transition active:bg-sand/80"
          data-team-open={String(i)}
        >
          <img src={m.img} alt="" width="128" height="128"
            class="h-16 w-16 flex-none rounded-xl object-cover" loading="lazy" />
          <div class="min-w-0 flex-1">
            <h2 class="truncate font-display text-base font-bold text-charcoal">{m.name}</h2>
            <p class="mt-0.5 truncate font-display text-sm font-semibold text-spine">{m.role}</p>
            <span class="mt-1.5 inline-flex items-center gap-1 font-display text-sm font-semibold text-spine">
              {readMore}
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 15l6-6 6 6"/></svg>
            </span>
          </div>
        </button>
      ))}
    </div>

    {/* Desktop: photo beside full bio */}
    <div class="hidden space-y-10 sm:block">
      {members.map((m) => (
        <article class="overflow-hidden rounded-2xl bg-sand shadow-sm ring-1 ring-slate-100 sm:grid sm:grid-cols-[200px_1fr] lg:grid-cols-[240px_1fr]">
          <div class="overflow-hidden">
            <img src={m.img} alt={m.name} width="640" height="800"
              class="h-full w-full object-cover" loading="lazy" />
          </div>
          <div class="flex flex-col justify-center p-8">
            <h2 class="font-display text-2xl font-bold text-charcoal">{m.name}</h2>
            <p class="mt-1 font-display text-sm font-semibold text-spine">{m.role}</p>
            {m.bio.map((p) => (
              <p class="mt-3 text-base leading-7 text-charcoal-muted">{p}</p>
            ))}
          </div>
        </article>
      ))}
    </div>

    <div class="mx-auto mt-12 max-w-3xl rounded-2xl border border-spine-100 bg-spine-50 p-6 text-center sm:mt-14 sm:p-8">
      <p class="font-display text-lg font-semibold text-charcoal">{promiseTitle}</p>
      <p class="mt-2 text-charcoal-muted">{promiseBody}</p>
      <button type="button" data-book-trigger
        class="mt-5 inline-flex items-center justify-center rounded-full bg-spine px-6 py-3 font-display font-semibold text-white transition hover:bg-spine-600">
        {promiseCta}
      </button>
    </div>
  </div>
</section>

{/* Mobile profile sheet */}
<div id="team-sheet" class="fixed inset-0 z-[120] hidden sm:hidden" aria-modal="true" role="dialog" aria-labelledby="team-sheet-name">
  <div class="absolute inset-0 bg-spine-900/55 backdrop-blur-sm" data-team-sheet-close></div>
  <div
    id="team-sheet-panel"
    class="absolute inset-x-0 bottom-0 flex max-h-[92dvh] flex-col rounded-t-3xl bg-white shadow-2xl"
  >
    <div data-team-sheet-handle class="flex flex-none items-center justify-between px-4 pb-2 pt-3">
      <span class="w-11"></span>
      <span class="h-1.5 w-12 rounded-full bg-slate-300"></span>
      <button type="button" class="flex h-11 w-11 items-center justify-center rounded-full text-charcoal-muted transition active:bg-sand" data-team-sheet-close aria-label={closeLabel}>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div id="team-sheet-scroll" class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 pb-[max(1.5rem,env(safe-area-inset-bottom))]">
      <div class="overflow-hidden rounded-2xl">
        <img id="team-sheet-img" src="" alt="" class="aspect-[4/5] max-h-[42vh] w-full object-cover" />
      </div>
      <h2 id="team-sheet-name" class="mt-5 font-display text-2xl font-bold text-charcoal"></h2>
      <p id="team-sheet-role" class="mt-1 font-display text-sm font-semibold text-spine"></p>
      <div id="team-sheet-bio" class="mt-4 space-y-3 pb-4"></div>
    </div>
  </div>
</div>

<script type="application/json" id="team-members-data" is:inline set:html={JSON.stringify(members)}></script>

<script>
  type TeamMember = { name: string; role: string; img: string; bio: string[] };

  const sheet = document.getElementById("team-sheet");
  const panel = document.getElementById("team-sheet-panel") as HTMLElement | null;
  const handle = document.querySelector("[data-team-sheet-handle]") as HTMLElement | null;
  const img = document.getElementById("team-sheet-img") as HTMLImageElement | null;
  const nameEl = document.getElementById("team-sheet-name");
  const roleEl = document.getElementById("team-sheet-role");
  const bioEl = document.getElementById("team-sheet-bio");
  const raw = document.getElementById("team-members-data")?.textContent;
  const members = (raw ? JSON.parse(raw) : []) as TeamMember[];

  if (sheet && panel && img && nameEl && roleEl && bioEl) {
    let startY = 0;
    let dragging = false;

    function fill(m: TeamMember) {
      img.src = m.img;
      img.alt = m.name;
      nameEl.textContent = m.name;
      roleEl.textContent = m.role;
      bioEl.replaceChildren(
        ...m.bio.map((p) => {
          const el = document.createElement("p");
          el.className = "text-[15px] leading-7 text-charcoal-muted";
          el.textContent = p;
          return el;
        }),
      );
    }

    function open(i: number) {
      const m = members[i];
      if (!m) return;
      fill(m);
      panel.style.transform = "";
      sheet.classList.remove("hidden");
      sheet.offsetHeight;
      sheet.classList.add("is-open");
      document.body.classList.add("no-scroll");
    }

    function close() {
      sheet.classList.remove("is-open");
      document.body.classList.remove("no-scroll");
      window.setTimeout(() => {
        if (!sheet.classList.contains("is-open")) sheet.classList.add("hidden");
        panel.style.transform = "";
      }, 320);
    }

    document.querySelectorAll<HTMLElement>("[data-team-open]").forEach((btn) => {
      btn.addEventListener("click", () => open(Number(btn.dataset.teamOpen)));
    });
    sheet.querySelectorAll("[data-team-sheet-close]").forEach((el) => {
      el.addEventListener("click", close);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && sheet.classList.contains("is-open")) close();
    });

    handle?.addEventListener("pointerdown", (e) => {
      if (!sheet.classList.contains("is-open")) return;
      dragging = true;
      startY = e.clientY;
      handle.setPointerCapture(e.pointerId);
      panel.style.transition = "none";
    });
    handle?.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const dy = Math.max(0, e.clientY - startY);
      panel.style.transform = `translateY(${dy}px)`;
    });
    const endDrag = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      panel.style.transition = "";
      const dy = Math.max(0, e.clientY - startY);
      if (dy > 90) close();
      else panel.style.transform = "";
    };
    handle?.addEventListener("pointerup", endDrag);
    handle?.addEventListener("pointercancel", endDrag);

    window.matchMedia("(min-width: 640px)").addEventListener("change", (e) => {
      if (e.matches) close();
    });
  }
</script>

<style>
  #team-sheet-panel {
    transform: translateY(110%);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #team-sheet.is-open #team-sheet-panel {
    transform: translateY(0);
  }
  #team-sheet [data-team-sheet-close].absolute {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  #team-sheet.is-open [data-team-sheet-close].absolute {
    opacity: 1;
  }
</style>
