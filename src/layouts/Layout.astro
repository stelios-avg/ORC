---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BookingModal from "../components/BookingModal.astro";
import Preloader from "../components/Preloader.astro";
import { SITE } from "../config/site";
import { useTranslations, getAlternatePath, type Lang } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  fullBleed?: boolean;
  lang?: Lang;
  /** Social share image (path under /public). Defaults to the clinic photo. */
  ogImage?: string;
}

const {
  title,
  description,
  fullBleed = false,
  lang = "el",
  ogImage = "/images/home/clinic.png",
} = Astro.props;

const t = useTranslations(lang);
const pageTitle = title ? `${title} | ${SITE.shortName}` : t.seo.homeTitle;
const pageDesc = description ?? t.seo.homeDesc;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const ogImageUrl = new URL(ogImage, SITE.url).toString();

// hreflang alternates — the same page in the other language + x-default (Greek)
const altPath = getAlternatePath(Astro.url.pathname, lang);
const elUrl = lang === "el" ? canonical : new URL(altPath, SITE.url).toString();
const enUrl = lang === "en" ? canonical : new URL(altPath, SITE.url).toString();

// Local-business structured data for Google (clinic profile, hours, socials)
const structuredData = {
  "@context": "https://schema.org",
  "@type": ["MedicalClinic", "Physiotherapy"],
  "@id": `${SITE.url}/#clinic`,
  name: SITE.name,
  url: SITE.url,
  logo: new URL(SITE.logo, SITE.url).toString(),
  image: ogImageUrl,
  description: t.seo.homeDesc,
  telephone: SITE.phone,
  email: SITE.email,
  priceRange: "€€",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Perikleous 63, 2nd floor 201",
    addressLocality: "Strovolos",
    addressRegion: "Nicosia",
    postalCode: "2021",
    addressCountry: "CY",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "08:00",
      closes: "19:00",
    },
  ],
  medicalSpecialty: ["Physiotherapy", "Osteopathy"],
  sameAs: [SITE.social.instagram, SITE.social.facebook],
};
---

<!doctype html>
<html lang={t.htmlLang} dir={t.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="theme-color" content="#1d3e62" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="el" href={elUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={elUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === "el" ? "el_GR" : "en_GB"} />
    <meta property="og:locale:alternate" content={lang === "el" ? "en_GB" : "el_GR"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,500..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-md focus:bg-spine focus:px-4 focus:py-2 focus:text-white"
    >
      {lang === "el" ? "Μετάβαση στο περιεχόμενο" : "Skip to content"}
    </a>

    <Preloader lang={lang} />
    <Navbar lang={lang} />

    <main id="main" class:list={[fullBleed ? "" : "min-h-[60vh]"]}>
      <slot />
    </main>

    <Footer lang={lang} />
    <BookingModal lang={lang} />

    <script>
      // Scroll-reveal: animate .reveal elements as they enter the viewport.
      const els = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("revealed");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("revealed"));
      }

      // Dot-expand navigation (medwest): clicking a dot-link grows its dot to
      // cover the screen, then navigates. Opt in with data-dot-nav on the <a>
      // and data-dot on the circle span.
      const DOT_REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll<HTMLAnchorElement>("a[data-dot-nav]").forEach((link) => {
        link.addEventListener("click", (e) => {
          if (DOT_REDUCED || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
          const dot = link.querySelector<HTMLElement>("[data-dot]");
          if (!dot) return;
          e.preventDefault();
          const r = dot.getBoundingClientRect();
          const scale = Math.ceil((Math.hypot(window.innerWidth, window.innerHeight) * 2) / r.width);
          dot.style.zIndex = "200";
          dot.style.transition = "transform 0.6s cubic-bezier(0.76, 0, 0.24, 1)";
          dot.style.transform = `scale(${scale})`;
          window.setTimeout(() => window.location.assign(link.href), 600);
        });
      });
    </script>
  </body>
</html>
