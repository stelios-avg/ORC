---
import "../styles/global.css";

interface Props {
  title?: string;
  /** current nav item for highlighting */
  active?: "calendar" | "clients" | "payments";
}

const { title = "Admin", active } = Astro.props;
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/orc-logo.png" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | ORC Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Commissioner:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-sand">
    {/* Auth guard: redirects to /admin/login if there is no session */}
    <div id="admin-guard" class="fixed inset-0 z-[300] flex items-center justify-center bg-sand">
      <div class="flex flex-col items-center gap-3">
        <img src="/orc-logo.png" alt="ORC" class="h-14 w-auto" />
        <div class="h-1 w-24 overflow-hidden rounded-full bg-spine-100">
          <div class="h-full w-1/2 animate-pulse rounded-full bg-spine"></div>
        </div>
      </div>
    </div>

    {/* Top bar */}
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4">
        <a href="/admin" class="flex items-center gap-2.5">
          <img src="/orc-logo.png" alt="ORC" class="h-8 w-auto" />
          <span class="font-display text-sm font-bold text-charcoal">Admin</span>
        </a>
        <button
          id="logout-btn"
          class="rounded-full border border-slate-300 px-4 py-1.5 font-display text-xs font-semibold text-charcoal-muted transition hover:border-spine hover:text-spine"
        >
          Αποσύνδεση
        </button>
      </div>
    </header>

    {/* Page content — bottom padding clears the fixed bottom nav */}
    <main class="mx-auto max-w-5xl px-4 pb-28 pt-5">
      <slot />
    </main>

    {/* Bottom navigation (mobile-first) */}
    <nav
      class="fixed inset-x-0 bottom-0 z-40 border-t border-slate-200 bg-white/95 backdrop-blur"
      style="padding-bottom: env(safe-area-inset-bottom)"
    >
      <div class="mx-auto grid h-16 max-w-5xl grid-cols-3">
        <a
          href="/admin"
          class:list={[
            "flex flex-col items-center justify-center gap-1 font-display text-[11px] font-semibold transition",
            active === "calendar" ? "text-spine" : "text-charcoal-muted hover:text-charcoal",
          ]}
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="3" />
            <path d="M16 2v4M8 2v4M3 10h18" />
          </svg>
          Πρόγραμμα
        </a>
        <a
          href="/admin/clients"
          class:list={[
            "flex flex-col items-center justify-center gap-1 font-display text-[11px] font-semibold transition",
            active === "clients" ? "text-spine" : "text-charcoal-muted hover:text-charcoal",
          ]}
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2" />
            <circle cx="10" cy="7" r="4" />
            <path d="M21 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
          </svg>
          Πελάτες
        </a>
        <a
          href="/admin/payments"
          class:list={[
            "flex flex-col items-center justify-center gap-1 font-display text-[11px] font-semibold transition",
            active === "payments" ? "text-spine" : "text-charcoal-muted hover:text-charcoal",
          ]}
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
          </svg>
          Πληρωμές
        </a>
      </div>
    </nav>

    <script>
      import { getSupabase } from "../lib/supabase";

      const supabase = getSupabase();
      const guard = document.getElementById("admin-guard");

      // Redirect to login when there is no active session.
      supabase.auth.getSession().then(({ data: { session } }) => {
        if (!session) {
          window.location.replace("/admin/login");
        } else {
          guard?.remove();
        }
      });

      document.getElementById("logout-btn")?.addEventListener("click", async () => {
        await supabase.auth.signOut();
        window.location.replace("/admin/login");
      });
    </script>
  </body>
</html>
