---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { useTranslations } from "../i18n";

const lang = "el" as const;
const t = useTranslations(lang);
const g = t.galleryPage;
---

<Layout lang={lang} title={t.seo.galleryTitle} description={t.seo.galleryDesc}>
  <PageHeader eyebrow={g.eyebrow} title={g.title} subtitle={g.subtitle} />

  {/* ── Album covers ── */}
  <section id="albums-view" class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {g.albums.map((album, i) => (
          <button
            class="album-cover group relative overflow-hidden rounded-2xl bg-sand text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-spine"
            data-album={album.id}
            style={`--ai:${i}`}
            aria-label={`Άνοιγμα album: ${album.label}`}
          >
            {/* Cover image */}
            <div class="aspect-[4/3] w-full overflow-hidden">
              <img
                src={album.cover}
                alt={album.label}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                onerror="this.closest('.album-cover').classList.add('no-cover');"
              />
            </div>
            {/* Gradient + label */}
            <div class="absolute inset-0 bg-gradient-to-t from-spine-900/80 via-spine-900/20 to-transparent transition-opacity duration-300 group-hover:opacity-90"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-7">
              <p class="font-display text-xl font-bold text-white sm:text-2xl">{album.label}</p>
              <p class="mt-1 text-sm font-medium text-white/60">{album.images.length} φωτογραφίες</p>
              {/* Arrow indicator */}
              <span class="mt-4 flex h-9 w-9 items-center justify-center rounded-full border border-white/40 text-white transition-all duration-300 group-hover:border-white group-hover:bg-white/10">
                <svg class="h-4 w-4 translate-x-0 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M3 8h10M9 4l4 4-4 4"/>
                </svg>
              </span>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  {/* ── Album detail view (hidden by default) ── */}
  <section id="album-view" class="hidden bg-white pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {/* Back button + title */}
      <div class="flex items-center gap-4 py-10 sm:py-12">
        <button id="back-btn" class="flex h-10 w-10 flex-none items-center justify-center rounded-full border border-slate-300 text-charcoal transition hover:border-spine hover:text-spine" aria-label="Πίσω στα albums">
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M13 8H3M7 4L3 8l4 4"/>
          </svg>
        </button>
        <h2 id="album-title" class="font-display text-2xl font-bold text-charcoal sm:text-3xl"></h2>
      </div>
      {/* Photo grid */}
      <div id="photo-grid" class="columns-1 gap-4 sm:columns-2 lg:columns-3 [&>*]:mb-4"></div>
    </div>
  </section>

  {/* ── Lightbox ── */}
  <div id="lightbox" class="fixed inset-0 z-[150] hidden items-center justify-center bg-spine-900/92 backdrop-blur-sm" aria-modal="true" role="dialog">
    <button id="lb-close" class="absolute right-5 top-5 flex h-11 w-11 items-center justify-center rounded-full border border-white/30 text-white transition hover:bg-white/10" aria-label="Κλείσιμο">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <button id="lb-prev" class="absolute left-4 top-1/2 -translate-y-1/2 flex h-11 w-11 items-center justify-center rounded-full border border-white/30 text-white transition hover:bg-white/10">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <img id="lb-img" src="" alt="" class="max-h-[85vh] max-w-[90vw] rounded-xl object-contain shadow-2xl" style="transition: opacity 0.25s ease" />
    <button id="lb-next" class="absolute right-4 top-1/2 -translate-y-1/2 flex h-11 w-11 items-center justify-center rounded-full border border-white/30 text-white transition hover:bg-white/10">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    </button>
    <p id="lb-counter" class="absolute bottom-5 left-1/2 -translate-x-1/2 text-sm text-white/50"></p>
  </div>

  <section class="bg-sand py-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h2 class="font-display text-2xl font-bold text-charcoal sm:text-3xl">{g.ctaTitle}</h2>
      <p class="mt-3 text-charcoal-muted">{g.ctaSubtitle}</p>
      <button type="button" data-book-trigger
        class="mt-7 inline-flex items-center justify-center rounded-full bg-spine px-7 py-3.5 font-display font-semibold text-white transition hover:bg-spine-600">
        {g.cta}
      </button>
    </div>
  </section>
</Layout>

<style>
  /* Album cover entrance animation */
  .album-cover {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--ai) * 120ms);
  }
  .album-cover.visible { opacity: 1; transform: none; }
  .album-cover.no-cover .aspect-\[4\/3\] {
    background: linear-gradient(135deg, var(--color-spine-100), var(--color-sand));
  }

  /* Photo grid item entrance */
  .photo-item {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--pi) * 60ms);
  }
  .photo-item.visible { opacity: 1; transform: none; }

  /* Album view slide-in */
  #album-view.entering {
    animation: slideIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes slideIn {
    from { opacity: 0; transform: translateX(16px); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .album-cover, .photo-item { opacity: 1; transform: none; transition: none; }
    #album-view.entering { animation: none; }
  }
</style>

<script define:vars={{ albums: g.albums, imgAlt: g.imgAlt }}>
  const albumsView = document.getElementById("albums-view");
  const albumView  = document.getElementById("album-view");
  const albumTitle = document.getElementById("album-title");
  const photoGrid  = document.getElementById("photo-grid");
  const backBtn    = document.getElementById("back-btn");
  const lightbox   = document.getElementById("lightbox");
  const lbImg      = document.getElementById("lb-img");
  const lbClose    = document.getElementById("lb-close");
  const lbPrev     = document.getElementById("lb-prev");
  const lbNext     = document.getElementById("lb-next");
  const lbCounter  = document.getElementById("lb-counter");

  let lbImages = [];
  let lbCurrent = 0;

  // ── Reveal album covers on scroll ──
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("visible"); io.unobserve(e.target); } });
  }, { threshold: 0.08 });
  document.querySelectorAll(".album-cover").forEach((c) => io.observe(c));

  // ── Open album ──
  document.querySelectorAll(".album-cover").forEach((btn) => {
    btn.addEventListener("click", () => {
      const albumId = btn.dataset.album;
      const album = albums.find((a) => a.id === albumId);
      if (!album) return;

      albumTitle.textContent = album.label;
      photoGrid.innerHTML = "";

      album.images.forEach((img, j) => {
        const src = `/images/gallery/${albumId}/${img}`;
        const figure = document.createElement("figure");
        figure.className = "photo-item group relative cursor-pointer overflow-hidden rounded-xl bg-sand";
        figure.style = `--pi:${j}`;
        figure.innerHTML = `
          <img src="${src}" alt="${imgAlt} ${j + 1}" loading="lazy"
            class="w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            onerror="this.closest('figure').classList.add('aspect-[4/3]','min-h-[180px]'); this.style.display='none';" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-spine-900/40 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
        `;
        figure.addEventListener("click", () => {
          const srcs = Array.from(photoGrid.querySelectorAll("img")).map((i) => i.src);
          openLb(src, srcs);
        });
        photoGrid.appendChild(figure);
      });

      // Show album view
      albumsView.classList.add("hidden");
      albumView.classList.remove("hidden");
      albumView.classList.add("entering");
      albumView.addEventListener("animationend", () => albumView.classList.remove("entering"), { once: true });
      window.scrollTo({ top: albumView.offsetTop - 80, behavior: "smooth" });

      // Staggered reveal
      requestAnimationFrame(() => {
        const items = photoGrid.querySelectorAll(".photo-item");
        const pio = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("visible"); pio.unobserve(e.target); } });
        }, { threshold: 0.05 });
        items.forEach((item) => pio.observe(item));
      });
    });
  });

  // ── Back ──
  backBtn.addEventListener("click", () => {
    albumView.classList.add("hidden");
    albumsView.classList.remove("hidden");
    window.scrollTo({ top: albumsView.offsetTop - 80, behavior: "smooth" });
  });

  // ── Lightbox ──
  const openLb = (src, imgs) => {
    lbImages = imgs;
    lbCurrent = imgs.indexOf(src);
    lbImg.src = src;
    updateCounter();
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.classList.add("no-scroll");
  };
  const closeLb = () => {
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.classList.remove("no-scroll");
  };
  const navLb = (dir) => {
    lbCurrent = (lbCurrent + dir + lbImages.length) % lbImages.length;
    lbImg.style.opacity = "0";
    setTimeout(() => { lbImg.src = lbImages[lbCurrent]; lbImg.style.opacity = "1"; updateCounter(); }, 220);
  };
  const updateCounter = () => { lbCounter.textContent = `${lbCurrent + 1} / ${lbImages.length}`; };

  lbClose.addEventListener("click", closeLb);
  lbPrev.addEventListener("click", () => navLb(-1));
  lbNext.addEventListener("click", () => navLb(1));
  lightbox.addEventListener("click", (e) => { if (e.target === lightbox) closeLb(); });
  document.addEventListener("keydown", (e) => {
    if (!lightbox.classList.contains("flex")) return;
    if (e.key === "Escape") closeLb();
    if (e.key === "ArrowLeft") navLb(-1);
    if (e.key === "ArrowRight") navLb(1);
  });
</script>
