---
import Layout from "../../layouts/Layout.astro";
import HeroInfoDot from "../../components/HeroInfoDot.astro";
import HeroTitle from "../../components/HeroTitle.astro";
import { SITE } from "../../config/site";
import { useTranslations } from "../../i18n";

const lang = "en" as const;
const t = useTranslations(lang);
const base = "/en";
---

<Layout lang={lang} fullBleed description={t.seo.homeDesc}>
  {/* ── HERO — centered, dot-link CTAs ──────────────────────────────── */}
  <section class="relative flex min-h-[100svh] items-center justify-center overflow-hidden">
    {/* Mobile/tablet: vertical clip */}
    <video
      class="absolute inset-0 h-full w-full object-cover lg:hidden"
      data-hero-mobile
      autoplay muted loop playsinline preload="auto"
      poster="/images/hero-poster-mobile.jpg"
      aria-hidden="true"
    >
      <source src="/videos/hero-mobile.mp4" type="video/mp4" />
    </video>
    {/* Desktop */}
    <video
      class="absolute inset-0 hidden h-full w-full object-cover lg:block"
      data-hero-desktop
      autoplay muted loop playsinline preload="auto"
      poster="/images/hero-poster.jpg"
      aria-hidden="true"
    >
      <source src="/videos/hero.webm" type="video/webm" />
      <source src="/videos/hero.mp4" type="video/mp4" />
    </video>
    {/* Drop the off-breakpoint video before it starts downloading. */}
    <script is:inline>
      (() => {
        var desktop = window.matchMedia("(min-width: 1024px)").matches;
        var v = document.querySelector(desktop ? "[data-hero-mobile]" : "[data-hero-desktop]");
        if (v) v.remove();
      })();
    </script>
    <div class="hero-overlay absolute inset-0"></div>

    <div class="relative z-10 mx-auto w-full max-w-5xl px-5 pt-20 text-center sm:px-6">
      <p class="reveal revealed text-xs font-medium uppercase tracking-[0.24em] text-white/80 sm:text-sm">
        {t.hero.eyebrow}
      </p>
      <HeroTitle lang={lang} />

      {/* CTAs as centered dot-links */}
      <div class="reveal revealed mt-12 flex flex-col items-center justify-center gap-6 sm:flex-row sm:gap-14" style="--reveal-delay: 240ms">
        <button type="button" data-book-trigger class="group flex min-h-12 items-center gap-4 sm:gap-5">
          <span class="h-9 w-9 flex-none rounded-full bg-spine-200 transition-transform duration-500 ease-out group-hover:scale-[1.7] sm:h-11 sm:w-11 sm:group-hover:scale-[1.9]"></span>
          <span class="font-display text-base font-semibold text-white transition-colors duration-300 group-hover:text-spine-200 sm:text-lg">
            {t.hero.ctaPrimary}
          </span>
        </button>
        <a href={`${base}/services/`} class="group flex min-h-12 items-center gap-4 sm:gap-5">
          <span class="h-9 w-9 flex-none rounded-full bg-white/80 transition-transform duration-500 ease-out group-hover:scale-[1.7] sm:h-11 sm:w-11 sm:group-hover:scale-[1.9]"></span>
          <span class="font-display text-base font-semibold text-white/85 transition-colors duration-300 group-hover:text-white sm:text-lg">
            {t.hero.ctaSecondary}
          </span>
        </a>
      </div>
    </div>

    {/* Info dot — bottom-left corner, opens the slide-in panel */}
    <div class="absolute bottom-8 left-5 z-10 sm:left-10">
      <HeroInfoDot lang={lang} />
    </div>

    <div class="absolute bottom-8 right-6 z-10 hidden animate-bounce text-white/70 sm:block">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
    </div>
  </section>

  {/* ── INTRO — centered statement ──────────────────────────────────── */}
  <section id="intro" class="bg-white py-20 text-center sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <p class="reveal text-xs font-semibold uppercase tracking-[0.22em] text-spine sm:text-sm">
        {t.intro.eyebrow}
      </p>
      <h2 class="reveal mx-auto mt-4 max-w-4xl font-display font-bold text-charcoal headline-statement" style="--reveal-delay: 100ms">
        {t.intro.title}
      </h2>
      <p class="reveal mx-auto mt-7 max-w-2xl text-base leading-relaxed text-charcoal-muted sm:text-lg" style="--reveal-delay: 180ms">
        {t.intro.body}
      </p>
      <div class="reveal mx-auto mt-10 grid max-w-2xl grid-cols-3 gap-4 rounded-2xl bg-sand p-6 sm:p-8" style="--reveal-delay: 260ms">
        {t.stats.map((s) => (
          <div class="text-center">
            <div class="font-display text-2xl font-bold text-spine sm:text-4xl">{s.value}</div>
            <div class="mt-2 text-[11px] text-charcoal-muted sm:text-sm">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── STATEMENT SECTIONS — photo + centered text, alternating sides ── */}
  {t.statements.map((s, i) => (
    <section class="bg-white py-14 sm:py-24">
      <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8">
        <div
          class:list={[
            "relative w-[92%] lg:w-auto",
            i % 2 === 1 ? "-mr-5 ml-auto sm:-mr-6 lg:mr-0" : "-ml-5 sm:-ml-6 lg:ml-0",
            i % 2 === 1 ? "lg:order-2" : "",
          ]}
        >
          {/* Mobile: photo flush to the screen edge, plain circle overlapping the outer corner (medwest) */}
          <a
            href={`${base}${s.href}`}
            aria-label={s.link}
            class:list={[
              "group absolute -top-8 z-10 block lg:hidden",
              i % 2 === 1 ? "-left-7" : "-right-7",
            ]}
          >
            <span class="block h-28 w-28 rounded-full bg-spine shadow-lg shadow-spine/25 transition-transform duration-500 ease-out group-hover:scale-110 group-active:scale-110"></span>
          </a>

          <figure
            class:list={[
              "reveal img-reveal relative aspect-[4/3] w-full bg-sand",
              i % 2 === 1 ? "max-lg:rounded-r-none!" : "max-lg:rounded-l-none!",
            ]}
          >
            <img
              src={SITE.logo}
              alt=""
              aria-hidden="true"
              class="pointer-events-none absolute left-1/2 top-1/2 w-1/2 -translate-x-1/2 -translate-y-1/2 select-none opacity-[0.06]"
            />
            <img
              src={s.img}
              alt={s.eyebrow}
              class="relative h-full w-full object-cover"
              loading="lazy"
              onerror="this.remove();"
            />
          </figure>
        </div>

        <div class:list={[i % 2 === 1 ? "text-right" : "text-left", "lg:text-center"]}>
          <p class="reveal text-xs font-semibold uppercase tracking-[0.22em] text-spine sm:text-sm">
            {s.eyebrow}
          </p>
          <h2 class="reveal mx-auto mt-4 max-w-xl font-display font-bold text-charcoal headline-statement" style="--reveal-delay: 100ms">
            {s.title}
          </h2>
          {/* Desktop: centered dot-link under the title */}
          <a
            href={`${base}${s.href}`}
            class="reveal group mt-9 hidden min-h-12 items-center gap-4 sm:gap-5 lg:inline-flex"
            style="--reveal-delay: 200ms"
          >
            <span class="h-9 w-9 flex-none rounded-full bg-spine transition-transform duration-500 ease-out group-hover:scale-[1.7] sm:h-11 sm:w-11 sm:group-hover:scale-[1.9]"></span>
            <span class="font-display text-base font-semibold text-charcoal transition-colors duration-300 group-hover:text-spine sm:text-lg">
              {s.link}
            </span>
          </a>
        </div>
      </div>
    </section>
  ))}

  {/* ── CTA BAND — centered, dot-link ───────────────────────────────── */}
  <section class="bg-sand py-20 text-center sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
      <h2 class="reveal mx-auto max-w-3xl font-display font-bold text-charcoal headline-statement">
        {t.ctaBand.title}
      </h2>
      <p class="reveal mx-auto mt-5 max-w-xl text-base text-charcoal-muted sm:text-lg" style="--reveal-delay: 100ms">
        {t.ctaBand.subtitle}
      </p>
      <button
        type="button"
        data-book-trigger
        class="reveal group mt-10 inline-flex min-h-12 items-center gap-4 sm:gap-5"
        style="--reveal-delay: 200ms"
      >
        <span class="h-10 w-10 flex-none rounded-full bg-spine transition-transform duration-500 ease-out group-hover:scale-[1.7] sm:h-12 sm:w-12 sm:group-hover:scale-[1.9]"></span>
        <span class="font-display text-lg font-semibold text-charcoal transition-colors duration-300 group-hover:text-spine sm:text-xl">
          {t.ctaBand.cta}
        </span>
      </button>
    </div>
  </section>
</Layout>

<script>
  const v = document.querySelector<HTMLVideoElement>("section video");
  if (v) {
    const tryPlay = () => v.play().catch(() => {});
    if (v.readyState >= 2) tryPlay();
    v.addEventListener("canplay", tryPlay, { once: true });
  }
</script>
