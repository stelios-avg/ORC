---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { useTranslations } from "../../i18n";

const lang = "en" as const;
const t = useTranslations(lang);
const g = t.galleryPage;

const images = Array.from({ length: 9 }, (_, i) => ({
  src: `/images/gallery/${i + 1}.jpg`,
  alt: `${g.imgAlt} ${i + 1}`,
}));
---

<Layout lang={lang} title={t.seo.galleryTitle} description={t.seo.galleryDesc}>
  <PageHeader eyebrow={g.eyebrow} title={g.title} subtitle={g.subtitle} />

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="columns-1 gap-4 sm:columns-2 lg:columns-3 [&>*]:mb-4">
        {images.map((img) => (
          <figure class="group relative overflow-hidden rounded-2xl bg-sand">
            <img src={img.src} alt={img.alt} loading="lazy"
              class="w-full object-cover transition duration-500 group-hover:scale-105"
              onerror="this.closest('figure').classList.add('aspect-[4/3]','flex','items-center','justify-center'); this.remove();" />
            <figcaption class="pointer-events-none absolute inset-0 hidden items-end bg-gradient-to-t from-spine-900/60 to-transparent p-4 text-sm font-medium text-white group-hover:flex">
              {img.alt}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-sand py-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h2 class="font-display text-2xl font-bold text-charcoal sm:text-3xl">{g.ctaTitle}</h2>
      <p class="mt-3 text-charcoal-muted">{g.ctaSubtitle}</p>
      <button type="button" data-book-trigger
        class="mt-7 inline-flex items-center justify-center rounded-full bg-spine px-7 py-3.5 font-display font-semibold text-white transition hover:bg-spine-600">
        {g.cta}
      </button>
    </div>
  </section>
</Layout>
