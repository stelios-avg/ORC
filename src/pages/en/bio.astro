---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { useTranslations } from "../../i18n";

const lang = "en" as const;
const t = useTranslations(lang);
const b = t.bioPage;
---

<Layout lang={lang} title={t.seo.bioTitle} description={t.seo.bioDesc}>
  <PageHeader eyebrow={b.eyebrow} title={b.title} subtitle={b.subtitle} image="/images/page-hero.png" />

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 no-scrollbar sm:mx-0 sm:grid sm:snap-none sm:grid-cols-2 sm:gap-10 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-4">
        {b.team.map((m) => (
          <article class="flex w-[80%] max-w-xs flex-none snap-center flex-col overflow-hidden rounded-2xl bg-sand shadow-sm ring-1 ring-slate-100 sm:w-auto sm:max-w-none">
            <div class="aspect-[3/4] overflow-hidden">
              <img src={m.img} alt={m.name} width="640" height="854"
                class="h-full w-full object-cover transition duration-500 hover:scale-[1.03]" loading="lazy" />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h2 class="font-display text-xl font-bold text-charcoal">{m.name}</h2>
              <p class="mt-1 font-display text-sm font-semibold text-spine">{m.role}</p>
              <p class="mt-3 text-sm leading-relaxed text-charcoal-muted">{m.bio}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="mx-auto mt-14 max-w-3xl rounded-2xl border border-spine-100 bg-spine-50 p-6 text-center sm:p-8">
        <p class="font-display text-lg font-semibold text-charcoal">{b.promiseTitle}</p>
        <p class="mt-2 text-charcoal-muted">{b.promiseBody}</p>
        <button type="button" data-book-trigger
          class="mt-5 inline-flex items-center justify-center rounded-full bg-spine px-6 py-3 font-display font-semibold text-white transition hover:bg-spine-600">
          {b.promiseCta}
        </button>
      </div>
    </div>
  </section>
</Layout>
