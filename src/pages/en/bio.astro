---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import TeamList from "../../components/TeamList.astro";
import { useTranslations } from "../../i18n";

const lang = "en" as const;
const t = useTranslations(lang);
const b = t.bioPage;
---

<Layout lang={lang} title={t.seo.bioTitle} description={t.seo.bioDesc}>
  <PageHeader eyebrow={b.eyebrow} title={b.title} subtitle={b.subtitle} image="/images/page-hero.png" />
  <TeamList
    team={b.team}
    promiseTitle={b.promiseTitle}
    promiseBody={b.promiseBody}
    promiseCta={b.promiseCta}
    readMore={b.readMore}
    closeLabel={b.close}
  />
</Layout>
