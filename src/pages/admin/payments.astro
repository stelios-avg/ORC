---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Πληρωμές" active="payments">
  <div class="mb-4 flex items-center justify-between gap-2">
    <button id="pay-prev" type="button"
      class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-300 bg-white text-charcoal transition active:bg-sand hover:border-spine hover:text-spine"
      aria-label="Προηγούμενος μήνας">
      <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 3L5 8l5 5"/></svg>
    </button>
    <div class="flex min-h-11 flex-1 items-center justify-center rounded-full bg-white px-4 py-2 text-center ring-1 ring-slate-200">
      <span id="pay-month-label" class="font-display text-sm font-bold text-charcoal"></span>
    </div>
    <button id="pay-next" type="button"
      class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-300 bg-white text-charcoal transition active:bg-sand hover:border-spine hover:text-spine"
      aria-label="Επόμενος μήνας">
      <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3l5 5-5 5"/></svg>
    </button>
  </div>

  <div id="pay-period" class="mb-3 hidden rounded-full bg-white p-1 ring-1 ring-slate-200">
    <button type="button" data-pay-period="day"
      class="flex min-h-11 flex-1 items-center justify-center rounded-full px-3 py-2 font-display text-xs font-semibold transition data-[active=true]:bg-charcoal data-[active=true]:text-white data-[active=false]:text-charcoal-muted"
      data-active="false" aria-pressed="false">
      Ημέρα
    </button>
    <button type="button" data-pay-period="month"
      class="flex min-h-11 flex-1 items-center justify-center rounded-full px-3 py-2 font-display text-xs font-semibold transition data-[active=true]:bg-charcoal data-[active=true]:text-white data-[active=false]:text-charcoal-muted"
      data-active="true" aria-pressed="true">
      Μήνας
    </button>
    <button type="button" data-pay-period="year"
      class="flex min-h-11 flex-1 items-center justify-center rounded-full px-3 py-2 font-display text-xs font-semibold transition data-[active=true]:bg-charcoal data-[active=true]:text-white data-[active=false]:text-charcoal-muted"
      data-active="false" aria-pressed="false">
      Έτος
    </button>
  </div>

  <p id="pay-scope" class="mb-4 text-sm text-charcoal-muted"></p>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
    <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-100">
      <p class="text-xs font-semibold uppercase tracking-wide text-charcoal-muted">Σύνολο πληρωτέου</p>
      <p id="sum-payable" class="mt-1 font-display text-2xl font-bold text-charcoal">—</p>
    </div>
    <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-100">
      <p class="text-xs font-semibold uppercase tracking-wide text-charcoal-muted">Εισπραγμένα</p>
      <p id="sum-paid" class="mt-1 font-display text-2xl font-bold text-emerald-600">—</p>
    </div>
    <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-100">
      <p class="text-xs font-semibold uppercase tracking-wide text-charcoal-muted">Υπόλοιπο απλήρωτο</p>
      <p id="sum-unpaid" class="mt-1 font-display text-2xl font-bold text-amber-600">—</p>
    </div>
  </div>

  <p id="pay-count" class="mt-3 text-xs text-charcoal-muted"></p>

  <div id="period-breakdown" class="mt-6 hidden">
    <h2 id="period-breakdown-title" class="mb-3 font-display text-sm font-bold uppercase tracking-wide text-charcoal"></h2>
    <ul id="period-breakdown-list" class="space-y-2"></ul>
  </div>

  {/* Owner (Charalambos): per-admin payments + unpaid remainder per appointment */}
  <div id="owner-wrap" class="mt-6 hidden space-y-4"></div>

  {/* Other masters: compact per-therapist totals only */}
  <div id="by-therapist-wrap" class="mt-6 hidden">
    <h2 class="mb-3 font-display text-sm font-bold uppercase tracking-wide text-charcoal">Ανά θεραπευτή</h2>
    <ul id="by-therapist" class="space-y-2"></ul>
  </div>

  <p id="pay-error" class="mt-8 hidden text-center text-sm text-red-600"></p>
  <p id="pay-empty" class="mt-8 hidden text-center text-sm text-charcoal-muted">Καμία καταχώρηση με τιμή αυτόν τον μήνα.</p>
</AdminLayout>

<script>
  import { getSupabase, type Appointment } from "../../lib/supabase";
  import { THERAPISTS, getTherapist } from "../../lib/therapists";
  import {
    isMasterAccount,
    isOwnerAccount,
    paymentTherapistFilter,
    therapistSlugForEmail,
  } from "../../lib/admin-access";

  const supabase = getSupabase();
  const monthLabel = document.getElementById("pay-month-label")!;
  const periodWrap = document.getElementById("pay-period")!;
  const scopeEl = document.getElementById("pay-scope")!;
  const errorEl = document.getElementById("pay-error")!;
  const emptyEl = document.getElementById("pay-empty")!;
  const ownerWrap = document.getElementById("owner-wrap")!;
  const byWrap = document.getElementById("by-therapist-wrap")!;
  const byList = document.getElementById("by-therapist")!;
  const breakdownWrap = document.getElementById("period-breakdown")!;
  const breakdownTitle = document.getElementById("period-breakdown-title")!;
  const breakdownList = document.getElementById("period-breakdown-list")!;

  type Period = "day" | "month" | "year";
  let adminEmail = "";
  let period: Period = "month";
  let cursor = new Date();
  cursor.setHours(0, 0, 0, 0);

  const METHOD_LABELS: Record<string, string> = {
    cash: "Μετρητά",
    card: "Κάρτα",
    other: "Άλλο",
  };

  const fmtEuro = (n: number) =>
    new Intl.NumberFormat("el-GR", { style: "currency", currency: "EUR" }).format(n);

  const fmtDate = (iso: string) =>
    new Date(iso).toLocaleDateString("el-GR", {
      weekday: "short",
      day: "numeric",
      month: "short",
    });

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!,
    );

  function payableAmount(a: Pick<Appointment, "price" | "discount">): number | null {
    if (a.price == null || Number.isNaN(Number(a.price))) return null;
    return Math.max(0, Number(a.price) - Number(a.discount ?? 0));
  }

  function periodBounds(p: Period, d: Date) {
    if (p === "day") {
      const start = new Date(d.getFullYear(), d.getMonth(), d.getDate());
      const end = new Date(d.getFullYear(), d.getMonth(), d.getDate() + 1);
      return { start, end };
    }
    if (p === "year") {
      const start = new Date(d.getFullYear(), 0, 1);
      const end = new Date(d.getFullYear() + 1, 0, 1);
      return { start, end };
    }
    const start = new Date(d.getFullYear(), d.getMonth(), 1);
    const end = new Date(d.getFullYear(), d.getMonth() + 1, 1);
    return { start, end };
  }

  function periodLabel(p: Period, d: Date) {
    if (p === "day") {
      return d.toLocaleDateString("el-GR", {
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
      });
    }
    if (p === "year") return String(d.getFullYear());
    return d.toLocaleDateString("el-GR", { month: "long", year: "numeric" });
  }

  function shiftCursor(dir: number) {
    if (period === "day") {
      cursor = new Date(cursor.getFullYear(), cursor.getMonth(), cursor.getDate() + dir);
    } else if (period === "year") {
      cursor = new Date(cursor.getFullYear() + dir, cursor.getMonth(), cursor.getDate());
    } else {
      const day = cursor.getDate();
      const next = new Date(cursor.getFullYear(), cursor.getMonth() + dir, 1);
      const last = new Date(next.getFullYear(), next.getMonth() + 1, 0).getDate();
      next.setDate(Math.min(day, last));
      cursor = next;
    }
  }

  function syncPeriodUi() {
    document.querySelectorAll<HTMLButtonElement>("[data-pay-period]").forEach((b) => {
      const on = b.dataset.payPeriod === period;
      b.setAttribute("data-active", on ? "true" : "false");
      b.setAttribute("aria-pressed", on ? "true" : "false");
    });
    const prev = document.getElementById("pay-prev")!;
    const next = document.getElementById("pay-next")!;
    if (period === "day") {
      prev.setAttribute("aria-label", "Προηγούμενη ημέρα");
      next.setAttribute("aria-label", "Επόμενη ημέρα");
    } else if (period === "year") {
      prev.setAttribute("aria-label", "Προηγούμενο έτος");
      next.setAttribute("aria-label", "Επόμενο έτος");
    } else {
      prev.setAttribute("aria-label", "Προηγούμενος μήνας");
      next.setAttribute("aria-label", "Επόμενος μήνας");
    }
  }

  type Totals = { payable: number; paid: number; unpaid: number; count: number };

  function emptyTotals(): Totals {
    return { payable: 0, paid: 0, unpaid: 0, count: 0 };
  }

  function addTotals(t: Totals, amount: number, isPaid: boolean) {
    t.payable += amount;
    t.count += 1;
    if (isPaid) t.paid += amount;
    else t.unpaid += amount;
  }

  function dayKey(iso: string) {
    const d = new Date(iso);
    const m = String(d.getMonth() + 1).padStart(2, "0");
    const day = String(d.getDate()).padStart(2, "0");
    return `${d.getFullYear()}-${m}-${day}`;
  }

  function monthKey(iso: string) {
    const d = new Date(iso);
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
  }

  type Row = Appointment & { amount: number };

  type Bucket = {
    name: string;
    payable: number;
    paid: number;
    unpaid: number;
    count: number;
    unpaidRows: Row[];
    paidRows: Row[];
  };

  function renderOwnerDashboard(buckets: Map<string, Bucket>) {
    const order = THERAPISTS.map((t) => t.id);
    const sorted = [...buckets.entries()].sort((a, b) => {
      const ia = order.indexOf(a[0]);
      const ib = order.indexOf(b[0]);
      return (ia < 0 ? 999 : ia) - (ib < 0 ? 999 : ib);
    });

    ownerWrap.innerHTML = `
      <h2 class="font-display text-sm font-bold uppercase tracking-wide text-charcoal">Ανά θεραπευτή</h2>
      ${sorted.map(([, b]) => {
        const unpaidList = b.unpaidRows.length
          ? b.unpaidRows
              .sort((x, y) => x.start_time.localeCompare(y.start_time))
              .map((a) => `
                <li class="flex items-start justify-between gap-3 border-t border-amber-100/80 py-2.5 first:border-t-0">
                  <div class="min-w-0">
                    <p class="truncate font-display text-sm font-semibold text-charcoal">${esc(a.patients?.name ?? (a.patient_id ? "—" : "Walk-in"))}</p>
                    <p class="text-xs text-charcoal-muted">${fmtDate(a.start_time)}${a.service ? ` · ${esc(a.service)}` : ""}</p>
                  </div>
                  <p class="flex-none font-display text-sm font-bold text-amber-700">${fmtEuro(a.amount)}</p>
                </li>`)
              .join("")
          : `<li class="py-1 text-sm text-charcoal-muted">Κανένα απλήρωτο ραντεβού</li>`;

        const paidList = b.paidRows.length
          ? b.paidRows
              .sort((x, y) => y.start_time.localeCompare(x.start_time))
              .map((a) => {
                const method = a.payment_method ? METHOD_LABELS[a.payment_method] ?? "" : "";
                return `
                <li class="flex items-start justify-between gap-3 border-t border-slate-100 py-2 first:border-t-0">
                  <div class="min-w-0">
                    <p class="truncate text-sm text-charcoal">${esc(a.patients?.name ?? (a.patient_id ? "—" : "Walk-in"))}</p>
                    <p class="text-xs text-charcoal-muted">${fmtDate(a.start_time)}${method ? ` · ${method}` : ""}</p>
                  </div>
                  <p class="flex-none text-sm font-semibold text-emerald-600">${fmtEuro(a.amount)}</p>
                </li>`;
              })
              .join("")
          : `<li class="py-1 text-sm text-charcoal-muted">Καμία είσπραξη αυτόν τον μήνα</li>`;

        return `
          <section class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-100">
            <header class="border-b border-slate-100 px-4 py-3">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-display text-base font-bold text-charcoal">${esc(b.name)}</h3>
                <p class="font-display text-sm font-semibold text-charcoal">${fmtEuro(b.payable)}</p>
              </div>
              <div class="mt-2 grid grid-cols-2 gap-2 text-xs">
                <p class="rounded-lg bg-emerald-50 px-2.5 py-1.5 font-medium text-emerald-700">
                  Εισπραγμένα <span class="font-bold">${fmtEuro(b.paid)}</span>
                </p>
                <p class="rounded-lg bg-amber-50 px-2.5 py-1.5 font-medium text-amber-800">
                  Υπόλοιπο <span class="font-bold">${fmtEuro(b.unpaid)}</span>
                </p>
              </div>
            </header>
            <div class="px-4 py-3">
              <p class="mb-1 font-display text-[11px] font-bold uppercase tracking-wide text-amber-700">
                Απλήρωτα ραντεβού · ${b.unpaidRows.length}
              </p>
              <ul>${unpaidList}</ul>
            </div>
            <details class="border-t border-slate-100 px-4 py-3">
              <summary class="cursor-pointer font-display text-[11px] font-bold uppercase tracking-wide text-charcoal-muted">
                Εισπραγμένα ραντεβού · ${b.paidRows.length}
              </summary>
              <ul class="mt-2">${paidList}</ul>
            </details>
          </section>`;
      }).join("")}`;
  }

  function renderTherapistTotals(buckets: Map<string, Bucket>) {
    const order = THERAPISTS.map((t) => t.id);
    const sorted = [...buckets.entries()].sort((a, b) => {
      const ia = order.indexOf(a[0]);
      const ib = order.indexOf(b[0]);
      return (ia < 0 ? 999 : ia) - (ib < 0 ? 999 : ib);
    });
    byList.innerHTML = sorted
      .map(
        ([, b]) => `
        <li class="rounded-xl bg-white p-4 shadow-sm ring-1 ring-slate-100">
          <div class="flex items-baseline justify-between gap-3">
            <p class="font-display text-sm font-bold text-charcoal">${esc(b.name)}</p>
            <p class="font-display text-sm font-semibold text-charcoal">${fmtEuro(b.payable)}</p>
          </div>
          <p class="mt-1 text-xs text-charcoal-muted">
            Εισπραγμένα ${fmtEuro(b.paid)} · Απλήρωτα ${fmtEuro(b.unpaid)} · ${b.count} ραντεβού
          </p>
        </li>`,
      )
      .join("");
  }

  function totalsRow(label: string, t: Totals, jump: string) {
    return `
      <li>
        <button type="button" data-jump="${jump}"
          class="flex w-full items-center justify-between gap-3 rounded-xl bg-white p-4 text-left shadow-sm ring-1 ring-slate-100 transition active:bg-sand">
          <div class="min-w-0">
            <p class="font-display text-sm font-bold text-charcoal">${esc(label)}</p>
            <p class="mt-1 text-xs text-charcoal-muted">
              Εισπραγμένα ${fmtEuro(t.paid)} · Υπόλοιπο ${fmtEuro(t.unpaid)} · ${t.count} ραντεβού
            </p>
          </div>
          <p class="flex-none font-display text-sm font-semibold text-charcoal">${fmtEuro(t.payable)}</p>
        </button>
      </li>`;
  }

  function renderBreakdown(
    owner: boolean,
    byDay: Map<string, Totals>,
    byMonth: Map<string, Totals>,
  ) {
    breakdownWrap.classList.add("hidden");
    breakdownList.innerHTML = "";
    if (!owner || period === "day") return;

    if (period === "month") {
      const days = [...byDay.entries()].sort((a, b) => a[0].localeCompare(b[0]));
      if (!days.length) return;
      breakdownTitle.textContent = "Σύνολο ανά ημέρα · όλοι οι θεραπευτές";
      breakdownList.innerHTML = days
        .map(([key, t]) => {
          const [y, m, d] = key.split("-").map(Number);
          const label = new Date(y!, m! - 1, d).toLocaleDateString("el-GR", {
            weekday: "short",
            day: "numeric",
            month: "short",
          });
          return totalsRow(label, t, key);
        })
        .join("");
    } else {
      breakdownTitle.textContent = "Σύνολο ανά μήνα · όλοι οι θεραπευτές";
      const year = cursor.getFullYear();
      const rows: string[] = [];
      for (let m = 1; m <= 12; m++) {
        const key = `${year}-${String(m).padStart(2, "0")}`;
        const t = byMonth.get(key) ?? emptyTotals();
        const label = ["Ιανουάριος", "Φεβρουάριος", "Μάρτιος", "Απρίλιος", "Μάιος", "Ιούνιος", "Ιούλιος", "Αύγουστος", "Σεπτέμβριος", "Οκτώβριος", "Νοέμβριος", "Δεκέμβριος"][m - 1]!;
        rows.push(totalsRow(label, t, key));
      }
      breakdownList.innerHTML = rows.join("");
    }
    breakdownWrap.classList.remove("hidden");
  }

  async function fetchRows(start: Date, end: Date, filter: "all" | string[]) {
    const pageSize = 1000;
    const rows: Appointment[] = [];
    for (let from = 0; ; from += pageSize) {
      let q = supabase
        .from("appointments")
        .select("id, patient_id, therapist_id, price, discount, is_paid, is_blocked_time, payments_hidden, payment_method, status, start_time, service, patients(name)")
        .neq("status", "cancelled")
        .eq("is_blocked_time", false)
        .eq("payments_hidden", false)
        .gte("start_time", start.toISOString())
        .lt("start_time", end.toISOString())
        .order("start_time", { ascending: true })
        .order("id", { ascending: true })
        .range(from, from + pageSize - 1);
      if (filter !== "all") q = q.in("therapist_id", filter);
      const { data, error } = await q;
      if (error) return { rows, error: error.message };
      const chunk = (data ?? []) as Appointment[];
      rows.push(...chunk);
      if (chunk.length < pageSize) break;
    }
    return { rows, error: null as string | null };
  }

  async function load() {
    errorEl.classList.add("hidden");
    emptyEl.classList.add("hidden");
    ownerWrap.classList.add("hidden");
    ownerWrap.innerHTML = "";
    byWrap.classList.add("hidden");
    breakdownWrap.classList.add("hidden");
    breakdownList.innerHTML = "";

    const { data: { session } } = await supabase.auth.getSession();
    adminEmail = session?.user?.email ?? "";
    const filter = paymentTherapistFilter(adminEmail);
    const master = isMasterAccount(adminEmail);
    const owner = isOwnerAccount(adminEmail);
    const ownSlug = therapistSlugForEmail(adminEmail);
    if (!owner) period = "month";
    periodWrap.classList.toggle("hidden", !owner);
    periodWrap.classList.toggle("flex", owner);
    monthLabel.textContent = periodLabel(period, cursor);
    syncPeriodUi();

    if (owner) {
      const grain = period === "day" ? "την ημέρα" : period === "year" ? "τον χρόνο" : "τον μήνα";
      scopeEl.textContent = `Σύνολο όλων των θεραπευτών για ${grain}.`;
    } else if (master) {
      scopeEl.textContent = "Βλέπετε τις πληρωμές όλων.";
    } else if (ownSlug) {
      const th = getTherapist(ownSlug);
      scopeEl.textContent = `Βλέπετε μόνο τις πληρωμές σας (${th?.nameEl ?? ""}).`;
    } else {
      scopeEl.textContent = "Δεν υπάρχει αντιστοιχία λογαριασμού με θεραπευτή — καμία πληρωμή.";
    }

    if (filter !== "all" && filter.length === 0) {
      document.getElementById("sum-payable")!.textContent = fmtEuro(0);
      document.getElementById("sum-paid")!.textContent = fmtEuro(0);
      document.getElementById("sum-unpaid")!.textContent = fmtEuro(0);
      document.getElementById("pay-count")!.textContent = "";
      return;
    }

    const { start, end } = periodBounds(period, cursor);
    const { rows, error } = await fetchRows(start, end, filter);
    if (error) {
      errorEl.textContent = `Σφάλμα: ${error}`;
      errorEl.classList.remove("hidden");
      return;
    }

    let payable = 0;
    let paid = 0;
    let unpaid = 0;
    let withPrice = 0;
    const buckets = new Map<string, Bucket>();
    const byDay = new Map<string, Totals>();
    const byMonth = new Map<string, Totals>();

    for (const a of rows) {
      if (a.payments_hidden) continue;
      const amount = payableAmount(a);
      if (amount == null) continue;
      withPrice += 1;
      payable += amount;
      if (a.is_paid) paid += amount;
      else unpaid += amount;

      if (owner) {
        const dk = dayKey(a.start_time);
        const mk = monthKey(a.start_time);
        const dayTotals = byDay.get(dk) ?? emptyTotals();
        const monthTotals = byMonth.get(mk) ?? emptyTotals();
        addTotals(dayTotals, amount, a.is_paid);
        addTotals(monthTotals, amount, a.is_paid);
        byDay.set(dk, dayTotals);
        byMonth.set(mk, monthTotals);
      }

      if (master || owner) {
        const tid = a.therapist_id ?? "none";
        const name = getTherapist(a.therapist_id)?.nameEl ?? "—";
        const b = buckets.get(tid) ?? {
          name, payable: 0, paid: 0, unpaid: 0, count: 0, unpaidRows: [], paidRows: [],
        };
        b.payable += amount;
        b.count += 1;
        const row: Row = { ...a, amount };
        if (a.is_paid) {
          b.paid += amount;
          b.paidRows.push(row);
        } else {
          b.unpaid += amount;
          b.unpaidRows.push(row);
        }
        buckets.set(tid, b);
      }
    }

    document.getElementById("sum-payable")!.textContent = fmtEuro(payable);
    document.getElementById("sum-paid")!.textContent = fmtEuro(paid);
    document.getElementById("sum-unpaid")!.textContent = fmtEuro(unpaid);
    document.getElementById("pay-count")!.textContent =
      withPrice ? `${withPrice} ραντεβού με τιμή` : "";

    const emptyCopy =
      period === "day"
        ? "Καμία καταχώρηση με τιμή αυτή την ημέρα."
        : period === "year"
          ? "Καμία καταχώρηση με τιμή αυτόν τον χρόνο."
          : "Καμία καταχώρηση με τιμή αυτόν τον μήνα.";
    emptyEl.textContent = emptyCopy;
    emptyEl.classList.toggle("hidden", withPrice > 0 || (owner && period === "year"));

    if (owner) renderBreakdown(owner, byDay, byMonth);

    if (owner && period !== "year" && buckets.size) {
      ownerWrap.classList.remove("hidden");
      renderOwnerDashboard(buckets);
    } else if ((owner && period === "year" && buckets.size) || (master && !owner && buckets.size)) {
      byWrap.classList.remove("hidden");
      renderTherapistTotals(buckets);
    }
  }

  document.getElementById("pay-prev")!.addEventListener("click", () => {
    shiftCursor(-1);
    load();
  });
  document.getElementById("pay-next")!.addEventListener("click", () => {
    shiftCursor(1);
    load();
  });
  periodWrap.addEventListener("click", (e) => {
    if (!isOwnerAccount(adminEmail)) return;
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-pay-period]");
    const next = btn?.dataset.payPeriod;
    if (next !== "day" && next !== "month" && next !== "year") return;
    if (next === period) return;
    period = next;
    load();
  });
  breakdownList.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-jump]");
    const jump = btn?.dataset.jump;
    if (!jump) return;
    const [y, m, d] = jump.split("-").map(Number);
    if (!y || !m) return;
    if (period === "year") {
      period = "month";
      cursor = new Date(y, m - 1, 1);
    } else {
      period = "day";
      cursor = new Date(y, m - 1, d || 1);
    }
    load();
  });

  load();
</script>
