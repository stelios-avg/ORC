  /** Add months keeping the day-of-month (clamped to the target month's end). */
  function addMonthsClamped(d: Date, months: number): Date {
    const result = new Date(d);
    const day = d.getDate();
    result.setDate(1);
    result.setMonth(result.getMonth() + months);
    const lastDay = new Date(result.getFullYear(), result.getMonth() + 1, 0).getDate();
    result.setDate(Math.min(day, lastDay));
    return result;
  }

  /** Start datetimes for the whole series (first occurrence included). */
  function buildOccurrences(
    first: Date,
    mode = repeatSelect.value,
    countRaw = Number(repeatCountInput.value),
    intervalRaw = Number(repeatIntervalInput.value),
  ): Date[] {
    if (mode === "none") return [first];
    const stepWeeks = mode === "weekly" ? 1
      : mode === "custom" ? Math.min(12, Math.max(1, Number(intervalRaw) || 1))
      : 0;
    const count = Math.min(52, Math.max(1, Number(countRaw) || 1));
    const dates: Date[] = [];
    for (let i = 0; i < count; i++) {
      const d = mode === "monthly"
        ? addMonthsClamped(first, i)
        : (() => {
            const next = new Date(first);
            next.setDate(next.getDate() + i * stepWeeks * 7);
            return next;
          })();
      dates.push(d);
    }
    return dates;
  }

  const isNarrow = () => window.matchMedia("(max-width: 767px)").matches;

  /** Phone: keep the day scroller above the bottom nav, with room to scroll past the FAB. */
  function fitCalendarScroll() {
    const scroll = document.getElementById("cal-scroll");
    if (!scroll) return;
    const inner = scroll.firstElementChild as HTMLElement | null;
    if (!isNarrow() || viewMode !== "day" || dayView.classList.contains("hidden")) {
      scroll.style.maxHeight = "";
      if (inner) inner.style.paddingBottom = "";
      return;
    }
    const nav = document.querySelector("nav");
    const navTop = nav?.getBoundingClientRect().top ?? window.innerHeight;
    const available = Math.max(240, Math.floor(navTop - scroll.getBoundingClientRect().top - 8));
    scroll.style.maxHeight = `${available}px`;
    const fab = document.getElementById("fab-appt");
    const fabShown = !!fab && getComputedStyle(fab).display !== "none";
    const fabTop = fabShown ? fab!.getBoundingClientRect().top : navTop;
    const cover = Math.max(16, Math.ceil(navTop - fabTop) + 16);
    if (inner) inner.style.paddingBottom = `${cover}px`;
  }

