---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { THERAPISTS } from "../../lib/therapists";

// Working hours shown on the calendar
const DAY_START = 8;   // 08:00
const DAY_END = 19;    // 19:00
const hours = Array.from({ length: DAY_END - DAY_START + 1 }, (_, i) => DAY_START + i);
---

<AdminLayout title="Πρόγραμμα" active="calendar">
  {/* ── Date navigation + view toggle ── */}
  <div class="mb-4 flex items-center justify-between gap-2">
    <button id="cal-prev" class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-300 bg-white text-charcoal transition hover:border-spine hover:text-spine" aria-label="Προηγούμενο">
      <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 3L5 8l5 5"/></svg>
    </button>
    <button id="today-btn" class="flex-1 rounded-full bg-white px-4 py-2 text-center ring-1 ring-slate-200 transition hover:ring-spine">
      <span id="date-label" class="font-display text-sm font-bold text-charcoal"></span>
    </button>
    <button id="cal-next" class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-300 bg-white text-charcoal transition hover:border-spine hover:text-spine" aria-label="Επόμενο">
      <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3l5 5-5 5"/></svg>
    </button>
  </div>

  {/* Day / month zoom toggle */}
  <div class="mb-3 flex rounded-full bg-white p-1 ring-1 ring-slate-200">
    <button id="view-day-btn" type="button"
      class="view-btn flex flex-1 items-center justify-center gap-1.5 rounded-full px-3 py-2 font-display text-xs font-semibold transition">
      <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="12" height="11" rx="1.5"/><path d="M2 6h12M5 1v3M11 1v3"/></svg>
      Ημέρα
    </button>
    <button id="view-month-btn" type="button"
      class="view-btn flex flex-1 items-center justify-center gap-1.5 rounded-full px-3 py-2 font-display text-xs font-semibold transition">
      <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
      Μήνας
    </button>
  </div>

  {/* Therapist filter — everyone with admin access can see all calendars */}
  <div id="therapist-tabs" class="mb-4 flex gap-1 overflow-x-auto rounded-full bg-white p-1 ring-1 ring-slate-200">
    <button type="button" data-therapist-filter="all"
      class="therapist-tab flex-none rounded-full px-3 py-2 font-display text-xs font-semibold transition data-[active=true]:bg-charcoal data-[active=true]:text-white data-[active=false]:text-charcoal-muted"
      data-active="true">
      Όλοι
    </button>
    {THERAPISTS.map((th) => (
      <button type="button" data-therapist-filter={th.id}
        class="therapist-tab flex-none rounded-full px-3 py-2 font-display text-xs font-semibold transition data-[active=true]:bg-charcoal data-[active=true]:text-white data-[active=false]:text-charcoal-muted"
        data-active="false">
        {th.nameEl}
      </button>
    ))}
  </div>

  {/* ── Actions (day view only) ── */}
  <div id="day-actions" class="mb-4 grid grid-cols-2 gap-2">
    <button id="add-appt-btn" class="flex items-center justify-center gap-2 rounded-full bg-spine px-4 py-2.5 font-display text-sm font-semibold text-white transition hover:bg-spine-600">
      <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3v10M3 8h10"/></svg>
      Ραντεβού
    </button>
    <button id="block-time-btn" class="flex items-center justify-center gap-2 rounded-full border border-charcoal/30 bg-white px-4 py-2.5 font-display text-sm font-semibold text-charcoal transition hover:border-charcoal">
      <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8" cy="8" r="6"/><path d="M4 4l8 8"/></svg>
      Αποκλεισμός
    </button>
  </div>

  {/* ── Day view: hourly calendar (1+ therapist columns) ── */}
  <div id="day-view">
  <div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-100">
    <div id="cal-col-headers" class="flex border-b border-slate-100">
      <div class="w-14 flex-none"></div>
      <div id="cal-col-headers-inner" class="grid flex-1"></div>
    </div>
    <div class="relative flex">
      {/* Hour labels */}
      <div class="w-14 flex-none border-r border-slate-100">
        {hours.map((h) => (
          <div class="relative h-16">
            <span class="absolute -top-2 right-2 text-[11px] font-medium text-charcoal-muted">
              {String(h).padStart(2, "0")}:00
            </span>
          </div>
        ))}
      </div>

      {/* Events area: CSS grid, 4 rows per hour (15-minute slots) × N therapist cols */}
      <div
        id="cal-grid"
        class="relative flex-1"
        style={`display:grid; grid-template-rows: repeat(${(DAY_END - DAY_START) * 4 + 4}, 1rem);`}
        data-day-start={DAY_START}
        data-day-end={DAY_END}
      >
        {/* Hour lines + appointment blocks injected by JS */}
        <div id="now-line" class="pointer-events-none absolute inset-x-0 z-10 hidden">
          <div class="relative border-t-2 border-red-400">
            <span class="absolute -left-1 -top-[5px] h-2 w-2 rounded-full bg-red-400"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>

  {/* ── Month view: zoomed-out day grid ── */}
  <div id="month-view" class="hidden overflow-hidden rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-100">
    <div id="month-weekdays" class="grid grid-cols-7 text-center text-[11px] font-semibold uppercase text-charcoal-muted"></div>
    <div id="month-days" class="mt-2 grid grid-cols-7 gap-1.5"></div>
  </div>

  <p id="cal-empty" class="mt-6 hidden text-center text-sm text-charcoal-muted">
    Δεν υπάρχουν ραντεβού για αυτή τη μέρα.
  </p>
  <p id="cal-error" class="mt-6 hidden text-center text-sm text-red-600"></p>

  {/* ══ Modal: new appointment ══ */}
  <div id="appt-modal" class="fixed inset-0 z-[100] hidden items-end justify-center sm:items-center">
    <div class="absolute inset-0 bg-spine-900/60 backdrop-blur-sm" data-close-modal></div>
    <div class="relative z-10 w-full max-w-md rounded-t-2xl bg-white p-5 sm:rounded-2xl">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="font-display text-lg font-bold text-charcoal">Νέο ραντεβού</h2>
        <button data-close-modal class="rounded-full p-2 text-charcoal-muted transition hover:bg-slate-100" aria-label="Κλείσιμο">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <form id="appt-form" class="space-y-4">
        <div>
          <label class="mb-1 block text-sm font-medium text-charcoal" for="appt-patient">Πελάτης</label>
          <select id="appt-patient" name="patient_id" required
            class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30">
            <option value="">— Επιλέξτε πελάτη —</option>
          </select>
          <p class="mt-1 text-xs text-charcoal-muted">
            Νέος πελάτης; Προσθέστε τον πρώτα στη σελίδα <a href="/admin/clients" class="text-spine underline">Πελάτες</a>.
          </p>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-charcoal" for="appt-therapist">Θεραπευτής</label>
          <select id="appt-therapist" name="therapist_id" required
            class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30">
            {THERAPISTS.map((th) => (
              <option value={th.id}>{th.nameEl}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-charcoal" for="appt-service">Υπηρεσία</label>
          <select id="appt-service" name="service"
            class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30">
            <option>Φυσιοθεραπεία</option>
            <option>Οστεοπαθητική</option>
            <option>Κλινική Πιλάτες</option>
            <option>Άλλο</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="mb-1 block text-sm font-medium text-charcoal" for="appt-start">Ώρα έναρξης</label>
            <input id="appt-start" name="start" type="time" required step="900" value="08:00"
              class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-charcoal" for="appt-duration">Διάρκεια</label>
            <select id="appt-duration" name="duration"
              class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30">
              <option value="30">30′</option>
              <option value="45">45′</option>
              <option value="60" selected>1 ώρα</option>
              <option value="90">1,5 ώρα</option>
              <option value="120">2 ώρες</option>
            </select>
          </div>
        </div>
        <p id="appt-form-error" class="hidden text-sm text-red-600"></p>
        <button type="submit"
          class="w-full rounded-full bg-spine px-6 py-3 font-display font-semibold text-white transition hover:bg-spine-600 disabled:opacity-60">
          Αποθήκευση
        </button>
      </form>
    </div>
  </div>

  {/* ══ Modal: block time ══ */}
  <div id="block-modal" class="fixed inset-0 z-[100] hidden items-end justify-center sm:items-center">
    <div class="absolute inset-0 bg-spine-900/60 backdrop-blur-sm" data-close-modal></div>
    <div class="relative z-10 w-full max-w-md rounded-t-2xl bg-white p-5 sm:rounded-2xl">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="font-display text-lg font-bold text-charcoal">Αποκλεισμός ώρας</h2>
        <button data-close-modal class="rounded-full p-2 text-charcoal-muted transition hover:bg-slate-100" aria-label="Κλείσιμο">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <form id="block-form" class="space-y-4">
        <div>
          <label class="mb-1 block text-sm font-medium text-charcoal" for="block-therapist">Θεραπευτής</label>
          <select id="block-therapist" name="therapist_id" required
            class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30">
            {THERAPISTS.map((th) => (
              <option value={th.id}>{th.nameEl}</option>
            ))}
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="mb-1 block text-sm font-medium text-charcoal" for="block-start">Από</label>
            <input id="block-start" name="start" type="time" required step="900" value="13:00"
              class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-charcoal" for="block-end">Έως</label>
            <input id="block-end" name="end" type="time" required step="900" value="14:00"
              class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30" />
          </div>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-charcoal" for="block-reason">Σημείωση (προαιρετικό)</label>
          <input id="block-reason" name="reason" type="text" placeholder="π.χ. Διάλειμμα"
            class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30" />
        </div>
        <p id="block-form-error" class="hidden text-sm text-red-600"></p>
        <button type="submit"
          class="w-full rounded-full bg-charcoal px-6 py-3 font-display font-semibold text-white transition hover:bg-charcoal/80 disabled:opacity-60">
          Αποκλεισμός
        </button>
      </form>
    </div>
  </div>

  {/* ══ Bottom sheet: appointment details ══ */}
  <div id="detail-sheet" class="fixed inset-0 z-[100] hidden items-end justify-center sm:items-center">
    <div class="absolute inset-0 bg-spine-900/60 backdrop-blur-sm" data-close-modal></div>
    <div class="relative z-10 w-full max-w-md rounded-t-2xl bg-white p-5 sm:rounded-2xl">
      <div class="mb-1 flex items-start justify-between">
        <h2 id="detail-title" class="font-display text-lg font-bold text-charcoal"></h2>
        <button data-close-modal class="rounded-full p-2 text-charcoal-muted transition hover:bg-slate-100" aria-label="Κλείσιμο">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <p id="detail-time" class="text-sm text-charcoal-muted"></p>
      <p id="detail-service" class="mt-0.5 text-sm text-charcoal"></p>
      <div id="detail-therapist-row" class="mt-3">
        <label class="mb-1 block text-xs font-medium text-charcoal-muted" for="detail-therapist">Θεραπευτής</label>
        <select id="detail-therapist"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30">
          {THERAPISTS.map((th) => (
            <option value={th.id}>{th.nameEl}</option>
          ))}
        </select>
        <p class="mt-1 text-[11px] text-charcoal-muted">Μπορείτε να μεταφέρετε το ραντεβού σε άλλον θεραπευτή.</p>
      </div>
      <a id="detail-phone" href="#" class="mt-1 hidden text-sm font-medium text-spine underline"></a>

      {/* Reason for visit (from the online booking form) */}
      <div id="detail-notes-row" class="mt-4 hidden rounded-xl border border-spine/15 bg-spine-50/60 px-4 py-3">
        <p class="font-display text-xs font-semibold uppercase tracking-wide text-spine">Αιτία επίσκεψης</p>
        <p id="detail-notes" class="mt-1 whitespace-pre-line text-sm text-charcoal"></p>
      </div>

      {/* Price + fixed discount (EUR, not %) */}
      <div id="detail-price-row" class="mt-5 space-y-3 rounded-xl border border-slate-200 px-4 py-3">
        <p class="font-display text-xs font-semibold uppercase tracking-wide text-charcoal-muted">Πληρωμή</p>
        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs text-charcoal-muted">Τιμή (€)</span>
            <input id="detail-price" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0"
              class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-charcoal outline-none focus:border-spine" />
          </label>
          <label class="block">
            <span class="text-xs text-charcoal-muted">Έκπτωση (€)</span>
            <input id="detail-discount" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0"
              class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-charcoal outline-none focus:border-spine" />
          </label>
        </div>
        <p class="text-[11px] text-charcoal-muted">Η έκπτωση είναι σταθερό ποσό σε ευρώ, όχι ποσοστό.</p>
        <div class="flex items-center justify-between gap-3">
          <p class="font-display text-sm font-semibold text-charcoal">
            Πληρωτέο: <span id="detail-payable" class="text-spine">—</span>
          </p>
          <button id="detail-price-save" type="button"
            class="rounded-full bg-spine px-4 py-1.5 font-display text-xs font-semibold text-white transition hover:bg-spine-700 disabled:opacity-50">
            Αποθήκευση
          </button>
        </div>
      </div>

      {/* Paid toggle */}
      <div id="detail-paid-row" class="mt-3 flex items-center justify-between rounded-xl bg-sand px-4 py-3">
        <span class="font-display text-sm font-semibold text-charcoal">Πληρωμένο</span>
        <button id="paid-toggle" role="switch" aria-checked="false"
          class="relative h-7 w-12 rounded-full bg-slate-300 transition-colors data-[on=true]:bg-emerald-500">
          <span class="absolute left-0.5 top-0.5 h-6 w-6 rounded-full bg-white shadow transition-transform duration-200"></span>
        </button>
      </div>

      <button id="detail-delete"
        class="mt-4 w-full rounded-full border border-red-200 px-6 py-2.5 font-display text-sm font-semibold text-red-600 transition hover:bg-red-50">
        Διαγραφή
      </button>
    </div>
  </div>
</AdminLayout>

<style>
  /* Paid switch knob position */
  #paid-toggle[data-on="true"] span {
    transform: translateX(1.25rem);
  }
  .view-btn[data-active="true"] {
    background-color: var(--color-spine);
    color: white;
  }
  .view-btn[data-active="false"] {
    color: var(--color-charcoal-muted);
  }
  .view-btn[data-active="false"]:hover {
    color: var(--color-charcoal);
  }
</style>

<script>
  import { getSupabase, type Appointment, type Patient } from "../../lib/supabase";
  import {
    THERAPISTS,
    DEFAULT_THERAPIST_ID,
    getTherapist,
    suggestTherapistIdForService,
  } from "../../lib/therapists";

  const supabase = getSupabase();

  const grid = document.getElementById("cal-grid")!;
  const colHeadersInner = document.getElementById("cal-col-headers-inner")!;
  const DAY_START = Number(grid.dataset.dayStart);
  const DAY_END = Number(grid.dataset.dayEnd);
  /** total 15' rows in the grid (matches grid-template-rows in the markup) */
  const TOTAL_ROWS = (DAY_END - DAY_START) * 4 + 4;
  const hours = Array.from({ length: DAY_END - DAY_START + 1 }, (_, i) => DAY_START + i);
  const dateLabel = document.getElementById("date-label")!;
  const emptyMsg = document.getElementById("cal-empty")!;
  const errorMsg = document.getElementById("cal-error")!;
  const nowLine = document.getElementById("now-line")!;
  const dayView = document.getElementById("day-view")!;
  const monthView = document.getElementById("month-view")!;
  const dayActions = document.getElementById("day-actions")!;
  const monthDays = document.getElementById("month-days")!;
  const monthWeekdays = document.getElementById("month-weekdays")!;
  const viewDayBtn = document.getElementById("view-day-btn")!;
  const viewMonthBtn = document.getElementById("view-month-btn")!;
  const apptTherapistSelect = document.getElementById("appt-therapist") as HTMLSelectElement;
  const blockTherapistSelect = document.getElementById("block-therapist") as HTMLSelectElement;
  const apptServiceSelect = document.getElementById("appt-service") as HTMLSelectElement;

  let currentDay = new Date();
  currentDay.setHours(0, 0, 0, 0);
  let viewMonth = new Date(currentDay.getFullYear(), currentDay.getMonth(), 1);
  let viewMode: "day" | "month" = "day";
  /** null = show all therapists side by side */
  let therapistFilter: string | null = null;
  let patients: Patient[] = [];
  let selectedAppt: Appointment | null = null;
  let monthAppts: Appointment[] = [];

  const APPT_SELECT = "*, patients(id, name, phone), therapists(id, slug, name_el, name_en)";

  function visibleTherapists() {
    if (therapistFilter) {
      const one = THERAPISTS.find((t) => t.id === therapistFilter);
      return one ? [one] : THERAPISTS;
    }
    return THERAPISTS;
  }

  function therapistName(a: Appointment): string {
    if (a.therapists?.name_el) return a.therapists.name_el;
    return getTherapist(a.therapist_id)?.nameEl ?? "—";
  }

  function setDefaultTherapistSelects() {
    const preferred = therapistFilter ?? DEFAULT_THERAPIST_ID;
    if (preferred) {
      apptTherapistSelect.value = preferred;
      blockTherapistSelect.value = preferred;
    }
  }

  document.querySelectorAll<HTMLButtonElement>("[data-therapist-filter]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const v = btn.dataset.therapistFilter || "all";
      therapistFilter = v === "all" ? null : v;
      document.querySelectorAll<HTMLButtonElement>("[data-therapist-filter]").forEach((b) => {
        b.dataset.active = String(b === btn);
      });
      setDefaultTherapistSelects();
      refresh();
    });
  });

  apptServiceSelect.addEventListener("change", () => {
    const suggested = suggestTherapistIdForService(apptServiceSelect.value);
    if (suggested) apptTherapistSelect.value = suggested;
  });

  const fmtTime = (iso: string) =>
    new Date(iso).toLocaleTimeString("el-GR", { hour: "2-digit", minute: "2-digit" });

  const dayLabel = (d: Date) => {
    const today = new Date(); today.setHours(0, 0, 0, 0);
    const label = d.toLocaleDateString("el-GR", { weekday: "long", day: "numeric", month: "long" });
    return d.getTime() === today.getTime() ? `Σήμερα · ${label}` : label;
  };

  /** minutes since DAY_START → 15' grid row (1-based), clamped to the grid
   *  so appointments beyond DAY_END never overflow the layout */
  const toRow = (date: Date) => {
    const mins = (date.getHours() - DAY_START) * 60 + date.getMinutes();
    const row = Math.round(mins / 15) + 1;
    return Math.min(TOTAL_ROWS + 1, Math.max(1, row));
  };

  const startOfMonth = (d: Date) => new Date(d.getFullYear(), d.getMonth(), 1);
  const sameDay = (a: Date, b: Date) => a.toDateString() === b.toDateString();

  // Weekday header for month grid (Monday-first), built once.
  (() => {
    const monday = new Date(2024, 0, 1);
    for (let i = 0; i < 7; i++) {
      const d = new Date(monday); d.setDate(monday.getDate() + i);
      const el = document.createElement("span");
      el.textContent = d.toLocaleDateString("el-GR", { weekday: "short" }).slice(0, 2);
      monthWeekdays.appendChild(el);
    }
  })();

  function setViewMode(mode: "day" | "month") {
    viewMode = mode;
    viewDayBtn.dataset.active = String(mode === "day");
    viewMonthBtn.dataset.active = String(mode === "month");
    dayView.classList.toggle("hidden", mode !== "day");
    monthView.classList.toggle("hidden", mode !== "month");
    dayActions.classList.toggle("hidden", mode !== "day");
    emptyMsg.classList.add("hidden");
    refresh();
  }

  function updateNavLabel() {
    if (viewMode === "day") {
      dateLabel.textContent = dayLabel(currentDay);
    } else {
      dateLabel.textContent = viewMonth.toLocaleDateString("el-GR", { month: "long", year: "numeric" });
    }
  }

  function refresh() {
    updateNavLabel();
    if (viewMode === "day") loadDay();
    else loadMonth();
  }

  // ── Month overview (zoomed out) ──
  async function loadMonth() {
    monthDays.innerHTML = "";
    errorMsg.classList.add("hidden");

    const monthStart = startOfMonth(viewMonth);
    const monthEnd = new Date(viewMonth.getFullYear(), viewMonth.getMonth() + 1, 1);

    let q = supabase
      .from("appointments")
      .select(APPT_SELECT)
      .gte("start_time", monthStart.toISOString())
      .lt("start_time", monthEnd.toISOString())
      .neq("status", "cancelled")
      .order("start_time");
    if (therapistFilter) q = q.eq("therapist_id", therapistFilter);

    const { data, error } = await q;

    if (error) {
      errorMsg.textContent = `Σφάλμα φόρτωσης: ${error.message}`;
      errorMsg.classList.remove("hidden");
      return;
    }

    monthAppts = (data ?? []) as Appointment[];
    const today = new Date(); today.setHours(0, 0, 0, 0);

    const offset = (viewMonth.getDay() + 6) % 7;
    for (let i = 0; i < offset; i++) monthDays.appendChild(document.createElement("span"));

    const daysInMonth = new Date(viewMonth.getFullYear(), viewMonth.getMonth() + 1, 0).getDate();
    for (let day = 1; day <= daysInMonth; day++) {
      const d = new Date(viewMonth.getFullYear(), viewMonth.getMonth(), day);
      const dayAppts = monthAppts.filter((a) => sameDay(new Date(a.start_time), d));
      const regular = dayAppts.filter((a) => !a.is_blocked_time);
      const blocked = dayAppts.filter((a) => a.is_blocked_time);
      const isToday = sameDay(d, today);
      const isSelected = sameDay(d, currentDay);

      const btn = document.createElement("button");
      btn.type = "button";
      btn.className =
        "month-day flex min-h-[4.5rem] flex-col rounded-xl border p-2 text-left transition " +
        (isSelected
          ? "border-spine bg-spine-50 ring-1 ring-spine/30"
          : isToday
            ? "border-spine/30 bg-white ring-1 ring-spine/20"
            : "border-slate-100 bg-white hover:border-spine/30 hover:bg-spine-50/40");

      const countLabel = regular.length
        ? `${regular.length} ραντεβ.${blocked.length ? ` · ${blocked.length} κλ.` : ""}`
        : blocked.length ? `${blocked.length} κλειστό` : "";

      btn.innerHTML = `
        <span class="font-display text-sm font-bold ${isToday ? "text-spine" : "text-charcoal"}">${day}</span>
        ${countLabel ? `<span class="mt-1 text-[10px] font-medium leading-tight text-charcoal-muted">${countLabel}</span>` : ""}
        ${regular.length ? `<span class="mt-auto truncate text-[10px] text-spine">${regular.slice(0, 2).map((a) => a.patients?.name?.split(" ")[0] ?? "—").join(", ")}${regular.length > 2 ? "…" : ""}</span>` : ""}`;

      btn.addEventListener("click", () => {
        currentDay = new Date(d);
        setViewMode("day");
      });
      monthDays.appendChild(btn);
    }
  }

  function setupDayColumns(cols: typeof THERAPISTS) {
    colHeadersInner.style.gridTemplateColumns = `repeat(${cols.length}, minmax(0, 1fr))`;
    colHeadersInner.innerHTML = cols.map((th) => {
      const accent = th.accent === "sky" ? "text-sky-700" : "text-spine";
      return `<div class="border-l border-slate-100 px-2 py-2 text-center font-display text-xs font-bold ${accent}">${th.nameEl}</div>`;
    }).join("");

    grid.style.gridTemplateColumns = `repeat(${cols.length}, minmax(0, 1fr))`;
    grid.querySelectorAll("[data-appt], [data-hour-line], [data-col-rule]").forEach((el) => el.remove());

    hours.forEach((_, i) => {
      const line = document.createElement("div");
      line.setAttribute("data-hour-line", "");
      line.className = "pointer-events-none border-t border-slate-100";
      line.style.gridRow = String(i * 4 + 1);
      line.style.gridColumn = "1 / -1";
      grid.appendChild(line);
    });

    // Vertical dividers between therapist columns
    for (let c = 2; c <= cols.length; c++) {
      const rule = document.createElement("div");
      rule.setAttribute("data-col-rule", "");
      rule.className = "pointer-events-none border-l border-slate-100";
      rule.style.gridRow = "1 / -1";
      rule.style.gridColumn = String(c);
      grid.appendChild(rule);
    }
  }

  // ── Load & render the day ──
  async function loadDay() {
    updateNavLabel();
    const dayEnd = new Date(currentDay); dayEnd.setDate(dayEnd.getDate() + 1);
    const cols = visibleTherapists();
    setupDayColumns(cols);

    let q = supabase
      .from("appointments")
      .select(APPT_SELECT)
      .gte("start_time", currentDay.toISOString())
      .lt("start_time", dayEnd.toISOString())
      .neq("status", "cancelled")
      .order("start_time");
    if (therapistFilter) q = q.eq("therapist_id", therapistFilter);

    const { data, error } = await q;

    errorMsg.classList.add("hidden");
    if (error) {
      errorMsg.textContent = `Σφάλμα φόρτωσης: ${error.message}`;
      errorMsg.classList.remove("hidden");
      return;
    }

    const appts = (data ?? []) as Appointment[];
    emptyMsg.classList.toggle("hidden", appts.length > 0);

    appts.forEach((a) => {
      const start = new Date(a.start_time);
      const end = new Date(a.end_time);
      const rowStart = Math.min(toRow(start), TOTAL_ROWS);
      const rowEnd = Math.max(rowStart + 1, toRow(end));

      let colIdx = cols.findIndex((t) => t.id === a.therapist_id);
      if (colIdx < 0) colIdx = 0; // unassigned → first visible column

      const block = document.createElement("button");
      block.setAttribute("data-appt", a.id);
      block.style.gridRow = `${rowStart} / ${rowEnd}`;
      block.style.gridColumn = String(colIdx + 1);

      const th = getTherapist(a.therapist_id);
      const isSky = th?.accent === "sky";

      if (a.is_blocked_time) {
        block.className =
          "z-20 mx-0.5 my-px overflow-hidden rounded-lg border border-slate-300 bg-slate-100 px-2 py-1 text-left " +
          "bg-[repeating-linear-gradient(45deg,transparent,transparent_6px,rgba(0,0,0,0.04)_6px,rgba(0,0,0,0.04)_12px)]";
        block.innerHTML = `
          <p class="truncate text-xs font-semibold text-charcoal-muted">${a.service || "Κλειστό"}</p>
          <p class="text-[11px] text-charcoal-muted">${fmtTime(a.start_time)} – ${fmtTime(a.end_time)}</p>`;
      } else {
        block.className = isSky
          ? "z-20 mx-0.5 my-px overflow-hidden rounded-lg border-l-4 border-sky-500 bg-sky-50 px-2 py-1 text-left transition hover:bg-sky-100"
          : "z-20 mx-0.5 my-px overflow-hidden rounded-lg border-l-4 border-spine bg-spine-50 px-2 py-1 text-left transition hover:bg-spine-100";
        const nameColor = isSky ? "text-sky-700" : "text-spine";
        const payable = payableAmount(a);
        const amountLabel = payable != null
          ? `<span class="flex-none text-[10px] font-semibold ${a.is_paid ? "text-emerald-600" : "text-charcoal-muted"}">${fmtEuro(payable)}</span>`
          : "";
        const showTherapist = !therapistFilter;
        block.innerHTML = `
          <div class="flex items-center justify-between gap-1">
            <p class="truncate font-display text-xs font-bold ${nameColor}">${a.patients?.name ?? "—"}</p>
            <span class="flex flex-none items-center gap-1">
              ${amountLabel}
              ${a.is_paid ? '<span class="flex h-4 w-4 flex-none items-center justify-center rounded-full bg-emerald-500 text-[9px] font-bold text-white">✓</span>' : ""}
            </span>
          </div>
          <p class="truncate text-[11px] text-charcoal-muted">${fmtTime(a.start_time)} – ${fmtTime(a.end_time)} · ${a.service ?? ""}${showTherapist ? ` · ${therapistName(a)}` : ""}</p>`;
      }

      block.addEventListener("click", () => openDetail(a));
      grid.appendChild(block);
    });

    positionNowLine();
  }

  function positionNowLine() {
    const now = new Date();
    const isToday = now.toDateString() === currentDay.toDateString();
    const mins = (now.getHours() - DAY_START) * 60 + now.getMinutes();
    const totalMins = (DAY_END - DAY_START) * 60;
    if (!isToday || mins < 0 || mins > totalMins) {
      nowLine.classList.add("hidden");
      return;
    }
    nowLine.style.top = `${(mins / totalMins) * 100}%`;
    nowLine.classList.remove("hidden");
  }
  setInterval(positionNowLine, 60_000);

  // ── Date navigation ──
  document.getElementById("cal-prev")!.addEventListener("click", () => {
    if (viewMode === "day") {
      currentDay.setDate(currentDay.getDate() - 1);
    } else {
      viewMonth = new Date(viewMonth.getFullYear(), viewMonth.getMonth() - 1, 1);
    }
    refresh();
  });
  document.getElementById("cal-next")!.addEventListener("click", () => {
    if (viewMode === "day") {
      currentDay.setDate(currentDay.getDate() + 1);
    } else {
      viewMonth = new Date(viewMonth.getFullYear(), viewMonth.getMonth() + 1, 1);
    }
    refresh();
  });
  document.getElementById("today-btn")!.addEventListener("click", () => {
    currentDay = new Date(); currentDay.setHours(0, 0, 0, 0);
    viewMonth = startOfMonth(currentDay);
    refresh();
  });

  viewDayBtn.addEventListener("click", () => setViewMode("day"));
  viewMonthBtn.addEventListener("click", () => {
    viewMonth = startOfMonth(currentDay);
    setViewMode("month");
  });

  // ── Modals ──
  const apptModal = document.getElementById("appt-modal")!;
  const blockModal = document.getElementById("block-modal")!;
  const detailSheet = document.getElementById("detail-sheet")!;
  const openModal = (m: HTMLElement) => { m.classList.remove("hidden"); m.classList.add("flex"); };
  const closeModal = (m: HTMLElement) => { m.classList.add("hidden"); m.classList.remove("flex"); };
  document.querySelectorAll("[data-close-modal]").forEach((el) =>
    el.addEventListener("click", () => [apptModal, blockModal, detailSheet].forEach(closeModal)),
  );

  // ── New appointment ──
  document.getElementById("add-appt-btn")!.addEventListener("click", async () => {
    // Always refetch so clients added on /admin/clients show up without a reload.
    const select = document.getElementById("appt-patient") as HTMLSelectElement;
    const previous = select.value;
    const { data, error } = await supabase.from("patients").select("*").order("name");
    if (!error) {
      patients = (data ?? []) as Patient[];
      select.length = 1;
      patients.forEach((p) => select.add(new Option(p.name, p.id)));
      if (previous && patients.some((p) => p.id === previous)) select.value = previous;
    }
    setDefaultTherapistSelects();
    const suggested = suggestTherapistIdForService(apptServiceSelect.value);
    if (suggested && !therapistFilter) apptTherapistSelect.value = suggested;
    openModal(apptModal);
  });

  document.getElementById("appt-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const fd = new FormData(form);
    const err = document.getElementById("appt-form-error")!;
    err.classList.add("hidden");

    const [h, m] = String(fd.get("start")).split(":").map(Number);
    const start = new Date(currentDay); start.setHours(h, m, 0, 0);
    const end = new Date(start.getTime() + Number(fd.get("duration")) * 60_000);

    const { error } = await supabase.from("appointments").insert({
      patient_id: String(fd.get("patient_id")),
      therapist_id: String(fd.get("therapist_id")),
      service: String(fd.get("service")),
      start_time: start.toISOString(),
      end_time: end.toISOString(),
    });

    if (error) {
      err.textContent = error.message;
      err.classList.remove("hidden");
      return;
    }
    form.reset();
    setDefaultTherapistSelects();
    closeModal(apptModal);
    refresh();
  });

  // ── Block time ──
  document.getElementById("block-time-btn")!.addEventListener("click", () => {
    setDefaultTherapistSelects();
    openModal(blockModal);
  });

  document.getElementById("block-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const fd = new FormData(form);
    const err = document.getElementById("block-form-error")!;
    err.classList.add("hidden");

    const [sh, sm] = String(fd.get("start")).split(":").map(Number);
    const [eh, em] = String(fd.get("end")).split(":").map(Number);
    const start = new Date(currentDay); start.setHours(sh, sm, 0, 0);
    const end = new Date(currentDay); end.setHours(eh, em, 0, 0);

    if (end <= start) {
      err.textContent = "Η ώρα λήξης πρέπει να είναι μετά την έναρξη.";
      err.classList.remove("hidden");
      return;
    }

    const { error } = await supabase.from("appointments").insert({
      is_blocked_time: true,
      therapist_id: String(fd.get("therapist_id")),
      service: String(fd.get("reason") || "Κλειστό"),
      start_time: start.toISOString(),
      end_time: end.toISOString(),
    });

    if (error) {
      err.textContent = error.message;
      err.classList.remove("hidden");
      return;
    }
    form.reset();
    setDefaultTherapistSelects();
    closeModal(blockModal);
    refresh();
  });

  // ── Pricing helpers (fixed EUR discount, not %) ──
  function payableAmount(a: Pick<Appointment, "price" | "discount">): number | null {
    if (a.price == null || Number.isNaN(Number(a.price))) return null;
    return Math.max(0, Number(a.price) - Number(a.discount ?? 0));
  }

  function fmtEuro(n: number): string {
    return n.toLocaleString("el-GR", { style: "currency", currency: "EUR" });
  }

  function parseMoneyInput(el: HTMLInputElement): number | null {
    const raw = el.value.trim();
    if (raw === "") return null;
    const n = Number(raw.replace(",", "."));
    if (!Number.isFinite(n) || n < 0) return null;
    return Math.round(n * 100) / 100;
  }

  // ── Detail sheet + paid toggle + delete ──
  const paidToggle = document.getElementById("paid-toggle")!;
  const priceInput = document.getElementById("detail-price") as HTMLInputElement;
  const discountInput = document.getElementById("detail-discount") as HTMLInputElement;
  const payableEl = document.getElementById("detail-payable")!;
  const priceSaveBtn = document.getElementById("detail-price-save") as HTMLButtonElement;

  function updatePayablePreview() {
    const price = parseMoneyInput(priceInput);
    const discount = parseMoneyInput(discountInput) ?? 0;
    if (price == null) {
      payableEl.textContent = "—";
      return;
    }
    payableEl.textContent = fmtEuro(Math.max(0, price - discount));
  }

  priceInput.addEventListener("input", updatePayablePreview);
  discountInput.addEventListener("input", updatePayablePreview);

  const detailTherapistSelect = document.getElementById("detail-therapist") as HTMLSelectElement;
  const detailTherapistRow = document.getElementById("detail-therapist-row")!;

  function openDetail(a: Appointment) {
    selectedAppt = a;
    document.getElementById("detail-title")!.textContent =
      a.is_blocked_time ? (a.service || "Κλειστό") : (a.patients?.name ?? "Ραντεβού");
    document.getElementById("detail-time")!.textContent =
      `${fmtTime(a.start_time)} – ${fmtTime(a.end_time)}`;
    document.getElementById("detail-service")!.textContent = a.is_blocked_time ? "" : (a.service ?? "");
    detailTherapistRow.classList.remove("hidden");
    detailTherapistSelect.value = a.therapist_id ?? DEFAULT_THERAPIST_ID;

    const phoneEl = document.getElementById("detail-phone") as HTMLAnchorElement;
    if (!a.is_blocked_time && a.patients?.phone) {
      phoneEl.textContent = a.patients.phone;
      phoneEl.href = `tel:${a.patients.phone}`;
      phoneEl.classList.remove("hidden");
    } else {
      phoneEl.classList.add("hidden");
    }

    const notesRow = document.getElementById("detail-notes-row")!;
    const hasNotes = !a.is_blocked_time && !!a.notes?.trim();
    notesRow.classList.toggle("hidden", !hasNotes);
    if (hasNotes) document.getElementById("detail-notes")!.textContent = a.notes!.trim();

    const hideMoney = a.is_blocked_time;
    document.getElementById("detail-price-row")!.classList.toggle("hidden", hideMoney);
    document.getElementById("detail-paid-row")!.classList.toggle("hidden", hideMoney);
    if (!hideMoney) {
      priceInput.value = a.price != null ? String(a.price) : "";
      discountInput.value = a.discount ? String(a.discount) : "";
      updatePayablePreview();
    }

    paidToggle.dataset.on = String(a.is_paid);
    paidToggle.setAttribute("aria-checked", String(a.is_paid));
    openModal(detailSheet);
  }

  detailTherapistSelect.addEventListener("change", async () => {
    if (!selectedAppt) return;
    const nextId = detailTherapistSelect.value;
    const prevId = selectedAppt.therapist_id;
    if (nextId === prevId) return;

    detailTherapistSelect.disabled = true;
    const { error } = await supabase
      .from("appointments")
      .update({ therapist_id: nextId })
      .eq("id", selectedAppt.id);
    detailTherapistSelect.disabled = false;

    if (error) {
      detailTherapistSelect.value = prevId ?? DEFAULT_THERAPIST_ID;
      alert(`Αποτυχία μεταφοράς: ${error.message}`);
      return;
    }

    selectedAppt.therapist_id = nextId;
    const th = getTherapist(nextId);
    selectedAppt.therapists = th
      ? { id: th.id, slug: th.slug, name_el: th.nameEl, name_en: th.nameEn }
      : null;
    refresh();
  });

  priceSaveBtn.addEventListener("click", async () => {
    if (!selectedAppt) return;
    const price = parseMoneyInput(priceInput);
    const discount = parseMoneyInput(discountInput) ?? 0;
    if (priceInput.value.trim() !== "" && price == null) {
      alert("Μη έγκυρη τιμή.");
      return;
    }
    if (discountInput.value.trim() !== "" && parseMoneyInput(discountInput) == null) {
      alert("Μη έγκυρη έκπτωση.");
      return;
    }
    if (price != null && discount > price) {
      if (!confirm("Η έκπτωση είναι μεγαλύτερη από την τιμή. Το πληρωτέο θα είναι 0 €. Συνέχεια;")) return;
    }

    priceSaveBtn.disabled = true;
    const { error } = await supabase
      .from("appointments")
      .update({ price, discount })
      .eq("id", selectedAppt.id);
    priceSaveBtn.disabled = false;
    if (error) {
      alert(`Αποτυχία αποθήκευσης: ${error.message}`);
      return;
    }
    selectedAppt.price = price;
    selectedAppt.discount = discount;
    updatePayablePreview();
    refresh();
  });

  paidToggle.addEventListener("click", async () => {
    if (!selectedAppt) return;
    const next = !(paidToggle.dataset.on === "true");
    // optimistic UI, revert on failure
    paidToggle.dataset.on = String(next);
    paidToggle.setAttribute("aria-checked", String(next));
    const { error } = await supabase
      .from("appointments").update({ is_paid: next }).eq("id", selectedAppt.id);
    if (error) {
      paidToggle.dataset.on = String(!next);
      paidToggle.setAttribute("aria-checked", String(!next));
      return;
    }
    selectedAppt.is_paid = next;
    refresh();
  });

  document.getElementById("detail-delete")!.addEventListener("click", async () => {
    if (!selectedAppt) return;
    if (!confirm("Σίγουρα θέλετε να διαγράψετε αυτή την καταχώρηση;")) return;
    const deleteBtn = document.getElementById("detail-delete") as HTMLButtonElement;
    deleteBtn.disabled = true;
    const { error } = await supabase.from("appointments").delete().eq("id", selectedAppt.id);
    deleteBtn.disabled = false;
    if (error) {
      alert(`Η διαγραφή απέτυχε: ${error.message}`);
      return;
    }
    closeModal(detailSheet);
    refresh();
  });

  setViewMode("day");
</script>
