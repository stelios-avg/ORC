  // ── Month overview: months continue down the page, native scroll is left alone ──
  let monthToken = 0;
  let monthCursor: Date | null = null;
  let monthAnchor = startOfMonth(new Date());
  let monthAppending = false;

  function scrollPageTop() {
    const root = document.scrollingElement || document.documentElement;
    const prev = root.style.scrollBehavior;
    root.style.scrollBehavior = "auto";
    root.scrollTop = 0;
    root.style.scrollBehavior = prev;
  }

  async function fetchMonthAppointments(month: Date): Promise<Appointment[]> {
    const monthStart = startOfMonth(month);
    const monthEnd = new Date(month.getFullYear(), month.getMonth() + 1, 1);
    let q = supabase
      .from("appointments")
      .select(APPT_SELECT)
      .gte("start_time", monthStart.toISOString())
      .lt("start_time", monthEnd.toISOString())
      .neq("status", "cancelled")
      .order("start_time");
    if (therapistFilter) q = q.eq("therapist_id", therapistFilter);
    else q = q.neq("therapist_id", pilatesId);
    const { data, error } = await q;
    if (error) throw new Error(error.message);
    const rows = (data ?? []) as Appointment[];
    const standing = await fetchForeverAppointments(monthEnd);
    const byId = new Map(rows.map((a) => [a.id, a]));
    for (const a of standing) byId.set(a.id, a);
    return [...byId.values()];
  }

  function buildMonthSection(month: Date, appts: Appointment[]): HTMLElement {
    const section = document.createElement("section");
    section.dataset.month = `${month.getFullYear()}-${month.getMonth()}`;
    section.className = "rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-100";

    const title = document.createElement("h2");
    title.className = "mb-3 font-display text-base font-bold capitalize text-charcoal";
    title.textContent = month.toLocaleDateString("el-GR", { month: "long", year: "numeric" });

    const weekdays = monthWeekdays.cloneNode(true) as HTMLElement;
    weekdays.removeAttribute("id");
    weekdays.classList.remove("hidden");

    const days = document.createElement("div");
    days.className = "mt-2 grid grid-cols-7 gap-1.5";
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const offset = (month.getDay() + 6) % 7;
    for (let i = 0; i < offset; i++) days.appendChild(document.createElement("span"));

    const daysInMonth = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
    for (let day = 1; day <= daysInMonth; day++) {
      const d = new Date(month.getFullYear(), month.getMonth(), day);
      const dayAppts = appts.filter((a) => occursOn(a, d));
      const regular = dayAppts.filter((a) => !a.is_blocked_time);
      const blocked = dayAppts.filter((a) => a.is_blocked_time);
      const isToday = sameDay(d, today);
      const isSelected = sameDay(d, currentDay);

      const btn = document.createElement("button");
      btn.type = "button";
      btn.className =
        "month-day flex min-h-[4.5rem] flex-col rounded-xl border p-2 text-left transition " +
        (isSelected
          ? "border-spine bg-spine-50 ring-1 ring-spine/30"
          : isToday
            ? "border-spine/30 bg-white ring-1 ring-spine/20"
            : "border-slate-100 bg-white hover:border-spine/30 hover:bg-spine-50/40");

      const countLabel = regular.length
        ? `${regular.length} ραντεβ.${blocked.length ? ` · ${blocked.length} κλ.` : ""}`
        : blocked.length ? `${blocked.length} κλειστό` : "";

      btn.innerHTML = `
        <span class="font-display text-sm font-bold ${isToday ? "text-spine" : "text-charcoal"}">${day}</span>
        ${countLabel ? `<span class="mt-1 text-[10px] font-medium leading-tight text-charcoal-muted">${countLabel}</span>` : ""}
        ${regular.length ? `<span class="mt-auto truncate text-[10px] text-spine">${regular.slice(0, 2).map((a) => appointmentClientName(a).split(" ")[0]).join(", ")}${regular.length > 2 ? "…" : ""}</span>` : ""}`;

      btn.addEventListener("click", () => {
        currentDay = new Date(d);
        setViewMode("day");
      });
      days.appendChild(btn);
    }

    section.append(title, weekdays, days);
    return section;
  }

  function monthTooFar(cursor: Date): boolean {
    const n = (cursor.getFullYear() - monthAnchor.getFullYear()) * 12
      + (cursor.getMonth() - monthAnchor.getMonth());
    return n >= 18;
  }

  /** Append the next month while the page still has room to keep scrolling. */
  async function ensureMonthsBelow(token: number) {
    if (monthAppending || token !== monthToken || !monthCursor || viewMode !== "month") return;
    if (monthTooFar(monthCursor)) return;
    const root = document.scrollingElement || document.documentElement;
    const remaining = root.scrollHeight - root.scrollTop - window.innerHeight;
    const count = monthStack.childElementCount;
    // Several months sit on the page first, so a finger scroll keeps moving.
    if (count >= 8 && root.scrollTop < 40) return;
    if (count >= 4 && remaining > window.innerHeight * 2) return;

    monthAppending = true;
    const month = monthCursor;
    try {
      const appts = await fetchMonthAppointments(month);
      if (token !== monthToken) return;
      monthStack.appendChild(buildMonthSection(month, appts));
      monthCursor = new Date(month.getFullYear(), month.getMonth() + 1, 1);
    } catch (err) {
      if (token !== monthToken) return;
      errorMsg.textContent = `Σφάλμα φόρτωσης: ${err instanceof Error ? err.message : String(err)}`;
      errorMsg.classList.remove("hidden");
      return;
    } finally {
      monthAppending = false;
    }
    if (token === monthToken) void ensureMonthsBelow(token);
  }

  function syncMonthLabel() {
    if (viewMode !== "month") return;
    const sections = [...monthStack.querySelectorAll<HTMLElement>("[data-month]")];
    if (!sections.length) return;
    let visible = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= 150) visible = section;
    }
    const [y, m] = (visible.dataset.month ?? "").split("-").map(Number);
    if (!Number.isFinite(y) || !Number.isFinite(m)) return;
    const next = new Date(y, m, 1);
    if (next.getTime() === viewMonth.getTime()) return;
    viewMonth = next;
    dateLabel.textContent = next.toLocaleDateString("el-GR", { month: "long", year: "numeric" });
  }

  async function loadMonth() {
    const token = ++monthToken;
    monthAnchor = startOfMonth(viewMonth);
    monthCursor = null;
    monthStack.innerHTML = "";
    errorMsg.classList.add("hidden");
    scrollPageTop();
    try {
      const appts = await fetchMonthAppointments(monthAnchor);
      if (token !== monthToken) return;
      monthAppts = appts;
      monthStack.appendChild(buildMonthSection(monthAnchor, appts));
      monthCursor = new Date(monthAnchor.getFullYear(), monthAnchor.getMonth() + 1, 1);
      void ensureMonthsBelow(token);
    } catch (err) {
      if (token !== monthToken) return;
      errorMsg.textContent = `Σφάλμα φόρτωσης: ${err instanceof Error ? err.message : String(err)}`;
      errorMsg.classList.remove("hidden");
    }
  }

  let monthScrollTick = false;
  window.addEventListener("scroll", () => {
    if (viewMode !== "month" || monthScrollTick) return;
    monthScrollTick = true;
    requestAnimationFrame(() => {
      monthScrollTick = false;
      if (viewMode !== "month") return;
      syncMonthLabel();
      void ensureMonthsBelow(monthToken);
    });
  }, { passive: true });

  let laidOutCols: typeof THERAPISTS | null = null;
  let lastScrollW = -1;

  function setupDayColumns(cols: typeof THERAPISTS) {
    laidOutCols = cols;
    const multi = cols.length > 1;
    const colMin = isNarrow() ? 152 : 168;
    const template = multi
      ? `repeat(${cols.length}, minmax(${colMin}px, 1fr))`
      : "minmax(0, 1fr)";

    document.documentElement.style.setProperty("--cal-row", isNarrow() ? "22px" : "20px");

    const scroll = document.getElementById("cal-scroll")!;
    const hours = document.getElementById("cal-hours")!;
    lastScrollW = scroll.clientWidth;
    const available = Math.max(0, lastScrollW - hours.getBoundingClientRect().width);
    const width = multi ? Math.max(cols.length * colMin, available) : Math.max(available, colMin);
    colsWrap.style.width = `${width}px`;
    colsWrap.style.minWidth = `${width}px`;
    scrollHint.classList.toggle("hidden", !(multi && isNarrow() && width > available + 1));

    colHeadersInner.style.gridTemplateColumns = template;
    colHeadersInner.innerHTML = cols.map((th) => {
      const accent = therapistAccentClasses(th.accent).text;
      return `<div class="flex items-center justify-center border-l border-slate-100 px-2 font-display text-[11px] font-bold leading-tight ${accent} sm:text-xs">${th.nameEl}</div>`;
    }).join("");

    grid.style.gridTemplateColumns = template;
    grid.style.gridTemplateRows = `repeat(${TOTAL_ROWS}, var(--cal-row, 22px))`;
    grid.querySelectorAll("[data-appt], [data-hour-line], [data-col-rule]").forEach((el) => el.remove());
    hideHoverSlot();
    hideApptPreview();
    hideCtxMenu();

    for (let row = 0; row < TOTAL_ROWS; row++) {
      const line = document.createElement("div");
      line.setAttribute("data-hour-line", "");
      const onHour = row % ROWS_PER_MAJOR === 0;
      line.className = onHour
        ? "pointer-events-none border-t border-slate-300"
        : "pointer-events-none border-t border-dashed border-slate-200";
      line.style.gridRow = String(row + 1);
      line.style.gridColumn = "1 / -1";
      grid.appendChild(line);
    }

    for (let c = 2; c <= cols.length; c++) {
      const rule = document.createElement("div");
      rule.setAttribute("data-col-rule", "");
      rule.className = "pointer-events-none border-l border-slate-100";
      rule.style.gridRow = "1 / -1";
      rule.style.gridColumn = String(c);
      grid.appendChild(rule);
    }
  }

  // ── Load & render the day ──
  async function loadDay() {
    updateNavLabel();
    const dayEnd = new Date(currentDay); dayEnd.setDate(dayEnd.getDate() + 1);
    const cols = visibleTherapists();
    setupDayColumns(cols);

    let q = supabase
      .from("appointments")
      .select(APPT_SELECT)
      .gte("start_time", currentDay.toISOString())
      .lt("start_time", dayEnd.toISOString())
      .neq("status", "cancelled")
      .order("start_time");
    if (therapistFilter) q = q.eq("therapist_id", therapistFilter);
    else q = q.neq("therapist_id", pilatesId);

    const { data, error } = await q;

    errorMsg.classList.add("hidden");
    if (error) {
      errorMsg.textContent = `Σφάλμα φόρτωσης: ${error.message}`;
      errorMsg.classList.remove("hidden");
      return;
    }

    const appts = (data ?? []) as Appointment[];
    try {
      const standing = await fetchForeverAppointments(dayEnd);
      const seen = new Set(appts.map((a) => a.id));
      for (const a of standing) {
        if (seen.has(a.id) || !occursOn(a, currentDay)) continue;
        appts.push(a);
      }
    } catch (err) {
      errorMsg.textContent = `Σφάλμα φόρτωσης: ${err instanceof Error ? err.message : String(err)}`;
      errorMsg.classList.remove("hidden");
      return;
    }
    emptyMsg.classList.toggle("hidden", appts.length > 0);

    type LaidOut = {
      a: Appointment;
      startMs: number;
      endMs: number;
      rowStart: number;
      rowEnd: number;
      colIdx: number;
      lane: number;
      laneCount: number;
    };

    const laid: LaidOut[] = appts.flatMap((a) => {
      const start = new Date(a.start_time);
      const end = new Date(a.end_time);
      const colIdx = cols.findIndex((t) => t.id === a.therapist_id);
      if (colIdx < 0) return [];
      return [{
        a,
        startMs: start.getTime(),
        endMs: end.getTime(),
        rowStart: Math.min(toRow(start), TOTAL_ROWS),
        rowEnd: Math.max(Math.min(toRow(start), TOTAL_ROWS) + 1, toRow(end)),
        colIdx,
        lane: 0,
        laneCount: 1,
      }];
    });

    // Blocks stay full-width behind the column. Only real appointments share lanes
    // (so concurrent physio bookings both stay visible, Fresha-style).
    for (let c = 0; c < cols.length; c++) {
      const group = laid
        .filter((x) => x.colIdx === c && !x.a.is_blocked_time)
        .sort((x, y) => x.startMs - y.startMs || x.endMs - y.endMs);
      const laneEnds: number[] = [];
      for (const item of group) {
        let lane = laneEnds.findIndex((end) => end <= item.startMs);
        if (lane < 0) {
          lane = laneEnds.length;
          laneEnds.push(item.endMs);
        } else {
          laneEnds[lane] = item.endMs;
        }
        item.lane = lane;
      }
      for (const item of group) {
        const peers = group.filter((o) => o.startMs < item.endMs && o.endMs > item.startMs);
        item.laneCount = Math.max(1, ...peers.map((p) => p.lane + 1));
      }
    }

    // Paint blocks first so staff appointments sit on top and stay tappable.
    const paintOrder = [
      ...laid.filter((x) => x.a.is_blocked_time),
      ...laid.filter((x) => !x.a.is_blocked_time),
    ];

    paintOrder.forEach(({ a, rowStart, rowEnd, colIdx, lane, laneCount }) => {
      const block = document.createElement("button");
      block.setAttribute("data-appt", a.id);
      block.style.gridRow = `${rowStart} / ${rowEnd}`;
      block.style.gridColumn = String(colIdx + 1);
      block.style.justifySelf = "start";

      const th = getTherapist(a.therapist_id);
      const accent = therapistAccentClasses(th?.accent ?? "spine");

      if (a.is_blocked_time) {
        // Background only: taps fall through to the grid so staff can book inside.
        block.type = "button";
        block.className =
          "pointer-events-none z-[1] my-px w-[calc(100%-4px)] overflow-hidden rounded-lg border border-dashed border-slate-300 bg-slate-100/80 px-1.5 py-1 text-left " +
          "bg-[repeating-linear-gradient(45deg,transparent,transparent_6px,rgba(0,0,0,0.045)_6px,rgba(0,0,0,0.045)_12px)]";
        const reason = (a.service || "").trim();
        const label = !reason || reason === "Κλειστό" ? "Κλειστό online" : reason;
        block.innerHTML = `
          <div class="flex items-start justify-between gap-1">
            <div class="min-w-0">
              <p class="truncate text-xs font-semibold text-charcoal-muted">${label}</p>
              <p class="text-[11px] text-charcoal-muted">${fmtTime(a.start_time)} – ${fmtTime(a.end_time)}${repeatMark(a)}</p>
            </div>
            <span data-edit-block title="Αλλαγή αποκλεισμού"
              class="pointer-events-auto flex h-8 w-8 flex-none items-center justify-center rounded-full bg-white/90 text-charcoal ring-1 ring-slate-300">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
              </svg>
            </span>
          </div>`;
        block.querySelector("[data-edit-block]")!.addEventListener("click", (ev) => {
          ev.stopPropagation();
          ev.preventDefault();
          openDetail(a);
        });
      } else {
        block.type = "button";
        block.style.width = `calc(${100 / laneCount}% - 4px)`;
        block.style.marginLeft = `calc(${(lane * 100) / laneCount}% + 2px)`;
        block.style.zIndex = "20";
        block.className = accent.block.replace(/\bmx-0\.5\b/g, "").trim() + " relative z-20";
        const nameColor = accent.text;
        // Non-masters: hide € when payment is hidden from totals.
        // Masters: keep € visible (muted) so they can find & restore it.
        const master = isMasterAccount(adminEmail);
        const showPay = canSeePayments(a) && (!a.payments_hidden || master);
        const paidMark = showPay && a.is_paid && !a.payments_hidden
          ? '<span class="flex h-4 w-4 flex-none items-center justify-center rounded-full bg-emerald-500 text-[9px] font-bold text-white">✓</span>'
          : "";
        const showTherapist = !therapistFilter;
        block.innerHTML = `
          <div class="flex items-center justify-between gap-1">
            <p class="min-w-0 truncate font-display text-xs font-bold ${nameColor}">${appointmentClientName(a)}</p>
            ${paidMark}
          </div>
          <p class="truncate text-[11px] text-charcoal-muted">${fmtTime(a.start_time)} – ${fmtTime(a.end_time)} · ${a.service ?? ""}${repeatMark(a)}${showTherapist ? ` · ${therapistName(a)}` : ""}</p>`;

        block.addEventListener("click", (ev) => {
          ev.stopPropagation();
          if (skipNextApptClick) {
            skipNextApptClick = false;
            return;
          }
          openDetail(a);
        });
        bindApptLongPressMove(block, a, rowEnd - rowStart);
        bindApptHoverPreview(block, a);
        bindApptContextMenu(block, a);
      }
      grid.appendChild(block);
    });

    positionNowLine();
  }

  // ── Long-press drag to move appointment (mobile + desktop) ──
  const LONG_PRESS_MS = 420;
  const PRESS_MOVE_CANCEL_PX = 14;
  let skipNextApptClick = false;
  let pressTimer: number | null = null;
  let pressPending: {
    appt: Appointment;
    el: HTMLButtonElement;
    pointerId: number;
    startX: number;
    startY: number;
    x: number;
    y: number;
    rowSpan: number;
  } | null = null;
  let activeDrag: {
    appt: Appointment;
    el: HTMLButtonElement;
    pointerId: number;
    rowSpan: number;
    durationMs: number;
    colIdx: number;
    row: number;
  } | null = null;

  function clearPressTimer() {
    if (pressTimer != null) {
      window.clearTimeout(pressTimer);
      pressTimer = null;
    }
  }

  function clientToGridCell(clientX: number, clientY: number) {
    const rect = grid.getBoundingClientRect();
    const x = clientX - rect.left;
    const y = clientY - rect.top;
    const cols = visibleTherapists();
    if (!cols.length || rect.width <= 0 || rect.height <= 0) {
      return null;
    }
    const colIdx = Math.min(
      cols.length - 1,
      Math.max(0, Math.floor((x / rect.width) * cols.length)),
    );
    const row = Math.min(
      TOTAL_ROWS - 1,
      Math.max(0, Math.floor((y / rect.height) * TOTAL_ROWS)),
    );
    return { colIdx, row, cols };
  }

  const hoverSlot = document.getElementById("cal-hover-slot")!;
  const hoverTime = document.getElementById("cal-hover-time")!;

  function canPreviewHover() {
    return window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  }

  function hideHoverSlot() {
    hoverSlot.classList.add("hidden");
  }

  function updateHoverSlot(e: MouseEvent) {
    if (
      !canPreviewHover() ||
      viewMode !== "day" ||
      activeDrag ||
      grid.dataset.dragging === "true"
    ) {
      hideHoverSlot();
      return;
    }
    if ((e.target as HTMLElement).closest("[data-appt]")) {
      hideHoverSlot();
      return;
    }
    const cell = clientToGridCell(e.clientX, e.clientY);
    if (!cell) {
      hideHoverSlot();
      return;
    }
    const minsFromStart = cell.row * SLOT_MINUTES;
    const hours = DAY_START + Math.floor(minsFromStart / 60);
    const minutes = minsFromStart % 60;
    if (hours < DAY_START || hours > DAY_END) {
      hideHoverSlot();
      return;
    }
    hoverTime.textContent = `${String(hours).padStart(2, "0")}:${String(minutes).padStart(2, "0")}`;
    hoverSlot.style.gridRow = `${cell.row + 1} / ${cell.row + 2}`;
    hoverSlot.style.gridColumn = String(cell.colIdx + 1);
    hoverSlot.classList.remove("hidden");
  }

  grid.addEventListener("mousemove", updateHoverSlot);
  grid.addEventListener("mouseleave", () => {
    hideHoverSlot();
    hideApptPreview();
  });

  const apptPreview = document.getElementById("cal-appt-preview")!;
  const previewHead = document.getElementById("cal-preview-head")!;
  const previewTime = document.getElementById("cal-preview-time")!;
  const previewStatus = document.getElementById("cal-preview-status")!;
  const previewAvatar = document.getElementById("cal-preview-avatar")!;
  const previewName = document.getElementById("cal-preview-name")!;
  const previewPhone = document.getElementById("cal-preview-phone")!;
  const previewService = document.getElementById("cal-preview-service")!;
  const previewMeta = document.getElementById("cal-preview-meta")!;
  const previewPrice = document.getElementById("cal-preview-price")!;
  let previewTimer: number | null = null;

  function previewHeadClass(accent: string): string {
    const base = "flex items-center justify-between px-3.5 py-2 ";
    switch (accent) {
      case "sky": return base + "bg-sky-600";
      case "teal": return base + "bg-teal-600";
      case "rose": return base + "bg-rose-600";
      case "amber": return base + "bg-amber-700";
      default: return base + "bg-spine";
    }
  }

  function hideApptPreview() {
    if (previewTimer != null) {
      window.clearTimeout(previewTimer);
      previewTimer = null;
    }
    apptPreview.classList.add("hidden");
  }

  function fillApptPreview(a: Appointment) {
    const th = getTherapist(a.therapist_id);
    previewHead.className = previewHeadClass(th?.accent ?? "spine");
    previewTime.textContent = `${fmtTime(a.start_time)} – ${fmtTime(a.end_time)}`;
    const mins = Math.max(1, Math.round((new Date(a.end_time).getTime() - new Date(a.start_time).getTime()) / 60_000));
    if (a.is_blocked_time) {
      previewStatus.textContent = "Κλειστό";
      const label = a.service || "Κλειστό";
      previewAvatar.textContent = "–";
      previewName.textContent = label;
      previewPhone.textContent = "";
      previewPhone.classList.add("hidden");
      previewService.textContent = "Αποκλεισμός ώρας";
      previewMeta.textContent = `${therapistName(a)} · ${mins}′${repeatMark(a)}`;
      previewPrice.textContent = "";
      return;
    }
    const name = appointmentClientName(a);
    previewStatus.textContent = a.is_paid ? "Πληρωμένο" : "Κλεισμένο";
    previewAvatar.textContent = initialsOf(name) || "?";
    previewName.textContent = name;
    if (a.patients?.phone) {
      previewPhone.textContent = a.patients.phone;
      previewPhone.classList.remove("hidden");
    } else {
      previewPhone.textContent = "";
      previewPhone.classList.add("hidden");
    }
    previewService.textContent = a.service ?? "";
    previewMeta.textContent = `${therapistName(a)} · ${mins}′${repeatMark(a)}`;
    const master = isMasterAccount(adminEmail);
    const showPay = canSeePayments(a) && (!a.payments_hidden || master);
    const payable = showPay ? payableAmount(a) : null;
    previewPrice.textContent = payable != null ? fmtEuro(payable) : "";
  }

  function placeApptPreview(anchor: HTMLElement) {
    apptPreview.classList.remove("hidden");
    const rect = anchor.getBoundingClientRect();
    const cardW = apptPreview.offsetWidth || 296;
    const cardH = apptPreview.offsetHeight || 140;
    let left = rect.left - cardW - 12;
    if (left < 8) left = rect.right + 12;
    if (left + cardW > window.innerWidth - 8) left = Math.max(8, window.innerWidth - cardW - 8);
    let top = rect.top;
    if (top + cardH > window.innerHeight - 8) top = Math.max(8, window.innerHeight - cardH - 8);
    apptPreview.style.left = `${left}px`;
    apptPreview.style.top = `${top}px`;
  }

  function bindApptHoverPreview(el: HTMLButtonElement, a: Appointment) {
    el.addEventListener("mouseenter", () => {
      if (!canPreviewHover() || activeDrag || grid.dataset.dragging === "true") return;
      hideHoverSlot();
      if (previewTimer != null) window.clearTimeout(previewTimer);
      previewTimer = window.setTimeout(() => {
        previewTimer = null;
        fillApptPreview(a);
        placeApptPreview(el);
      }, 160);
    });
    el.addEventListener("mouseleave", hideApptPreview);
  }

  const ctxMenu = document.getElementById("cal-ctx-menu")!;
  let ctxAppt: Appointment | null = null;

  function hideCtxMenu() {
    ctxMenu.classList.add("hidden");
  }

  function bindApptContextMenu(el: HTMLButtonElement, a: Appointment) {
    el.addEventListener("contextmenu", (e) => {
      if (!canPreviewHover()) return;
      e.preventDefault();
      e.stopPropagation();
      hideApptPreview();
      hideHoverSlot();
      ctxAppt = a;
      ctxMenu.classList.remove("hidden");
      const menuW = ctxMenu.offsetWidth || 200;
      const menuH = ctxMenu.offsetHeight || 48;
      let left = e.clientX;
      let top = e.clientY;
      if (left + menuW > window.innerWidth - 8) left = window.innerWidth - menuW - 8;
      if (top + menuH > window.innerHeight - 8) top = window.innerHeight - menuH - 8;
      ctxMenu.style.left = `${left}px`;
      ctxMenu.style.top = `${top}px`;
    });
  }

  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest("#cal-ctx-menu")) hideCtxMenu();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") hideCtxMenu();
  });
  document.getElementById("cal-scroll")?.addEventListener("scroll", () => {
    hideCtxMenu();
    hideApptPreview();
  });
  document.getElementById("cal-scroll")?.addEventListener("wheel", (e) => {
    const el = e.currentTarget as HTMLElement;
    const maxY = el.scrollHeight - el.clientHeight;
    if (Math.abs(e.deltaY) < Math.abs(e.deltaX)) return;
    const canScroll = maxY > 4;
    const atTop = el.scrollTop <= 0 && e.deltaY < 0;
    const atBottom = el.scrollTop >= maxY - 1 && e.deltaY > 0;
    if (canScroll && !atTop && !atBottom) return;
    const root = document.scrollingElement || document.documentElement;
    const maxPage = root.scrollHeight - root.clientHeight;
    if ((root.scrollTop <= 0 && e.deltaY < 0) || (root.scrollTop >= maxPage - 1 && e.deltaY > 0)) return;
    e.preventDefault();
    // Trackpads emit a burst of small deltas. scrollBy follows the page's smooth
    // scroll and keeps restarting that animation, so the day barely moves.
    const delta = e.deltaMode === 1 ? e.deltaY * 16
      : e.deltaMode === 2 ? e.deltaY * window.innerHeight
      : e.deltaY;
    root.style.scrollBehavior = "auto";
    root.scrollTop += delta;
  }, { passive: false });
  new ResizeObserver(() => {
    const scroll = document.getElementById("cal-scroll");
    if (!laidOutCols || !scroll || scroll.clientWidth === lastScrollW) return;
    setupDayColumns(laidOutCols);
  }).observe(document.getElementById("cal-scroll")!);

  function applyDragPreview(
    el: HTMLElement,
    row0: number,
    rowSpan: number,
    colIdx: number,
  ) {
    const maxStart = Math.max(1, TOTAL_ROWS - rowSpan + 1);
    const rowStart = Math.min(maxStart, Math.max(1, row0 + 1));
    const rowEnd = rowStart + rowSpan;
    el.style.gridRow = `${rowStart} / ${rowEnd}`;
    el.style.gridColumn = String(colIdx + 1);
    el.style.justifySelf = "start";
    el.style.width = "calc(100% - 4px)";
    el.style.marginLeft = "2px";
  }

  function beginApptDrag(
    appt: Appointment,
    el: HTMLButtonElement,
    pointerId: number,
    rowSpan: number,
    clientX: number,
    clientY: number,
  ) {
    const cell = clientToGridCell(clientX, clientY);
    if (!cell) return;
    const start = new Date(appt.start_time);
    const end = new Date(appt.end_time);
    activeDrag = {
      appt,
      el,
      pointerId,
      rowSpan,
      durationMs: Math.max(SLOT_MINUTES * 60_000, end.getTime() - start.getTime()),
      colIdx: cell.colIdx,
      row: cell.row,
    };
    el.dataset.dragging = "true";
    grid.dataset.dragging = "true";
    hideHoverSlot();
    hideApptPreview();
    hideCtxMenu();
    applyDragPreview(el, cell.row, rowSpan, cell.colIdx);
    try {
      el.setPointerCapture(pointerId);
    } catch {
      /* ignore */
    }
    if (typeof navigator !== "undefined" && "vibrate" in navigator) {
      try {
        navigator.vibrate(18);
      } catch {
        /* ignore */
      }
    }
  }

  function clockMinutes(d: Date): number {
    return d.getHours() * 60 + d.getMinutes();
  }

  /** Same calendar day as `iso`, with the clock from `clock`. */
  function onSameClock(iso: string, clock: Date): Date {
    const d = new Date(iso);
    d.setHours(clock.getHours(), clock.getMinutes(), 0, 0);
    return d;
  }

  async function seriesRowsForTimeChange(a: Appointment): Promise<{ id: string; start_time: string }[]> {
    if (a.repeats_forever) return [{ id: a.id, start_time: a.start_time }];
    if (a.recurrence_group) {
      const { data, error } = await supabase
        .from("appointments")
        .select("id, start_time")
        .eq("recurrence_group", a.recurrence_group)
        .neq("status", "cancelled");
      if (error) throw new Error(error.message);
      return (data ?? []) as { id: string; start_time: string }[];
    }
    const src = new Date(a.start_time);
    let q = supabase
      .from("appointments")
      .select("id, start_time")
      .eq("therapist_id", a.therapist_id ?? "")
      .eq("is_blocked_time", a.is_blocked_time)
      .neq("status", "cancelled");
    if (!a.is_blocked_time) q = q.eq("patient_id", a.patient_id ?? "");
    const { data, error } = await q;
    if (error) throw new Error(error.message);
    return ((data ?? []) as { id: string; start_time: string }[]).filter((row) => {
      const d = new Date(row.start_time);
      return d.getDay() === src.getDay()
        && d.getHours() === src.getHours()
        && d.getMinutes() === src.getMinutes();
    });
  }

  /** Sets the new clock on every date in the series. Returns applied=false for a single appointment. */
  async function applyClockToSeries(
    a: Appointment,
    newStart: Date,
    newEnd: Date,
  ): Promise<{ applied: boolean; error: string | null }> {
    const rows = await seriesRowsForTimeChange(a);
    if (rows.length <= 1) return { applied: false, error: null };
    const messages = await Promise.all(rows.map(async (row) => {
      const start = onSameClock(row.start_time, newStart);
      const end = onSameClock(row.start_time, newEnd);
      if (end <= start) end.setDate(end.getDate() + 1);
      const { error } = await supabase
        .from("appointments")
        .update({ start_time: start.toISOString(), end_time: end.toISOString() })
        .eq("id", row.id);
      return error?.message ?? null;
    }));
    return { applied: true, error: messages.find((msg) => msg) ?? null };
  }

  /** Editing a repeated visit must not leave a second copy on the same clock. */
  async function dropSameSlotCopies(a: Appointment, startIso: string) {
    if (!a.recurrence_group) return;
    const { data, error } = await supabase
      .from("appointments")
      .select("id, is_paid, notes")
      .eq("recurrence_group", a.recurrence_group)
      .eq("start_time", startIso)
      .neq("id", a.id)
      .neq("status", "cancelled");
    if (error || !data?.length) return;
    const extraIds = (data as { id: string; is_paid: boolean; notes: string | null }[])
      .filter((row) => !row.is_paid && !row.notes?.trim())
      .map((row) => row.id);
    if (!extraIds.length) return;
    await supabase.from("appointments").delete().in("id", extraIds);
  }

  async function finishApptDrag(clientX: number, clientY: number) {
    const drag = activeDrag;
    if (!drag) return;
    activeDrag = null;
    drag.el.dataset.dragging = "";
    delete grid.dataset.dragging;
    try {
      drag.el.releasePointerCapture(drag.pointerId);
    } catch {
      /* ignore */
    }

    const cell = clientToGridCell(clientX, clientY) ?? {
      colIdx: drag.colIdx,
      row: drag.row,
      cols: visibleTherapists(),
    };
    const maxStartRow0 = Math.max(0, TOTAL_ROWS - drag.rowSpan);
    const row0 = Math.min(maxStartRow0, Math.max(0, cell.row));
    const therapistId = cell.cols[cell.colIdx]?.id ?? drag.appt.therapist_id;
    const lockedTherapist = lockedTherapistIdForAdminService(drag.appt.service ?? "");
    if (lockedTherapist && therapistId !== lockedTherapist) {
      alert("Η οστεοπαθητική μένει μόνο στον Χαράλαμπο.");
      refresh();
      return;
    }

    const dropped = new Date(currentDay);
    dropped.setHours(DAY_START, 0, 0, 0);
    dropped.setMinutes(dropped.getMinutes() + row0 * SLOT_MINUTES);
    const newStart = new Date(drag.appt.repeats_forever ? drag.appt.start_time : currentDay);
    newStart.setHours(dropped.getHours(), dropped.getMinutes(), 0, 0);
    const newEnd = new Date(newStart.getTime() + drag.durationMs);

    const sameTime =
      newStart.toISOString() === drag.appt.start_time &&
      newEnd.toISOString() === drag.appt.end_time;
    const sameTherapist = therapistId === drag.appt.therapist_id;
    if (sameTime && sameTherapist) {
      refresh();
      return;
    }

    skipNextApptClick = true;
    const { error } = await supabase
      .from("appointments")
      .update({
        start_time: newStart.toISOString(),
        end_time: newEnd.toISOString(),
        therapist_id: therapistId,
      })
      .eq("id", drag.appt.id);

    if (error) {
      alert(`Αποτυχία μετακίνησης: ${error.message}`);
    }
    refresh();
  }

  function cancelApptDrag() {
    if (!activeDrag) return;
    const el = activeDrag.el;
    activeDrag = null;
    el.dataset.dragging = "";
    delete grid.dataset.dragging;
    skipNextApptClick = true;
    refresh();
  }

  function bindApptLongPressMove(
    el: HTMLButtonElement,
    appt: Appointment,
    rowSpan: number,
  ) {
    el.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse" && e.button !== 0) return;
      clearPressTimer();
      pressPending = {
        appt,
        el,
        pointerId: e.pointerId,
        startX: e.clientX,
        startY: e.clientY,
        x: e.clientX,
        y: e.clientY,
        rowSpan: Math.max(1, rowSpan),
      };
      pressTimer = window.setTimeout(() => {
        const p = pressPending;
        pressPending = null;
        pressTimer = null;
        if (!p) return;
        beginApptDrag(p.appt, p.el, p.pointerId, p.rowSpan, p.x, p.y);
      }, LONG_PRESS_MS);
    });

    el.addEventListener("pointermove", (e) => {
      if (pressPending && pressPending.pointerId === e.pointerId) {
        pressPending.x = e.clientX;
        pressPending.y = e.clientY;
        const dx = e.clientX - pressPending.startX;
        const dy = e.clientY - pressPending.startY;
        if (Math.hypot(dx, dy) > PRESS_MOVE_CANCEL_PX) {
          clearPressTimer();
          pressPending = null;
        }
      }
      if (activeDrag && activeDrag.pointerId === e.pointerId) {
        e.preventDefault();
        const cell = clientToGridCell(e.clientX, e.clientY);
        if (!cell) return;
        activeDrag.colIdx = cell.colIdx;
        activeDrag.row = cell.row;
        applyDragPreview(activeDrag.el, cell.row, activeDrag.rowSpan, cell.colIdx);
      }
    });

    el.addEventListener("pointerup", (e) => {
      if (pressPending && pressPending.pointerId === e.pointerId) {
        clearPressTimer();
        pressPending = null;
      }
      if (activeDrag && activeDrag.pointerId === e.pointerId) {
        e.preventDefault();
        void finishApptDrag(e.clientX, e.clientY);
      }
    });

    el.addEventListener("pointercancel", (e) => {
      if (pressPending && pressPending.pointerId === e.pointerId) {
        clearPressTimer();
        pressPending = null;
      }
      if (activeDrag && activeDrag.pointerId === e.pointerId) {
        cancelApptDrag();
      }
    });

    el.addEventListener("contextmenu", (e) => {
      // Avoid iOS/Android callout while long-pressing to drag
      if (activeDrag || pressPending) e.preventDefault();
    });
  }

  function positionNowLine() {
    const now = new Date();
    const isToday = now.toDateString() === currentDay.toDateString();
    const mins = (now.getHours() - DAY_START) * 60 + now.getMinutes();
    const totalMins = TOTAL_ROWS * SLOT_MINUTES;
    if (!isToday || mins < 0 || mins > totalMins) {
      nowLine.classList.add("hidden");
      return;
    }
    nowLine.style.top = `${(mins / totalMins) * 100}%`;
    nowLine.classList.remove("hidden");
  }
  setInterval(positionNowLine, 60_000);

