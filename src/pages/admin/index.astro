        <div id="block-repeat-opts" class="hidden grid-cols-2 gap-3">
          <div id="block-repeat-interval-wrap" class="hidden">
            <label class="mb-1 block text-sm font-medium text-charcoal" for="block-repeat-interval">Κάθε πόσες εβδομάδες</label>
