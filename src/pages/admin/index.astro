  function syncTherapistOptions(select: HTMLSelectElement, service: string, note?: HTMLElement) {
    const locked = lockedTherapistIdForAdminService(service);
    for (const opt of Array.from(select.options)) {
      const off = !!locked && opt.value !== locked;
      opt.hidden = off;
      opt.disabled = off;
