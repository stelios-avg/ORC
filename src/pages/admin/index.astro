    return d.getTime() === today.getTime() ? `Σήμερα · ${label}` : label;
  };

  /** minutes since DAY_START → fine grid row (1-based), clamped to the grid
   *  so appointments beyond DAY_END never overflow the layout */
  const toRow = (date: Date) => {
    const mins = (date.getHours() - DAY_START) * 60 + date.getMinutes();
    const row = Math.round(mins / SLOT_MINUTES) + 1;
    return Math.min(TOTAL_ROWS + 1, Math.max(1, row));
  };

  const startOfMonth = (d: Date) => new Date(d.getFullYear(), d.getMonth(), 1);
  const sameDay = (a: Date, b: Date) => a.toDateString() === b.toDateString();

  /** Standing weekly visit: the one saved row also appears on later matching weekdays. */
  function occursOn(a: Appointment, day: Date): boolean {
    const start = new Date(a.start_time);
    if (sameDay(start, day)) return true;
    if (!a.repeats_forever) return false;
    const origin = new Date(start);
    origin.setHours(0, 0, 0, 0);
    const target = new Date(day);
    target.setHours(0, 0, 0, 0);
    if (target < origin) return false;
    return start.getDay() === target.getDay();
  }

  async function fetchForeverAppointments(before: Date): Promise<Appointment[]> {
    let q = supabase
      .from("appointments")
      .select(APPT_SELECT)
      .eq("repeats_forever", true)
      .neq("status", "cancelled")
      .lt("start_time", before.toISOString());
    if (therapistFilter) q = q.eq("therapist_id", therapistFilter);
    else q = q.neq("therapist_id", pilatesId);
    const { data, error } = await q;
    if (error) throw new Error(error.message);
    return (data ?? []) as Appointment[];
  }

