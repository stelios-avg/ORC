            <label class="mb-1 block text-sm font-medium text-charcoal" for="block-repeat-count">Σύνολο επαναλήψεων</label>
            <input id="block-repeat-count" name="repeat_count" type="number" min="2" max="52" value="4" inputmode="numeric"
