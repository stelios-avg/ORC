  document.getElementById("cal-next")!.addEventListener("click", () => shiftCalendar(1));

  /**
   * Phone swipe changes the day on the date bar.
   * On the calendar it does so only at the horizontal edge: last column → next day, first column → previous day.
   */
  function bindCalendarSwipe(el: HTMLElement, atColumnEdge: boolean) {
    const scroller = document.getElementById("cal-scroll");
    let startX = 0;
    let startY = 0;
    let startScroll = 0;
    let tracking = false;
    el.addEventListener("touchstart", (e) => {
      if (!isNarrow() || e.touches.length !== 1) {
        tracking = false;
        return;
      }
      tracking = true;
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      startScroll = scroller?.scrollLeft ?? 0;
    }, { passive: true });
    el.addEventListener("touchend", (e) => {
      if (!tracking) return;
      tracking = false;
      if (activeDrag) return;
      const t = e.changedTouches[0];
      const dx = t.clientX - startX;
      const dy = t.clientY - startY;
      if (Math.abs(dx) < 64 || Math.abs(dx) < Math.abs(dy) * 1.4) return;
      if (atColumnEdge && viewMode === "day" && scroller) {
        const max = scroller.scrollWidth - scroller.clientWidth;
        if (Math.abs(scroller.scrollLeft - startScroll) > 6) return;
        if (dx < 0 && scroller.scrollLeft < max - 4) return;
        if (dx > 0 && scroller.scrollLeft > 4) return;
      }
      shiftCalendar(dx < 0 ? 1 : -1);
    }, { passive: true });
  }
  bindCalendarSwipe(document.getElementById("cal-date-nav")!, false);
  bindCalendarSwipe(document.getElementById("cal-scroll")!, true);
