        <h2 id="repeat-modal-title" class="font-display text-lg font-bold text-charcoal">Επανάληψη</h2>
        <button data-close-modal type="button" class="rounded-full p-2 text-charcoal-muted transition hover:bg-slate-100" aria-label="Κλείσιμο">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
