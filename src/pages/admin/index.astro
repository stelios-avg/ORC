  /** Charalambos only sees osteopathy. Everyone else does not. */
  function syncServiceOptions(select: HTMLSelectElement, therapistId: string, replaceDisallowed: boolean) {
    const onlyOsteo = therapistId === charalambosId;
    let firstAllowed = "";
    const current = select.value;
    for (const opt of Array.from(select.options)) {
      const osteo = !!lockedTherapistIdForAdminService(opt.value);
      const allowed = onlyOsteo ? osteo : !osteo;
      const keep = !replaceDisallowed && opt.value === current;
      opt.hidden = !allowed && !keep;
      opt.disabled = !allowed && !keep;
      if (allowed && !firstAllowed) firstAllowed = opt.value;
    }
    if (replaceDisallowed && select.selectedOptions[0]?.disabled && firstAllowed) {
      select.value = firstAllowed;
    }
  }

