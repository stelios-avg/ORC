  function shiftCalendar(dir: number) {
    if (viewMode === "day") {
      currentDay.setDate(currentDay.getDate() + dir);
    } else {
      viewMonth = new Date(viewMonth.getFullYear(), viewMonth.getMonth() + dir, 1);
