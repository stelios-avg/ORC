            <option value="monthly">Κάθε μήνα</option>
            <option value="custom">Προσαρμοσμένη</option>
          </select>
        </div>
        <div id="ctx-repeat-opts" class="grid grid-cols-2 gap-3">
          <div id="ctx-repeat-interval-wrap" class="hidden">
