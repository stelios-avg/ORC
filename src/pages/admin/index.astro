  function styleWalkInButton(on: boolean) {
    walkinBtn.setAttribute("aria-pressed", on ? "true" : "false");
    walkinBtn.classList.toggle("bg-spine", on);
    walkinBtn.classList.toggle("text-white", on);
    walkinBtn.classList.toggle("ring-spine", on);
    walkinBtn.classList.toggle("bg-white", !on);
    walkinBtn.classList.toggle("text-charcoal", !on);
    walkinBtn.classList.toggle("ring-slate-300", !on);
  }

  function setWalkInMode(on: boolean) {
    walkInMode = on;
    styleWalkInButton(on);
    patientSearch.disabled = on;
    patientSearch.classList.toggle("bg-sand", on);
    if (on) {
      forceNewPatient = false;
      patientIdInput.value = "";
      patientSearch.value = "";
      newPatientPhone.value = "";
      newPatientEmail.value = "";
      patientResults.classList.add("hidden");
      patientResults.innerHTML = "";
      newPatientFields.classList.add("hidden");
      patientSelected.textContent = "Walk-in · χωρίς καρτέλα πελάτη";
      patientSelected.classList.remove("hidden");
      document.getElementById("appt-patient-hint")!.classList.add("hidden");
    } else {
      patientSearch.disabled = false;
      patientSearch.classList.remove("bg-sand");
      document.getElementById("appt-patient-hint")!.classList.remove("hidden");
      if (!patientIdInput.value) {
        patientSelected.textContent = "";
        patientSelected.classList.add("hidden");
      }
    }
  }

  walkinBtn.addEventListener("click", () => setWalkInMode(!walkInMode));

  function digitsOnly(s: string) {
    return s.replace(/\D/g, "");
  }

  function syncNewPatientFields() {
    const creating = !walkInMode && !patientIdInput.value;
    newPatientFields.classList.toggle("hidden", !creating);
  }

  function resetPatientPicker() {
    forceNewPatient = false;
    walkInMode = false;
    styleWalkInButton(false);
    patientSearch.disabled = false;
    patientSearch.classList.remove("bg-sand");
    document.getElementById("appt-patient-hint")!.classList.remove("hidden");
    patientIdInput.value = "";
    patientSearch.value = "";
    newPatientPhone.value = "";
    newPatientEmail.value = "";
    patientSelected.textContent = "";
    patientSelected.classList.add("hidden");
    patientResults.classList.add("hidden");
    patientResults.innerHTML = "";
    syncNewPatientFields();
  }

  function selectPatient(p: Patient) {
    forceNewPatient = false;
    if (walkInMode) setWalkInMode(false);
    patientIdInput.value = p.id;
    patientSearch.value = p.name;
    newPatientPhone.value = "";
    newPatientEmail.value = "";
    patientSelected.textContent = p.phone ? `${p.name} · ${p.phone}` : p.name;
    patientSelected.classList.remove("hidden");
    patientResults.classList.add("hidden");
    patientResults.innerHTML = "";
    syncNewPatientFields();
  }

  function selectNewPatient(name: string) {
    forceNewPatient = true;
    patientIdInput.value = "";
    patientSearch.value = name;
    patientSelected.textContent = `Νέος πελάτης · ${name}`;
    patientSelected.classList.remove("hidden");
    patientResults.classList.add("hidden");
    patientResults.innerHTML = "";
    syncNewPatientFields();
    window.setTimeout(() => newPatientPhone.focus(), 40);
  }

  function renderPatientResults(matches: Patient[]) {
    const typed = patientSearch.value.trim();
    const newRow =
      typed.length >= 2
        ? `<button type="button" data-new-patient
            class="flex w-full flex-col items-start gap-0.5 border-b border-slate-100 px-3 py-2.5 text-left transition hover:bg-spine-50">
            <span class="font-display text-sm font-semibold text-spine">Νέος πελάτης</span>
            <span class="text-xs text-charcoal-muted">${typed}</span>
          </button>`
        : "";
    const rows = matches
      .slice(0, 12)
      .map(
        (p) => `
      <button type="button" data-patient-id="${p.id}"
        class="flex w-full flex-col items-start gap-0.5 px-3 py-2.5 text-left transition hover:bg-spine-50">
        <span class="font-display text-sm font-semibold text-charcoal">${p.name}</span>
        <span class="text-xs text-charcoal-muted">${p.phone || "χωρίς τηλέφωνο"}${p.email ? ` · ${p.email}` : ""}</span>
      </button>`,
      )
      .join("");
    if (!newRow && !rows) {
      patientResults.innerHTML =
        '<p class="px-3 py-2 text-sm text-charcoal-muted">Κανένα αποτέλεσμα</p>';
    } else {
      patientResults.innerHTML = newRow + rows;
    }
    patientResults.classList.remove("hidden");
  }

  function filterPatients(q: string): Patient[] {
    const raw = q.trim().toLowerCase();
    if (!raw) return [];
    const dig = digitsOnly(raw);
    return patients.filter((p) => {
      if (p.name.toLowerCase().includes(raw)) return true;
      if (p.email?.toLowerCase().includes(raw)) return true;
      if (dig.length >= 3 && digitsOnly(p.phone ?? "").includes(dig)) return true;
      if ((p.phone ?? "").toLowerCase().includes(raw)) return true;
      return false;
    });
  }

  patientSearch.addEventListener("input", () => {
    // Typing clears a previous selection until they pick again.
    forceNewPatient = false;
    patientIdInput.value = "";
    patientSelected.classList.add("hidden");
    syncNewPatientFields();
    const matches = filterPatients(patientSearch.value);
    if (!patientSearch.value.trim()) {
      patientResults.classList.add("hidden");
      patientResults.innerHTML = "";
      return;
    }
    renderPatientResults(matches);
  });

  patientSearch.addEventListener("focus", () => {
    if (patientSearch.value.trim() && !patientIdInput.value) {
      renderPatientResults(filterPatients(patientSearch.value));
    }
  });

  patientResults.addEventListener("click", (e) => {
    const newBtn = (e.target as HTMLElement).closest<HTMLElement>("[data-new-patient]");
    if (newBtn) {
      selectNewPatient(patientSearch.value.trim());
      return;
    }
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-patient-id]");
    if (!btn) return;
    const p = patients.find((x) => x.id === btn.dataset.patientId);
    if (p) selectPatient(p);
  });

  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (!t.closest("#appt-patient-search") && !t.closest("#appt-patient-results")) {
      patientResults.classList.add("hidden");
    }
  });

  async function openNewAppointment(opts?: {
    therapistId?: string | null;
    hours?: number;
    minutes?: number;
  }) {
    // Always refetch so clients added on /admin/clients show up without a reload.
    try {
      patients = await fetchAllPatients(supabase);
    } catch {
      /* keep the last in-memory list */
    }
    resetPatientPicker();
    await ensureAdminEmail();
    walkinBtn.hidden = !isMasterAccount(adminEmail);
    setDefaultTherapistSelects();
    apptDiscountInput.value = "0";
    resetRepeatControls();
    if (opts?.therapistId) apptTherapistSelect.value = opts.therapistId;
    syncNewApptForTherapist();
    const startInput = document.getElementById("appt-start") as HTMLInputElement;
    if (opts?.hours != null) {
      const hh = String(opts.hours).padStart(2, "0");
      const mm = String(opts.minutes ?? 0).padStart(2, "0");
      startInput.value = `${hh}:${mm}`;
    }
    openModal(apptModal);
    // Focus search for quick typing on mobile
    window.setTimeout(() => patientSearch.focus(), 50);
  }

  document.getElementById("add-appt-btn")!.addEventListener("click", () => {
    void openNewAppointment();
  });
  document.getElementById("fab-appt")!.addEventListener("click", () => {
    void openNewAppointment();
  });

  /** Tap empty calendar cell → new appointment at that time (and column therapist). */
  grid.addEventListener("click", (e) => {
    if (viewMode !== "day") return;
    if (grid.dataset.dragging === "true" || activeDrag) return;
    const target = e.target as HTMLElement;
    if (target.closest("[data-appt]")) return;

    const rect = grid.getBoundingClientRect();
    if (rect.width <= 0 || rect.height <= 0) return;
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    if (x < 0 || y < 0 || x > rect.width || y > rect.height) return;

    const cols = visibleTherapists();
    if (!cols.length) return;
    const colIdx = Math.min(cols.length - 1, Math.max(0, Math.floor((x / rect.width) * cols.length)));
    const row = Math.min(TOTAL_ROWS - 1, Math.max(0, Math.floor((y / rect.height) * TOTAL_ROWS)));
    const row1 = row + 1;
    const existing = [...grid.querySelectorAll<HTMLElement>("[data-appt]:not(.pointer-events-none)")].find((el) => {
      if (Number(el.style.gridColumn) !== colIdx + 1) return false;
      const [start, end] = el.style.gridRow.split("/").map((part) => Number(part.trim()));
      return !!start && !!end && row1 >= start && row1 < end;
    });
    if (existing) {
      existing.click();
      return;
    }
    const minsFromStart = row * SLOT_MINUTES;
    const hours = DAY_START + Math.floor(minsFromStart / 60);
    const minutes = minsFromStart % 60;
    if (hours < DAY_START || hours > DAY_END) return;

    void openNewAppointment({
      therapistId: cols[colIdx]?.id,
      hours,
      minutes,
    });
  });

  document.getElementById("appt-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const submitBtn = form.querySelector("button[type=submit]") as HTMLButtonElement | null;
    if (submitBtn?.disabled) return;
    if (submitBtn) submitBtn.disabled = true;
    try {
    const fd = new FormData(form);
    const err = document.getElementById("appt-form-error")!;
    err.classList.add("hidden");

    let patientId = String(fd.get("patient_id") || "").trim();
    if (walkInMode) {
      await ensureAdminEmail();
      if (!isMasterAccount(adminEmail)) {
        err.textContent = "Το Walk-in είναι μόνο για τους super admins.";
        err.classList.remove("hidden");
        return;
      }
      patientId = "";
    } else if (!patientId) {
      const newName = patientSearch.value.trim();
      if (newName.length < 2) {
        err.textContent = "Γράψτε το όνομα του πελάτη ή επιλέξτε από τη λίστα.";
        err.classList.remove("hidden");
        patientSearch.focus();
        return;
      }
      if (!forceNewPatient) {
        const exact = patients.filter(
          (p) => p.name.trim().toLowerCase() === newName.toLowerCase(),
        );
        if (exact.length === 1) {
          patientId = exact[0].id;
        }
      }
      if (!patientId) {
        try {
          const created = await createPatient(supabase, {
            name: newName,
            phone: newPatientPhone.value,
            email: newPatientEmail.value,
          });
          patients = [created, ...patients.filter((p) => p.id !== created.id)];
          patientId = created.id;
        } catch (createErr) {
          err.textContent =
            createErr instanceof Error ? createErr.message : String(createErr);
          err.classList.remove("hidden");
          return;
        }
      }
    }

    const [h, m] = String(fd.get("start")).split(":").map(Number);
    const start = new Date(currentDay); start.setHours(h, m, 0, 0);
    const durationMs = Number(fd.get("duration")) * 60_000;

    const priceRaw = String(fd.get("price") ?? "").trim();
    const discountRaw = String(fd.get("discount") ?? "").trim();
    const price = priceRaw === "" ? null : Number(priceRaw);
    const discount = discountRaw === "" ? 0 : Number(discountRaw);
    if (priceRaw !== "" && (price == null || Number.isNaN(price) || price < 0)) {
      err.textContent = "Μη έγκυρη τιμή.";
      err.classList.remove("hidden");
      return;
    }
    if (Number.isNaN(discount) || discount < 0) {
      err.textContent = "Μη έγκυρη έκπτωση.";
      err.classList.remove("hidden");
      return;
    }

    // One row per occurrence; recurring series share a recurrence_group id.
    const occurrences = foreverOn
      ? [start]
      : buildOccurrences(
          start,
          repeatSelect.value,
          Number(repeatCountInput.value),
          Number(repeatIntervalInput.value),
        );
    const recurrenceGroup = occurrences.length > 1 ? crypto.randomUUID() : null;
    const serviceName = String(fd.get("service"));
    const lockedTherapist = lockedTherapistIdForAdminService(serviceName);
    const rows = occurrences.map((s) => ({
      patient_id: patientId || null,
      therapist_id: lockedTherapist ?? String(fd.get("therapist_id")),
      service: serviceName,
      start_time: s.toISOString(),
      end_time: new Date(s.getTime() + durationMs).toISOString(),
      price,
      discount,
      recurrence_group: recurrenceGroup,
      repeats_forever: foreverOn,
    }));

    const { error } = await supabase.from("appointments").insert(rows);

    if (error) {
      err.textContent = error.message;
      err.classList.remove("hidden");
      return;
    }
    form.reset();
    resetPatientPicker();
    apptDiscountInput.value = "0";
    setDefaultTherapistSelects();
    syncNewApptForTherapist();
    resetRepeatControls();
    closeModal(apptModal);
    refresh();
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });

  // ── Block time ──
  document.getElementById("block-time-btn")!.addEventListener("click", () => {
    setDefaultTherapistSelects();
    resetBlockRepeatControls();
    openModal(blockModal);
  });

  document.getElementById("block-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const fd = new FormData(form);
    const err = document.getElementById("block-form-error")!;
    err.classList.add("hidden");

    const [sh, sm] = String(fd.get("start")).split(":").map(Number);
    const [eh, em] = String(fd.get("end")).split(":").map(Number);
    const start = new Date(currentDay); start.setHours(sh, sm, 0, 0);
    const end = new Date(currentDay); end.setHours(eh, em, 0, 0);

    if (end <= start) {
      err.textContent = "Η ώρα λήξης πρέπει να είναι μετά την έναρξη.";
      err.classList.remove("hidden");
      return;
    }

    const durationMs = end.getTime() - start.getTime();
    const occurrences = buildOccurrences(
      start,
      blockRepeatSelect.value,
      Number(blockRepeatCountInput.value),
      Number(blockRepeatIntervalInput.value),
    );
    const recurrenceGroup = occurrences.length > 1 ? crypto.randomUUID() : null;
    const rows = occurrences.map((s) => ({
      is_blocked_time: true,
      therapist_id: String(fd.get("therapist_id")),
      service: String(fd.get("reason") || "Κλειστό"),
      start_time: s.toISOString(),
      end_time: new Date(s.getTime() + durationMs).toISOString(),
      recurrence_group: recurrenceGroup,
    }));

    const { error } = await supabase.from("appointments").insert(rows);

    if (error) {
      err.textContent = error.message;
      err.classList.remove("hidden");
      return;
    }
    form.reset();
    setDefaultTherapistSelects();
    resetBlockRepeatControls();
    closeModal(blockModal);
    refresh();
  });

  const ctxRepeatSelect = document.getElementById("ctx-repeat") as HTMLSelectElement;
  const ctxRepeatIntervalWrap = document.getElementById("ctx-repeat-interval-wrap")!;
  const ctxRepeatIntervalInput = document.getElementById("ctx-repeat-interval") as HTMLInputElement;
  const ctxRepeatCountWrap = document.getElementById("ctx-repeat-count-wrap")!;
  const ctxRepeatCountInput = document.getElementById("ctx-repeat-count") as HTMLInputElement;

  function syncCtxRepeatControls() {
    ctxRepeatIntervalWrap.classList.toggle("hidden", ctxRepeatSelect.value !== "custom");
  }
  ctxRepeatSelect.addEventListener("change", syncCtxRepeatControls);

  function openRepeatFor(a: Appointment) {
    ctxAppt = a;
    hideCtxMenu();
    hideApptPreview();
    document.getElementById("repeat-form-error")!.classList.add("hidden");
    ctxRepeatSelect.value = "weekly";
    ctxRepeatIntervalInput.value = "2";
    ctxRepeatCountInput.value = "4";
    syncCtxRepeatControls();
    document.getElementById("repeat-modal-title")!.textContent = a.is_blocked_time
      ? "Επανάληψη αποκλεισμού"
      : "Επανάληψη ραντεβού";
    document.getElementById("repeat-open-detail")!.classList.toggle("hidden", !a.is_blocked_time);
    openModal(repeatModal);
  }

  document.getElementById("cal-ctx-repeat")!.addEventListener("click", () => {
    if (ctxAppt) openRepeatFor(ctxAppt);
  });
  document.getElementById("detail-repeat")!.addEventListener("click", () => {
    if (selectedAppt) openRepeatFor(selectedAppt);
  });
  document.getElementById("repeat-open-detail")!.addEventListener("click", () => {
    const a = ctxAppt;
    if (!a) return;
    closeModal(repeatModal);
    openDetail(a);
  });

  document.getElementById("repeat-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    const source = ctxAppt;
    if (!source) return;
    const err = document.getElementById("repeat-form-error")!;
    err.classList.add("hidden");
    const btn = (e.target as HTMLFormElement).querySelector("button[type=submit]") as HTMLButtonElement;
    if (btn.disabled) return;
    const extra = Math.min(51, Math.max(1, Number(ctxRepeatCountInput.value) || 1));
    const dates = buildOccurrences(
      new Date(source.start_time),
      ctxRepeatSelect.value,
      extra + 1,
      Number(ctxRepeatIntervalInput.value),
    ).slice(1);
    if (!dates.length) {
      err.textContent = "Δεν προέκυψαν επαναλήψεις.";
      err.classList.remove("hidden");
      return;
    }

    btn.disabled = true;
    const durationMs = new Date(source.end_time).getTime() - new Date(source.start_time).getTime();
    const from = dates[0];
    const until = new Date(dates[dates.length - 1].getTime() + durationMs);
    let takenQ = supabase
      .from("appointments")
      .select("start_time")
      .eq("therapist_id", source.therapist_id ?? "")
      .eq("is_blocked_time", source.is_blocked_time)
      .neq("status", "cancelled")
      .gte("start_time", from.toISOString())
      .lte("start_time", until.toISOString());
    if (!source.is_blocked_time) takenQ = takenQ.eq("patient_id", source.patient_id ?? "");
    const { data: takenRows, error: takenError } = await takenQ;
    if (takenError) {
      btn.disabled = false;
      err.textContent = takenError.message;
      err.classList.remove("hidden");
      return;
    }
    const taken = new Set(
      ((takenRows ?? []) as { start_time: string }[]).map((row) => new Date(row.start_time).getTime()),
    );
    const fresh = dates.filter((d) => !taken.has(d.getTime()));
    if (!fresh.length) {
      btn.disabled = false;
      err.textContent = "Υπάρχει ήδη ραντεβού σε αυτές τις ώρες. Μένει ένα.";
      err.classList.remove("hidden");
      return;
    }

    const recurrenceGroup = source.recurrence_group ?? crypto.randomUUID();
    const rows = fresh.map((s) => {
      const row: Record<string, unknown> = {
        therapist_id: source.therapist_id,
        service: source.service,
        start_time: s.toISOString(),
        end_time: new Date(s.getTime() + durationMs).toISOString(),
        is_blocked_time: source.is_blocked_time,
        recurrence_group: recurrenceGroup,
      };
      if (!source.is_blocked_time) {
        row.patient_id = source.patient_id;
        row.price = source.price;
        row.discount = source.discount ?? 0;
      }
      return row;
    });

    if (!source.recurrence_group) {
      await supabase.from("appointments").update({ recurrence_group: recurrenceGroup }).eq("id", source.id);
      source.recurrence_group = recurrenceGroup;
    }
    const { error } = await supabase.from("appointments").insert(rows);
    btn.disabled = false;
    if (error) {
      err.textContent = error.message;
      err.classList.remove("hidden");
      return;
    }
    closeModal(repeatModal);
    if (selectedAppt?.id === source.id) openDetail(source);
    refresh();
  });

  // ── Pricing helpers (fixed EUR discount, not %) ──
  function payableAmount(a: Pick<Appointment, "price" | "discount">): number | null {
    if (a.price == null || Number.isNaN(Number(a.price))) return null;
    return Math.max(0, Number(a.price) - Number(a.discount ?? 0));
  }

  function fmtEuro(n: number): string {
    return n.toLocaleString("el-GR", { style: "currency", currency: "EUR" });
  }

  function parseMoneyInput(el: HTMLInputElement): number | null {
    const raw = el.value.trim();
    if (raw === "") return null;
    const n = Number(raw.replace(",", "."));
    if (!Number.isFinite(n) || n < 0) return null;
    return Math.round(n * 100) / 100;
  }

  // ── Detail sheet + paid toggle + delete ──
  const paidToggle = document.getElementById("paid-toggle")!;
  const hidePaymentBtn = document.getElementById("detail-hide-payment") as HTMLButtonElement;
  const priceInput = document.getElementById("detail-price") as HTMLInputElement;
  const discountInput = document.getElementById("detail-discount") as HTMLInputElement;
  const payableEl = document.getElementById("detail-payable")!;
  const priceSaveBtn = document.getElementById("detail-price-save") as HTMLButtonElement;

  function updatePayablePreview() {
    const price = parseMoneyInput(priceInput);
    const discount = parseMoneyInput(discountInput) ?? 0;
    if (price == null) {
      payableEl.textContent = "—";
      return;
    }
    payableEl.textContent = fmtEuro(Math.max(0, price - discount));
  }

  priceInput.addEventListener("input", updatePayablePreview);
  discountInput.addEventListener("input", updatePayablePreview);

  const detailTherapistSelect = document.getElementById("detail-therapist") as HTMLSelectElement;
  const detailTherapistRow = document.getElementById("detail-therapist-row")!;
  const detailStartInput = document.getElementById("detail-start") as HTMLInputElement;
  const detailEndInput = document.getElementById("detail-end") as HTMLInputElement;
  const detailServiceSelect = document.getElementById("detail-service-select") as HTMLSelectElement;
  const detailServiceEditWrap = document.getElementById("detail-service-edit-wrap")!;
  const detailScheduleSaveBtn = document.getElementById("detail-schedule-save") as HTMLButtonElement;

  function toTimeInputValue(iso: string): string {
    const d = new Date(iso);
    return `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
  }

  function ensureServiceOption(value: string) {
    const v = value.trim();
    if (!v) return;
    const exists = Array.from(detailServiceSelect.options).some((o) => o.value === v);
    if (!exists) {
      const opt = document.createElement("option");
      opt.value = v;
      opt.textContent = v;
      detailServiceSelect.appendChild(opt);
    }
    detailServiceSelect.value = v;
  }

  function openDetail(a: Appointment) {
    hideApptPreview();
    hideCtxMenu();
    selectedAppt = a;
    const detailTitle = document.getElementById("detail-title")!;
    if (!a.is_blocked_time && a.patient_id) {
      // Name links to the client profile (files, notes, history)
      detailTitle.innerHTML =
        `<a href="/admin/client?id=${a.patient_id}" ` +
        `class="underline decoration-spine/40 underline-offset-4 transition hover:text-spine">` +
        `${escHtml(a.patients?.name ?? "Ραντεβού")}</a>`;
    } else {
      detailTitle.textContent = a.is_blocked_time ? (a.service || "Κλειστό") : "Walk-in";
    }

    detailStartInput.value = toTimeInputValue(a.start_time);
    detailEndInput.value = toTimeInputValue(a.end_time);
    document.getElementById("detail-series-time-note")!.classList.toggle("hidden", !a.recurrence_group);
    document.getElementById("detail-forever-note")!.classList.toggle("hidden", !a.repeats_forever);
    detailServiceEditWrap.classList.toggle("hidden", a.is_blocked_time);
    if (!a.is_blocked_time) {
      ensureServiceOption(a.service ?? ADMIN_SERVICES[0]?.label ?? "");
    }

    detailTherapistRow.classList.remove("hidden");
    detailTherapistSelect.value = a.therapist_id ?? DEFAULT_THERAPIST_ID;
    syncDetailTherapistLock(a.service ?? "");
    if (!a.is_blocked_time) {
      syncServiceOptions(detailServiceSelect, detailTherapistSelect.value, false);
    }

    const phoneEl = document.getElementById("detail-phone") as HTMLAnchorElement;
    if (!a.is_blocked_time && a.patients?.phone) {
      phoneEl.textContent = a.patients.phone;
      phoneEl.href = `tel:${a.patients.phone}`;
      phoneEl.classList.remove("hidden");
    } else {
      phoneEl.classList.add("hidden");
    }

    const notesRow = document.getElementById("detail-notes-row")!;
    const hasNotes = !a.is_blocked_time && !!a.notes?.trim();
    notesRow.classList.toggle("hidden", !hasNotes);
    if (hasNotes) document.getElementById("detail-notes")!.textContent = a.notes!.trim();

    const hideMoney = a.is_blocked_time || !canSeePayments(a);
    document.getElementById("detail-price-row")!.classList.toggle("hidden", hideMoney);
    document.getElementById("detail-paid-row")!.classList.toggle("hidden", hideMoney);
    if (!hideMoney) {
      priceInput.value = a.price != null ? String(a.price) : "";
      discountInput.value = a.discount ? String(a.discount) : "";
      updatePayablePreview();
    }

    paidToggle.dataset.on = String(a.is_paid);
    paidToggle.setAttribute("aria-checked", String(a.is_paid));

    // Payment method (cash / card / other) — visible once paid
    syncMethodRow(a);

    // Secret invisible control: masters only, on paid appointments
    hidePaymentBtn.hidden = !(isMasterAccount(adminEmail) && a.is_paid && !a.is_blocked_time);

    // Who created / booked this appointment
    const createdByEl = document.getElementById("detail-created-by")!;
    const who = creatorDisplayName(a.created_by);
    if (who) {
      const when = new Date(a.created_at).toLocaleDateString("el-GR", {
        day: "numeric", month: "short", year: "numeric",
      });
      createdByEl.textContent = `Καταχωρήθηκε από: ${who} · ${when}`;
    }
    createdByEl.classList.toggle("hidden", !who);

    const deleteBtn = document.getElementById("detail-delete") as HTMLButtonElement;
    deleteBtn.classList.toggle("hidden", !canDelete(a));

    const repeatBtn = document.getElementById("detail-repeat") as HTMLButtonElement;
    const repeatTop = document.getElementById("detail-repeat-top")!;
    const repeatBottom = document.getElementById("detail-repeat-bottom")!;
    if (a.is_blocked_time) {
      repeatTop.appendChild(repeatBtn);
      repeatTop.classList.remove("hidden");
      repeatBtn.className =
        "min-h-12 w-full rounded-full bg-spine px-6 py-3 font-display text-sm font-semibold text-white transition hover:bg-spine-700";
    } else {
      repeatBottom.appendChild(repeatBtn);
      repeatTop.classList.add("hidden");
      repeatBtn.className =
        "mt-4 min-h-12 w-full rounded-full border border-slate-200 px-6 py-3 font-display text-sm font-semibold text-charcoal transition hover:bg-sand";
    }

    // Staff notes (any admin can read + add)
    staffNotesWrap.classList.toggle("hidden", a.is_blocked_time);
    staffNoteInput.value = "";
    if (!a.is_blocked_time) loadStaffNotes(a.id);

    openModal(detailSheet);
  }

  // ── Staff notes on the appointment (mirrored on the client profile) ──
  const staffNotesWrap = document.getElementById("detail-staff-notes")!;
  const staffNotesList = document.getElementById("staff-notes-list")!;
  const staffNotesEmpty = document.getElementById("staff-notes-empty")!;
  const staffNoteInput = document.getElementById("staff-note-input") as HTMLTextAreaElement;
  const staffNoteSaveBtn = document.getElementById("staff-note-save") as HTMLButtonElement;
  let staffNotesToken = 0;

  function staffNoteItem(n: AppointmentNote): string {
    const author = creatorDisplayName(n.author_email) ?? n.author_email;
    const when = new Date(n.created_at).toLocaleDateString("el-GR", {
      day: "numeric", month: "short", year: "numeric",
    });
    // Only master accounts (Egly, Charalambos) may delete notes
    const delBtn = isMasterAccount(adminEmail)
      ? `<button type="button" data-delete-note="${n.id}"
          class="flex h-8 w-8 flex-none items-center justify-center rounded-full text-red-600 transition hover:bg-red-50"
          aria-label="Διαγραφή σημείωσης">
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 4h10M6 4V3h4v1M6.5 7v5M9.5 7v5M4.5 4l.7 9h5.6l.7-9"/></svg>
        </button>`
      : "";
    return `
      <li class="rounded-lg bg-sand px-3 py-2">
        <div class="flex items-start justify-between gap-2">
          <p class="min-w-0 whitespace-pre-line text-sm text-charcoal">${escHtml(n.body)}</p>
          ${delBtn}
        </div>
        <p class="mt-1 text-[11px] font-medium text-charcoal-muted">${escHtml(author)} · ${when}</p>
      </li>`;
  }

  staffNotesList.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-delete-note]");
    if (!btn || !selectedAppt) return;
    if (!isMasterAccount(adminEmail)) return;
    if (!confirm("Διαγραφή αυτής της σημείωσης;")) return;
    const { error } = await supabase
      .from("appointment_notes")
      .delete()
      .eq("id", btn.dataset.deleteNote);
    if (error) {
      alert(`Η διαγραφή απέτυχε: ${error.message}`);
      return;
    }
    loadStaffNotes(selectedAppt.id);
  });

  async function loadStaffNotes(appointmentId: string) {
    const token = ++staffNotesToken;
    staffNotesList.innerHTML = "";
    staffNotesEmpty.classList.add("hidden");
    const { data, error } = await supabase
      .from("appointment_notes")
      .select("*")
      .eq("appointment_id", appointmentId)
      .order("created_at", { ascending: true });
    if (token !== staffNotesToken) return; // a newer appointment was opened
    if (error) return;
    const notes = (data ?? []) as AppointmentNote[];
    staffNotesList.innerHTML = notes.map(staffNoteItem).join("");
    staffNotesEmpty.classList.toggle("hidden", notes.length > 0);
  }

  staffNoteSaveBtn.addEventListener("click", async () => {
    if (!selectedAppt || selectedAppt.is_blocked_time) return;
    const body = staffNoteInput.value.trim();
    if (!body) return;
    await ensureAdminEmail();
    staffNoteSaveBtn.disabled = true;
    const { error } = await supabase.from("appointment_notes").insert({
      appointment_id: selectedAppt.id,
      patient_id: selectedAppt.patient_id,
      author_email: adminEmail || "unknown",
      body,
    });
    staffNoteSaveBtn.disabled = false;
    if (error) {
      alert(`Αποτυχία αποθήκευσης σημείωσης: ${error.message}`);
      return;
    }
    staffNoteInput.value = "";
    loadStaffNotes(selectedAppt.id);
  });

  // ── Payment method (Μετρητά / Κάρτα / Άλλο) ──
  const methodRow = document.getElementById("detail-method-row")!;
  const methodBtns = Array.from(
    methodRow.querySelectorAll<HTMLButtonElement>("[data-pay-method]"),
  );

  function syncMethodRow(a: Appointment) {
    const show = !a.is_blocked_time && canSeePayments(a) && a.is_paid;
    methodRow.classList.toggle("hidden", !show);
    methodBtns.forEach((b) => {
      b.dataset.active = String(show && b.dataset.payMethod === a.payment_method);
    });
  }

  methodBtns.forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!selectedAppt || !canSeePayments(selectedAppt)) return;
      const method = btn.dataset.payMethod as "cash" | "card" | "other";
      if (selectedAppt.payment_method === method) return;
      methodBtns.forEach((b) => (b.disabled = true));
      const { error } = await supabase
        .from("appointments")
        .update({ payment_method: method })
        .eq("id", selectedAppt.id);
      methodBtns.forEach((b) => (b.disabled = false));
      if (error) {
        alert(`Αποτυχία αποθήκευσης: ${error.message}`);
        return;
      }
      selectedAppt.payment_method = method;
      syncMethodRow(selectedAppt);
    });
  });

  hidePaymentBtn.addEventListener("click", async (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (!selectedAppt) return;
    if (!isMasterAccount(adminEmail) || !selectedAppt.is_paid) return;
    const next = !selectedAppt.payments_hidden;
    hidePaymentBtn.disabled = true;
    const { error } = await supabase
      .from("appointments")
      .update({ payments_hidden: next })
      .eq("id", selectedAppt.id);
    hidePaymentBtn.disabled = false;
    if (error) {
      alert(`Αποτυχία: ${error.message}`);
      return;
    }
    selectedAppt.payments_hidden = next;
    // Quiet feedback only — no visible control
    alert(next ? "Κρύφτηκε από τα σύνολα πληρωμών." : "Εμφανίζεται ξανά στα σύνολα.");
    refresh();
  });

  const detailTherapistLock = document.getElementById("detail-therapist-lock")!;
  const detailTherapistTransfer = document.getElementById("detail-therapist-transfer")!;

  function endTimeAfter(startValue: string, durationMin: number): string {
    const [h, m] = startValue.split(":").map(Number);
    if (!Number.isFinite(h) || !Number.isFinite(m)) return startValue;
    const total = h * 60 + m + durationMin;
    const eh = Math.floor(total / 60) % 24;
    const em = total % 60;
    return `${String(eh).padStart(2, "0")}:${String(em).padStart(2, "0")}`;
  }

  let detailDurationMin = 45;
  detailStartInput.addEventListener("focus", () => {
    const [sh, sm] = detailStartInput.value.split(":").map(Number);
    const [eh, em] = detailEndInput.value.split(":").map(Number);
    if (![sh, sm, eh, em].every((n) => Number.isFinite(n))) return;
    let mins = eh * 60 + em - (sh * 60 + sm);
    if (mins <= 0) mins += 24 * 60;
    detailDurationMin = mins;
  });
  detailStartInput.addEventListener("change", () => {
    detailEndInput.value = endTimeAfter(detailStartInput.value, detailDurationMin);
  });

  function syncDetailTherapistLock(service: string) {
    syncTherapistOptions(detailTherapistSelect, service, detailTherapistLock);
    const locked = !!lockedTherapistIdForAdminService(service);
    detailTherapistTransfer.classList.toggle("hidden", locked);
  }

  detailServiceSelect.addEventListener("change", () => {
    if (!selectedAppt || selectedAppt.is_blocked_time) return;
    syncDetailTherapistLock(detailServiceSelect.value);
    syncServiceOptions(detailServiceSelect, detailTherapistSelect.value, false);
    detailEndInput.value = endTimeAfter(
      detailStartInput.value,
      durationForAdminService(detailServiceSelect.value),
    );
    if (!canSeePayments(selectedAppt)) return;
    const price = defaultPriceForAdminService(detailServiceSelect.value);
    if (price != null) {
      priceInput.value = String(price);
      updatePayablePreview();
    }
  });

  detailScheduleSaveBtn.addEventListener("click", async () => {
    if (!selectedAppt) return;
    const [sh, sm] = detailStartInput.value.split(":").map(Number);
    const [eh, em] = detailEndInput.value.split(":").map(Number);
    if (!Number.isFinite(sh) || !Number.isFinite(sm) || !Number.isFinite(eh) || !Number.isFinite(em)) {
      alert("Μη έγκυρη ώρα.");
      return;
    }

    const day = new Date(selectedAppt.start_time);
    const start = new Date(day);
    start.setHours(sh, sm, 0, 0);
    const end = new Date(day);
    end.setHours(eh, em, 0, 0);
    if (end <= start) {
      alert("Η ώρα λήξης πρέπει να είναι μετά την έναρξη.");
      return;
    }

    const patch: {
      start_time: string;
      end_time: string;
      service?: string | null;
      price?: number | null;
      therapist_id?: string;
    } = {
      start_time: start.toISOString(),
      end_time: end.toISOString(),
    };

    if (!selectedAppt.is_blocked_time) {
      const service = detailServiceSelect.value.trim();
      if (!service) {
        alert("Επιλέξτε υπηρεσία.");
        return;
      }
      patch.service = service;
      const lockedTherapist = lockedTherapistIdForAdminService(service);
      const therapistId = lockedTherapist ?? detailTherapistSelect.value;
      if (therapistId && therapistId !== selectedAppt.therapist_id) {
        patch.therapist_id = therapistId;
      }
      // Only when category changes: apply that service’s default price
      if (service !== (selectedAppt.service ?? "") && canSeePayments(selectedAppt)) {
        const def = defaultPriceForAdminService(service);
        if (def != null) {
          patch.price = def;
          priceInput.value = String(def);
          updatePayablePreview();
        }
      }
    }

    const prevStart = new Date(selectedAppt.start_time);
    const prevEnd = new Date(selectedAppt.end_time);
    const clockChanged = clockMinutes(start) !== clockMinutes(prevStart)
      || clockMinutes(end) !== clockMinutes(prevEnd);

    detailScheduleSaveBtn.disabled = true;
    if (clockChanged) {
      try {
        const series = await applyClockToSeries(selectedAppt, start, end);
        if (series.error) {
          detailScheduleSaveBtn.disabled = false;
          alert(`Αποτυχία αποθήκευσης: ${series.error}`);
          return;
        }
      } catch (err) {
        detailScheduleSaveBtn.disabled = false;
        alert(`Αποτυχία αποθήκευσης: ${err instanceof Error ? err.message : String(err)}`);
        return;
      }
    }
    const { error } = await supabase
      .from("appointments")
      .update(patch)
      .eq("id", selectedAppt.id);
    detailScheduleSaveBtn.disabled = false;

    if (error) {
      alert(`Αποτυχία αποθήκευσης: ${error.message}`);
      return;
    }

    await dropSameSlotCopies(selectedAppt, patch.start_time);
    selectedAppt.start_time = patch.start_time;
    selectedAppt.end_time = patch.end_time;
    if (patch.service !== undefined) selectedAppt.service = patch.service;
    if (patch.price !== undefined) selectedAppt.price = patch.price;
    if (patch.therapist_id) {
      selectedAppt.therapist_id = patch.therapist_id;
      const th = getTherapist(patch.therapist_id);
      selectedAppt.therapists = th
        ? { id: th.id, slug: th.slug, name_el: th.nameEl, name_en: th.nameEn }
        : null;
    }
    refresh();
  });

  detailTherapistSelect.addEventListener("change", async () => {
    if (!selectedAppt) return;
    const nextId = detailTherapistSelect.value;
    const prevId = selectedAppt.therapist_id;
    const locked = lockedTherapistIdForAdminService(selectedAppt.service ?? detailServiceSelect.value);
    if (locked && nextId !== locked) {
      detailTherapistSelect.value = locked;
      return;
    }
    if (nextId === prevId) return;

    detailTherapistSelect.disabled = true;
    const { error } = await supabase
      .from("appointments")
      .update({ therapist_id: nextId })
      .eq("id", selectedAppt.id);
    detailTherapistSelect.disabled = false;

    if (error) {
      detailTherapistSelect.value = prevId ?? DEFAULT_THERAPIST_ID;
      alert(`Αποτυχία μεταφοράς: ${error.message}`);
      return;
    }

    selectedAppt.therapist_id = nextId;
    const th = getTherapist(nextId);
    selectedAppt.therapists = th
      ? { id: th.id, slug: th.slug, name_el: th.nameEl, name_en: th.nameEn }
      : null;
    syncServiceOptions(detailServiceSelect, nextId, false);
    refresh();
  });

  priceSaveBtn.addEventListener("click", async () => {
    if (!selectedAppt) return;
    if (!canSeePayments(selectedAppt)) return;
    const price = parseMoneyInput(priceInput);
    const discount = parseMoneyInput(discountInput) ?? 0;
    if (priceInput.value.trim() !== "" && price == null) {
      alert("Μη έγκυρη τιμή.");
      return;
    }
    if (discountInput.value.trim() !== "" && parseMoneyInput(discountInput) == null) {
      alert("Μη έγκυρη έκπτωση.");
      return;
    }
    if (price != null && discount > price) {
      if (!confirm("Η έκπτωση είναι μεγαλύτερη από την τιμή. Το πληρωτέο θα είναι 0 €. Συνέχεια;")) return;
    }

    priceSaveBtn.disabled = true;
    const { error } = await supabase
      .from("appointments")
      .update({ price, discount })
      .eq("id", selectedAppt.id);
    priceSaveBtn.disabled = false;
    if (error) {
      alert(`Αποτυχία αποθήκευσης: ${error.message}`);
      return;
    }
    selectedAppt.price = price;
    selectedAppt.discount = discount;
    updatePayablePreview();
    refresh();
  });

  paidToggle.addEventListener("click", async () => {
    if (!selectedAppt) return;
    if (!canSeePayments(selectedAppt)) return;
    const next = !(paidToggle.dataset.on === "true");
    // optimistic UI, revert on failure
    paidToggle.dataset.on = String(next);
    paidToggle.setAttribute("aria-checked", String(next));
    const patch: {
      is_paid: boolean;
      payments_hidden?: boolean;
      payment_method?: "cash" | "card" | "other" | null;
    } = { is_paid: next };
    if (next) {
      // Paying defaults to cash — the method row below lets them change it
      patch.payment_method = selectedAppt.payment_method ?? "cash";
    } else {
      // Clearing paid also clears hide flag + payment method
      patch.payments_hidden = false;
      patch.payment_method = null;
    }
    const { error } = await supabase
      .from("appointments").update(patch).eq("id", selectedAppt.id);
    if (error) {
      paidToggle.dataset.on = String(!next);
      paidToggle.setAttribute("aria-checked", String(!next));
      return;
    }
    selectedAppt.is_paid = next;
    selectedAppt.payment_method = patch.payment_method ?? null;
    if (!next) selectedAppt.payments_hidden = false;
    syncMethodRow(selectedAppt);
    hidePaymentBtn.hidden = !(isMasterAccount(adminEmail) && next && !selectedAppt.is_blocked_time);
    refresh();
  });

  // ── Delete: single entry, whole repeat series, or all upcoming of the patient ──
  const deleteInfo = document.getElementById("delete-modal-info")!;
  const deleteError = document.getElementById("delete-modal-error")!;
  const deleteOnlyBtn = document.getElementById("delete-only-btn") as HTMLButtonElement;
  const deleteSeriesBtn = document.getElementById("delete-series-btn") as HTMLButtonElement;
  const deleteUpcomingBtn = document.getElementById("delete-upcoming-btn") as HTMLButtonElement;

  deleteModal.querySelectorAll("[data-close-delete]").forEach((el) =>
    el.addEventListener("click", () => closeModal(deleteModal)),
  );

  /** Upcoming ids the "repeats" option would delete (series + same weekday/time). */
  let deleteSeriesIds: string[] = [];

  /** Soft-cancel payload — records who cancelled and when for the masters' list. */
  const cancelStamp = () => ({
    status: "cancelled",
    cancelled_by: adminEmail,
    cancelled_at: new Date().toISOString(),
  });

  async function runDelete(mode: "one" | "series" | "upcoming") {
    const a = selectedAppt;
    if (!a) return;
    const nowIso = new Date().toISOString();
    const btns = [deleteOnlyBtn, deleteSeriesBtn, deleteUpcomingBtn];
    btns.forEach((b) => (b.disabled = true));
    deleteError.classList.add("hidden");

    let error: { message: string } | null = null;
    if (mode === "series" && deleteSeriesIds.length) {
      // Patient appointments are soft-cancelled (kept for the masters' cancelled
      // list); blocked time is just removed.
      ({ error } = a.is_blocked_time
        ? await supabase.from("appointments").delete().in("id", deleteSeriesIds)
        : await supabase
            .from("appointments")
            .update(cancelStamp())
            .in("id", deleteSeriesIds));
    } else if (mode === "upcoming" && a.patient_id) {
      let q = supabase
        .from("appointments")
        .update(cancelStamp())
        .eq("patient_id", a.patient_id)
        .gte("start_time", nowIso)
        .neq("id", a.id);
      // Non-masters only clear their own calendar
      if (!isMasterAccount(adminEmail)) q = q.eq("therapist_id", a.therapist_id ?? "");
      ({ error } = await q);
    }
    if (!error) {
      ({ error } = a.is_blocked_time
        ? await supabase.from("appointments").delete().eq("id", a.id)
        : await supabase
            .from("appointments")
            .update(cancelStamp())
            .eq("id", a.id));
    }
    btns.forEach((b) => (b.disabled = false));
    if (error) {
      deleteError.textContent = `Η διαγραφή απέτυχε: ${error.message}`;
      deleteError.classList.remove("hidden");
      return;
    }
    closeModal(deleteModal);
    closeModal(detailSheet);
    refresh();
    void loadCancelled();
  }

  deleteOnlyBtn.addEventListener("click", () => void runDelete("one"));
  deleteSeriesBtn.addEventListener("click", () => void runDelete("series"));
  deleteUpcomingBtn.addEventListener("click", () => void runDelete("upcoming"));

  document.getElementById("detail-delete")!.addEventListener("click", async () => {
    const a = selectedAppt;
    if (!a) return;
    if (!canDelete(a)) {
      alert("Μπορείτε να διαγράψετε μόνο τα δικά σας ραντεβού.");
      return;
    }

    // How many other entries would the bulk options touch?
    const nowIso = new Date().toISOString();
    let upcomingCount = 0;

    // "Repeats" = same recurrence series OR same weekday & time on the same
    // calendar (catches series made before groups existed, without ticking
    // them one by one).
    deleteSeriesIds = [];
    const src = new Date(a.start_time);
    const isSameSlot = (iso: string) => {
      const d = new Date(iso);
      return (
        d.getDay() === src.getDay() &&
        d.getHours() === src.getHours() &&
        d.getMinutes() === src.getMinutes()
      );
    };
    let sq = supabase
      .from("appointments")
      .select("id, start_time, recurrence_group")
      .eq("therapist_id", a.therapist_id ?? "")
      .eq("is_blocked_time", a.is_blocked_time)
      .neq("status", "cancelled")
      .neq("id", a.id)
      .gte("start_time", nowIso);
    if (!a.is_blocked_time) sq = sq.eq("patient_id", a.patient_id ?? "");
    const { data: seriesRows } = await sq;
    deleteSeriesIds = ((seriesRows ?? []) as Pick<Appointment, "id" | "start_time" | "recurrence_group">[])
      .filter(
        (r) =>
          (a.recurrence_group && r.recurrence_group === a.recurrence_group) ||
          isSameSlot(r.start_time),
      )
      .map((r) => r.id);
    const seriesCount = deleteSeriesIds.length;

    if (!a.is_blocked_time && a.patient_id) {
      let q = supabase
        .from("appointments")
        .select("id", { count: "exact", head: true })
        .eq("patient_id", a.patient_id)
        .neq("id", a.id)
        .neq("status", "cancelled")
        .gte("start_time", nowIso);
      if (!isMasterAccount(adminEmail)) q = q.eq("therapist_id", a.therapist_id ?? "");
      const { count } = await q;
      upcomingCount = count ?? 0;
    }

    if (!seriesCount && !upcomingCount) {
      if (!confirm("Σίγουρα θέλετε να διαγράψετε αυτή την καταχώρηση;")) return;
      const deleteBtn = document.getElementById("detail-delete") as HTMLButtonElement;
      deleteBtn.disabled = true;
      const { error } = a.is_blocked_time
        ? await supabase.from("appointments").delete().eq("id", a.id)
        : await supabase
            .from("appointments")
            .update(cancelStamp())
            .eq("id", a.id);
      deleteBtn.disabled = false;
      if (error) {
        alert(`Η διαγραφή απέτυχε: ${error.message}`);
        return;
      }
      closeModal(detailSheet);
      refresh();
      void loadCancelled();
      return;
    }

    deleteInfo.textContent = "Η καταχώρηση συνδέεται με άλλες. Τι θέλετε να διαγραφεί;";
    deleteSeriesBtn.classList.toggle("hidden", !seriesCount);
    deleteSeriesBtn.textContent = `Αυτή + τις επαναλήψεις ίδιας μέρας & ώρας (${seriesCount})`;
    deleteUpcomingBtn.classList.toggle("hidden", !upcomingCount);
    deleteUpcomingBtn.textContent = `Αυτή + όλα τα επερχόμενα του πελάτη (${upcomingCount})`;
    deleteError.classList.add("hidden");
    openModal(deleteModal);
  });

  // ── Closed-day booking requests (visible to master accounts only) ──
  const requestsBanner = document.getElementById("requests-banner")!;
  const requestsList = document.getElementById("requests-list")!;
  const requestsCount = document.getElementById("requests-count")!;

  const escHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!,
    );

  let pendingRequests: BookingRequest[] = [];

  async function loadBookingRequests() {
    if (!isMasterAccount(adminEmail)) return;
    const { data, error } = await supabase
      .from("booking_requests")
      .select("*")
      .eq("status", "pending")
      .order("preferred_start");
    if (error) return;

    pendingRequests = (data ?? []) as BookingRequest[];
    requestsBanner.classList.toggle("hidden", pendingRequests.length === 0);
    requestAnimationFrame(() => fitCalendarScroll());
    requestsCount.textContent = String(pendingRequests.length);
    requestsList.innerHTML = pendingRequests
      .map((r) => {
        const start = new Date(r.preferred_start);
        const when =
          start.toLocaleDateString("el-GR", { weekday: "long", day: "numeric", month: "long" }) +
          " · " +
          fmtClock(start);
        return `
        <li class="rounded-xl bg-white p-3.5 ring-1 ring-amber-100" data-request-id="${r.id}">
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0">
              <p class="truncate font-display text-sm font-bold text-charcoal">${escHtml(r.name)}</p>
              <p class="mt-0.5 text-xs font-medium text-amber-700">${when}</p>
              ${r.service ? `<p class="mt-0.5 text-xs text-charcoal-muted">${escHtml(r.service)}</p>` : ""}
              ${r.phone ? `<a href="tel:${escHtml(r.phone)}" class="mt-0.5 block text-xs font-medium text-spine underline">${escHtml(r.phone)}</a>` : ""}
              ${r.concern ? `<p class="mt-1 text-xs text-charcoal-muted">${escHtml(r.concern)}</p>` : ""}
            </div>
          </div>
          <div class="mt-2.5 grid grid-cols-2 gap-2">
            <button type="button" data-request-approve
              class="min-h-10 rounded-full bg-spine px-3 py-2 font-display text-xs font-semibold text-white transition hover:bg-spine-600 disabled:opacity-60">
              Έγκριση
            </button>
            <button type="button" data-request-reject
              class="min-h-10 rounded-full border border-red-200 px-3 py-2 font-display text-xs font-semibold text-red-600 transition hover:bg-red-50 disabled:opacity-60">
              Απόρριψη
            </button>
          </div>
        </li>`;
      })
      .join("");
  }

  /** Approving creates the real appointment (patient found or created first). */
  async function approveRequest(r: BookingRequest) {
    let patientId: string | null = null;

    if (r.email) {
      const { data } = await supabase
        .from("patients").select("id").ilike("email", r.email).limit(1);
      if (data?.length) patientId = data[0].id;
    }
    if (!patientId && r.phone) {
      const { data } = await supabase
        .from("patients").select("id").eq("phone", r.phone).limit(1);
      if (data?.length) patientId = data[0].id;
    }
    if (!patientId) {
      const { data, error } = await supabase
        .from("patients")
        .insert({ name: r.name, email: r.email, phone: r.phone })
        .select("id")
        .single();
      if (error || !data) {
        alert(`Αποτυχία δημιουργίας πελάτη: ${error?.message ?? ""}`);
        return;
      }
      patientId = data.id;
    }

    const therapistId =
      r.therapist_id ??
      suggestTherapistIdForService(r.service ?? "") ??
      DEFAULT_THERAPIST_ID;

    const { error: insErr } = await supabase.from("appointments").insert({
      patient_id: patientId,
      therapist_id: therapistId,
      service: r.service ?? "Ειδικό αίτημα",
      start_time: r.preferred_start,
      end_time: r.preferred_end,
      notes: r.concern,
      price: defaultPriceForAdminService(r.service ?? ""),
    });
    if (insErr) {
      alert(`Αποτυχία δημιουργίας ραντεβού: ${insErr.message}`);
      return;
    }

    await supabase.from("booking_requests").update({ status: "approved" }).eq("id", r.id);
    await loadBookingRequests();
    refresh();
  }

  requestsList.addEventListener("click", async (e) => {
    const target = e.target as HTMLElement;
    const item = target.closest<HTMLElement>("[data-request-id]");
    if (!item) return;
    const request = pendingRequests.find((r) => r.id === item.dataset.requestId);
    if (!request) return;

    if (target.closest("[data-request-approve]")) {
      const btn = target.closest<HTMLButtonElement>("[data-request-approve]")!;
      btn.disabled = true;
      await approveRequest(request);
      btn.disabled = false;
    } else if (target.closest("[data-request-reject]")) {
      if (!confirm("Απόρριψη αυτού του αιτήματος;")) return;
      const btn = target.closest<HTMLButtonElement>("[data-request-reject]")!;
      btn.disabled = true;
      await supabase.from("booking_requests").update({ status: "rejected" }).eq("id", request.id);
      btn.disabled = false;
      await loadBookingRequests();
    }
  });

  // ── Cancelled bookings list (visible to master accounts only) ──
  const cancelledBanner = document.getElementById("cancelled-banner")!;
  const cancelledToggle = document.getElementById("cancelled-toggle")!;
  const cancelledChevron = document.getElementById("cancelled-chevron")!;
  const cancelledBody = document.getElementById("cancelled-body")!;
  const cancelledBulk = document.getElementById("cancelled-bulk")!;
  const cancelledSelectAll = document.getElementById("cancelled-select-all") as HTMLInputElement;
  const cancelledDeleteSelected = document.getElementById("cancelled-delete-selected") as HTMLButtonElement;
  const cancelledList = document.getElementById("cancelled-list")!;
  const cancelledCount = document.getElementById("cancelled-count")!;
  const cancelledTitle = document.getElementById("cancelled-title")!;

  cancelledToggle.addEventListener("click", () => {
    const open = cancelledBody.classList.toggle("hidden");
    cancelledChevron.classList.toggle("rotate-180", !open);
  });

  function selectedCancelledIds(): string[] {
    return [...cancelledList.querySelectorAll<HTMLInputElement>("[data-cancelled-select]:checked")]
      .map((box) => box.value)
      .filter((id) => cancelledAppts.some((a) => a.id === id));
  }

  function syncCancelledSelection() {
    const boxes = [...cancelledList.querySelectorAll<HTMLInputElement>("[data-cancelled-select]")];
    const n = boxes.filter((box) => box.checked).length;
    cancelledDeleteSelected.disabled = n === 0;
    cancelledDeleteSelected.textContent = n
      ? `Διαγραφή επιλεγμένων (${n})`
      : "Διαγραφή επιλεγμένων";
    cancelledSelectAll.checked = boxes.length > 0 && n === boxes.length;
    cancelledSelectAll.indeterminate = n > 0 && n < boxes.length;
  }

  let cancelledAppts: Appointment[] = [];

  /** Whose cancellations this account may see. null = none. */
  function cancelledScopeId(): string | null | "all" {
    const master = isMasterAccount(adminEmail);
    if (master) return therapistFilter ?? "all";
    const ownId = therapistIdForEmail(adminEmail);
    if (!ownId) return null;
    if (therapistFilter && therapistFilter !== ownId) return null;
    return ownId;
  }

  async function loadCancelled() {
    const scope = cancelledScopeId();
    if (!scope) {
      cancelledAppts = [];
      cancelledBanner.classList.add("hidden");
      return;
    }
    // Recent + upcoming cancellations (last 60 days of appointment dates).
    const since = new Date();
    since.setDate(since.getDate() - 60);
    let q = supabase
      .from("appointments")
      .select(APPT_SELECT)
      .eq("status", "cancelled")
      .eq("is_blocked_time", false)
      .gte("start_time", since.toISOString())
      .order("start_time", { ascending: false })
      .limit(100);
    if (scope !== "all") q = q.eq("therapist_id", scope);
    const { data, error } = await q;
    if (error) return;

    cancelledAppts = (data ?? []) as Appointment[];
    const whoName = scope === "all" ? null : (getTherapist(scope)?.nameEl ?? null);
    cancelledTitle.textContent = whoName
      ? `Ακυρωμένες · ${whoName}`
      : "Ακυρωμένες κρατήσεις";
    cancelledBanner.classList.toggle("hidden", cancelledAppts.length === 0);
    requestAnimationFrame(() => fitCalendarScroll());
    cancelledCount.textContent = String(cancelledAppts.length);
    const canPurge = isMasterAccount(adminEmail);
    cancelledBulk.classList.toggle("hidden", !canPurge);
    cancelledBulk.classList.toggle("flex", canPurge);
    cancelledSelectAll.checked = false;
    cancelledSelectAll.indeterminate = false;
    cancelledList.innerHTML = cancelledAppts
      .map((a) => {
        const start = new Date(a.start_time);
        const when =
          start.toLocaleDateString("el-GR", { weekday: "short", day: "numeric", month: "short" }) +
          " · " +
          fmtClock(start);
        const who = a.cancelled_by
          ? (creatorDisplayName(a.cancelled_by) ?? a.cancelled_by)
          : null;
        const at = a.cancelled_at
          ? new Date(a.cancelled_at).toLocaleDateString("el-GR", { day: "numeric", month: "short" })
          : null;
        const byLine = who
          ? `<p class="mt-1 text-[11px] font-medium text-red-600">Ακύρωση από ${escHtml(who)}${at ? ` · ${at}` : ""}</p>`
          : "";
        const pick = canPurge
          ? `<input type="checkbox" data-cancelled-select value="${a.id}"
              class="h-5 w-5 flex-none rounded border-slate-300 text-spine accent-[var(--color-spine)] focus:ring-spine/40" aria-label="Επιλογή για διαγραφή" />`
          : "";
        const trash = canPurge
          ? `<button type="button" data-cancelled-delete="${a.id}" aria-label="Διαγραφή ακύρωσης"
              class="flex h-11 w-11 flex-none items-center justify-center rounded-full text-red-600 transition hover:bg-red-50 active:bg-red-100">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13"/>
                <path d="M10 11v6M14 11v6"/>
              </svg>
            </button>`
          : "";
        return `
        <li class="flex items-center gap-2 rounded-xl bg-sand p-3" data-cancelled-id="${a.id}">
          ${pick}
          <div class="min-w-0 flex-1">
            <p class="truncate font-display text-sm font-bold text-charcoal">${escHtml(appointmentClientName(a))}</p>
            <p class="mt-0.5 text-xs font-medium text-charcoal-muted">${when} · ${escHtml(therapistName(a))}${a.service ? ` · ${escHtml(a.service)}` : ""}</p>
            ${byLine}
          </div>
          ${trash}
        </li>`;
      })
      .join("");
    syncCancelledSelection();
  }

  cancelledList.addEventListener("change", (e) => {
    if ((e.target as HTMLElement).matches?.("[data-cancelled-select]")) syncCancelledSelection();
  });

  cancelledSelectAll.addEventListener("change", () => {
    const on = cancelledSelectAll.checked;
    cancelledList.querySelectorAll<HTMLInputElement>("[data-cancelled-select]").forEach((box) => {
      box.checked = on;
    });
    syncCancelledSelection();
  });

  cancelledDeleteSelected.addEventListener("click", async () => {
    if (!isMasterAccount(adminEmail)) return;
    const ids = selectedCancelledIds();
    if (!ids.length) return;
    const noun = ids.length === 1 ? "ακυρωμένη κράτηση" : "ακυρωμένες κρατήσεις";
    if (!confirm(`Διαγραφή ${ids.length} ${noun}; Δεν αναιρείται.`)) return;
    cancelledDeleteSelected.disabled = true;
    const { error } = await supabase
      .from("appointments")
      .delete()
      .in("id", ids)
      .eq("status", "cancelled");
    if (error) {
      syncCancelledSelection();
      alert(`Αποτυχία διαγραφής: ${error.message}`);
      return;
    }
    await loadCancelled();
  });

  cancelledList.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-cancelled-delete]");
    if (!btn || !isMasterAccount(adminEmail)) return;
    const id = btn.dataset.cancelledDelete;
    const row = cancelledAppts.find((a) => a.id === id);
    if (!id || !row) return;
    const label = appointmentClientName(row);
    if (!confirm(`Διαγραφή της ακύρωσης για ${label}; Δεν αναιρείται.`)) return;
    btn.disabled = true;
    const { error } = await supabase.from("appointments").delete().eq("id", id);
    if (error) {
      btn.disabled = false;
      alert(`Αποτυχία διαγραφής: ${error.message}`);
      return;
    }
    await loadCancelled();
  });

  window.addEventListener("resize", fitCalendarScroll);
  window.visualViewport?.addEventListener("resize", fitCalendarScroll);
  window.matchMedia("(max-width: 767px)").addEventListener("change", fitCalendarScroll);

  ensureAdminEmail().then(() => {
    setViewMode("day");
    void loadBookingRequests();
    void loadCancelled();
  });
</script>
