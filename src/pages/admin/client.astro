---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Πελάτης" active="clients">
  <a href="/admin/clients" class="mb-4 inline-flex items-center gap-2 font-display text-sm font-semibold text-charcoal-muted transition hover:text-spine">
    <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 3L5 8l5 5"/></svg>
    Όλοι οι πελάτες
  </a>

  {/* ── Profile card ── */}
  <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-100">
    <div class="flex items-center gap-4">
      <span id="cl-avatar" class="flex h-14 w-14 flex-none items-center justify-center rounded-full bg-spine-50 font-display text-lg font-bold text-spine"></span>
      <div class="min-w-0 flex-1">
        <h1 id="cl-name" class="truncate font-display text-xl font-bold text-charcoal">…</h1>
        <div class="mt-0.5 flex flex-wrap gap-x-4 gap-y-0.5 text-sm">
          <a id="cl-phone" href="#" class="hidden font-medium text-spine underline"></a>
          <a id="cl-email" href="#" class="hidden truncate text-charcoal-muted underline"></a>
        </div>
      </div>
      <button id="edit-client-btn" type="button"
        class="flex h-11 w-11 flex-none items-center justify-center rounded-full border border-slate-200 text-charcoal-muted transition hover:border-spine hover:text-spine"
        aria-label="Επεξεργασία στοιχείων" title="Επεξεργασία στοιχείων">
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M11.5 2.5l2 2L5 13H3v-2l8.5-8.5z"/>
        </svg>
      </button>
    </div>
    <div id="cl-balance-wrap" class="mt-4 hidden rounded-xl bg-sand px-4 py-3">
      <p class="text-xs font-semibold uppercase tracking-wide text-charcoal-muted">Οφειλή</p>
      <p id="cl-balance" class="mt-0.5 font-display text-2xl font-bold text-amber-700">—</p>
      <p id="cl-balance-hint" class="mt-0.5 text-xs text-charcoal-muted">Άθροισμα απλήρωτων ραντεβού</p>
    </div>
    <button id="delete-client-btn" type="button"
      class="mt-4 min-h-12 w-full rounded-full border border-red-200 px-6 py-3 font-display text-sm font-semibold text-red-600 transition hover:bg-red-50">
      Διαγραφή πελάτη
    </button>
  </div>

  {/* ══ Modal: edit client ══ */}
  <div id="edit-client-modal" class="fixed inset-0 z-[100] hidden items-end justify-center sm:items-center">
    <div class="absolute inset-0 bg-spine-900/60 backdrop-blur-sm" data-close-edit></div>
    <div class="admin-sheet relative z-10 w-full max-w-md rounded-t-2xl bg-white p-5 sm:rounded-2xl">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="font-display text-lg font-bold text-charcoal">Στοιχεία πελάτη</h2>
        <button data-close-edit type="button" class="rounded-full p-2 text-charcoal-muted transition hover:bg-slate-100" aria-label="Κλείσιμο">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <form id="edit-client-form" class="space-y-4">
        <div>
          <label class="mb-1 block text-sm font-medium text-charcoal" for="edit-cl-name">Ονοματεπώνυμο *</label>
          <input id="edit-cl-name" name="name" type="text" required minlength="2"
            class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30" />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-charcoal" for="edit-cl-phone">Τηλέφωνο</label>
          <input id="edit-cl-phone" name="phone" type="tel"
            class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30" />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-charcoal" for="edit-cl-email">Email</label>
          <input id="edit-cl-email" name="email" type="email"
            class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30" />
        </div>
        <p id="edit-client-error" class="hidden text-sm text-red-600"></p>
        <button type="submit"
          class="w-full rounded-full bg-spine px-6 py-3 font-display font-semibold text-white transition hover:bg-spine-600 disabled:opacity-60">
          Αποθήκευση
        </button>
      </form>
    </div>
  </div>

  {/* ── Medical notes ── */}
  <div class="mt-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-100">
    <div class="mb-2 flex items-center justify-between">
      <h2 class="font-display text-sm font-bold uppercase tracking-wide text-charcoal">Ιατρικές σημειώσεις</h2>
      <span id="notes-status" class="text-xs text-charcoal-muted"></span>
    </div>
    <textarea
      id="cl-notes" rows="5" placeholder="Ιστορικό, παρατηρήσεις, θεραπείες…"
      class="w-full resize-y rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30"
    ></textarea>
    <button id="save-notes"
      class="mt-3 w-full rounded-full bg-spine px-6 py-2.5 font-display text-sm font-semibold text-white transition hover:bg-spine-600 disabled:opacity-60">
      Αποθήκευση σημειώσεων
    </button>
  </div>

  {/* ── Files & photos (shared with all admins) ── */}
  <div class="mt-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-100">
    <div class="mb-2 flex items-center justify-between gap-3">
      <h2 class="font-display text-sm font-bold uppercase tracking-wide text-charcoal">Αρχεία &amp; φωτογραφίες</h2>
      <span id="files-status" class="text-xs text-charcoal-muted"></span>
    </div>
    <p class="text-xs text-charcoal-muted">Φαίνονται σε όλους τους admin. Φωτογραφίες, PDF, Word — έως 15&nbsp;MB το καθένα.</p>
    <label class="relative mt-3 flex min-h-12 cursor-pointer items-center justify-center gap-2 overflow-hidden rounded-full bg-spine px-6 py-2.5 font-display text-sm font-semibold text-white transition hover:bg-spine-600">
      <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 3v10M3 8h10"/></svg>
      Προσθήκη αρχείων
      <input id="cl-files-input" type="file" class="absolute h-px w-px overflow-hidden opacity-0" multiple
        accept="image/jpeg,image/png,image/webp,image/gif,image/heic,image/heif,application/pdf,.pdf,.doc,.docx,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
    </label>
    <p id="files-error" class="mt-2 hidden text-sm text-red-600"></p>
    <ul id="files-photos" class="mt-4 hidden grid-cols-2 gap-2 sm:grid-cols-3"></ul>
    <ul id="files-docs" class="mt-3 hidden space-y-2"></ul>
    <p id="files-empty" class="mt-4 text-center text-sm text-charcoal-muted">Δεν υπάρχουν αρχεία ακόμη.</p>
  </div>

  <div id="file-lightbox" class="fixed inset-0 z-[120] hidden items-center justify-center bg-spine-900/80 p-4">
    <button type="button" data-close-lightbox class="absolute inset-0 cursor-default" aria-label="Κλείσιμο"></button>
    <div class="relative z-10 max-h-[90dvh] w-full max-w-3xl">
      <button type="button" data-close-lightbox
        class="absolute -top-1 right-0 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/90 text-charcoal shadow"
        aria-label="Κλείσιμο">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <img id="file-lightbox-img" alt="" class="max-h-[80dvh] w-full rounded-2xl object-contain" />
      <p id="file-lightbox-caption" class="mt-2 text-center text-sm text-white"></p>
    </div>
  </div>

  {/* ── Staff notes from appointments ── */}
  <div id="appt-notes-wrap" class="mt-4 hidden rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-100">
    <h2 class="mb-3 font-display text-sm font-bold uppercase tracking-wide text-charcoal">Σημειώσεις ραντεβού</h2>
    <ul id="appt-notes-list" class="space-y-2"></ul>
  </div>

  {/* ── Appointment history ── */}
  <div class="mt-4">
    <h2 class="mb-3 font-display text-sm font-bold uppercase tracking-wide text-charcoal">Ραντεβού</h2>
    <div id="upcoming-wrap" class="hidden">
      <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-emerald-600">Επερχόμενα</p>
      <ul id="upcoming-list" class="mb-4 space-y-2"></ul>
    </div>
    <div id="past-wrap" class="hidden">
      <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-charcoal-muted">Προηγούμενα</p>
      <ul id="past-list" class="space-y-2"></ul>
    </div>
    <p id="history-empty" class="hidden text-center text-sm text-charcoal-muted">Κανένα ραντεβού ακόμη.</p>
  </div>

  <p id="client-error" class="mt-8 hidden text-center text-sm text-red-600"></p>

  {/* ── Bulk payment bar — appears when unpaid appointments are ticked ── */}
  <div
    id="bulk-pay-bar"
    class="fixed inset-x-0 z-40 hidden border-t border-slate-200 bg-white/95 px-3 py-3 shadow-[0_-4px_16px_rgba(0,0,0,0.06)] backdrop-blur"
    style="bottom: calc(4.25rem + env(safe-area-inset-bottom))"
  >
    <div class="mx-auto flex max-w-5xl items-center gap-2.5">
      <p class="min-w-0 flex-1 font-display text-sm font-semibold text-charcoal">
        <span id="bulk-count">0</span> ραντεβού ·
        <span id="bulk-total" class="text-spine">—</span>
      </p>
      <select id="bulk-method"
        class="rounded-lg border border-slate-300 bg-white px-2.5 py-2 text-sm text-charcoal focus:border-spine focus:outline-none">
        <option value="cash" selected>Μετρητά</option>
        <option value="card">Κάρτα</option>
        <option value="other">Άλλο</option>
      </select>
      <button id="bulk-pay-btn" type="button"
        class="min-h-11 rounded-full bg-emerald-600 px-5 py-2 font-display text-sm font-semibold text-white transition hover:bg-emerald-700 disabled:opacity-60">
        Πληρωμή
      </button>
    </div>
  </div>
</AdminLayout>

<script>
  import { getSupabase, type Appointment, type AppointmentNote, type Patient, type PatientFile } from "../../lib/supabase";
  import { canViewTherapistPayments, creatorDisplayName, isMasterAccount } from "../../lib/admin-access";

  const supabase = getSupabase();
  const id = new URLSearchParams(window.location.search).get("id");
  const errorMsg = document.getElementById("client-error")!;
  let adminEmail = "";
  let currentPatient: Patient | null = null;
  let appointmentCount = 0;
  let patientFiles: (PatientFile & { signedUrl?: string })[] = [];

  const FILES_BUCKET = "patient-files";
  const FILE_MAX_BYTES = 15 * 1024 * 1024;
  const FILE_SIGNED_TTL = 8 * 3600;
  const FILE_ALLOWED_MIME = new Set([
    "image/jpeg",
    "image/jpg",
    "image/png",
    "image/webp",
    "image/gif",
    "image/heic",
    "image/heif",
    "application/pdf",
    "application/msword",
    "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
  ]);

  const fmtDate = (iso: string) =>
    new Date(iso).toLocaleDateString("el-GR", { weekday: "short", day: "numeric", month: "short", year: "numeric" });
  const fmtTime = (iso: string) =>
    new Date(iso).toLocaleTimeString("el-GR", { hour: "2-digit", minute: "2-digit" });
  const fmtEuro = (n: number) =>
    new Intl.NumberFormat("el-GR", { style: "currency", currency: "EUR" }).format(n);

  function payableAmount(a: Pick<Appointment, "price" | "discount">): number | null {
    if (a.price == null || Number.isNaN(Number(a.price))) return null;
    return Math.max(0, Number(a.price) - Number(a.discount ?? 0));
  }

  /** Unpaid total the current admin is allowed to see for this client. */
  function clientDebt(appts: Appointment[]): number {
    let total = 0;
    for (const a of appts) {
      if (a.is_blocked_time || a.is_paid) continue;
      if (!canViewTherapistPayments(adminEmail, a.therapist_id)) continue;
      const amount = payableAmount(a);
      if (amount != null) total += amount;
    }
    return total;
  }

  const METHOD_LABELS: Record<string, string> = {
    cash: "Μετρητά",
    card: "Κάρτα",
    other: "Άλλο",
  };

  const escHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!,
    );

  function apptNoteItem(n: AppointmentNote): string {
    const author = creatorDisplayName(n.author_email) ?? n.author_email;
    const when = new Date(n.created_at).toLocaleDateString("el-GR", {
      day: "numeric", month: "short", year: "numeric",
    });
    const appt = n.appointments
      ? `Ραντεβού ${fmtDate(n.appointments.start_time)}${n.appointments.service ? ` · ${escHtml(n.appointments.service)}` : ""}`
      : "";
    return `
      <li class="rounded-xl bg-sand px-4 py-3">
        ${appt ? `<p class="text-[11px] font-semibold uppercase tracking-wide text-spine">${appt}</p>` : ""}
        <p class="mt-1 whitespace-pre-line text-sm text-charcoal">${escHtml(n.body)}</p>
        <p class="mt-1.5 text-[11px] font-medium text-charcoal-muted">${escHtml(author)} · ${when}</p>
      </li>`;
  }

  function apptItem(a: Appointment): string {
    const showPay =
      canViewTherapistPayments(adminEmail, a.therapist_id) &&
      (!a.payments_hidden || isMasterAccount(adminEmail));
    const amount = showPay ? payableAmount(a) : null;
    const amountLabel =
      amount != null
        ? `<span class="flex-none text-xs font-semibold ${a.is_paid ? "text-emerald-600" : "text-amber-700"}">${fmtEuro(amount)}</span>`
        : "";
    const methodLabel =
      a.is_paid && a.payment_method ? ` · ${METHOD_LABELS[a.payment_method] ?? ""}` : "";
    const payBadge = !showPay
      ? ""
      : a.is_paid
        ? `<span class="flex-none rounded-full bg-emerald-100 px-2.5 py-1 text-[11px] font-bold text-emerald-700">Πληρωμένο${methodLabel}</span>`
        : '<span class="flex-none rounded-full bg-amber-100 px-2.5 py-1 text-[11px] font-bold text-amber-700">Απλήρωτο</span>';
    // Tickable only when unpaid, priced, and this admin manages those payments
    const canBulk = showPay && !a.is_paid && !a.is_blocked_time && amount != null;
    const checkbox = canBulk
      ? `<input type="checkbox" data-bulk-pay value="${a.id}" data-amount="${amount}"
          class="h-5 w-5 flex-none rounded border-slate-300 text-spine accent-[var(--color-spine)] focus:ring-spine/40" aria-label="Επιλογή για πληρωμή" />`
      : "";
    return `
      <li class="flex items-center justify-between gap-3 rounded-xl bg-white p-3.5 shadow-sm ring-1 ring-slate-100">
        ${checkbox}
        <div class="min-w-0 flex-1">
          <p class="truncate font-display text-sm font-semibold text-charcoal">${a.service ?? "Ραντεβού"}</p>
          <p class="text-xs text-charcoal-muted">${fmtDate(a.start_time)} · ${fmtTime(a.start_time)}–${fmtTime(a.end_time)}</p>
        </div>
        <div class="flex flex-none flex-col items-end gap-1">
          ${amountLabel}
          ${payBadge}
        </div>
      </li>`;
  }

  async function load() {
    if (!id) {
      errorMsg.textContent = "Δεν βρέθηκε πελάτης.";
      errorMsg.classList.remove("hidden");
      return;
    }

    const [{ data: { session } }, { data: patient, error: pErr }, { data: appts, error: aErr }, { data: noteRows }, { data: fileRows, error: fErr }] = await Promise.all([
      supabase.auth.getSession(),
      supabase.from("patients").select("*").eq("id", id).single(),
      supabase
        .from("appointments")
        .select("*")
        .eq("patient_id", id)
        .neq("status", "cancelled")
        .order("start_time", { ascending: false }),
      supabase
        .from("appointment_notes")
        .select("*, appointments(id, start_time, service)")
        .eq("patient_id", id)
        .order("created_at", { ascending: false }),
      supabase
        .from("patient_files")
        .select("*")
        .eq("patient_id", id)
        .order("created_at", { ascending: false }),
    ]);
    adminEmail = session?.user?.email ?? "";

    if (pErr || !patient) {
      errorMsg.textContent = `Σφάλμα: ${pErr?.message ?? "δεν βρέθηκε πελάτης"}`;
      errorMsg.classList.remove("hidden");
      return;
    }

    const p = patient as Patient;
    currentPatient = p;
    appointmentCount = (appts as Appointment[] | null)?.length ?? 0;
    renderProfile(p);

    (document.getElementById("cl-notes") as HTMLTextAreaElement).value = p.notes ?? "";

    if (fErr) {
      document.getElementById("files-error")!.textContent = `Σφάλμα αρχείων: ${fErr.message}`;
      document.getElementById("files-error")!.classList.remove("hidden");
    } else {
      await renderFiles((fileRows ?? []) as PatientFile[]);
    }

    // Staff notes written on this client's appointments
    const apptNotes = (noteRows ?? []) as AppointmentNote[];
    if (apptNotes.length) {
      document.getElementById("appt-notes-wrap")!.classList.remove("hidden");
      document.getElementById("appt-notes-list")!.innerHTML =
        apptNotes.map(apptNoteItem).join("");
    }

    // History split into upcoming / past + outstanding balance
    if (!aErr && appts) {
      const list = appts as Appointment[];
      const debt = clientDebt(list);
      const balanceWrap = document.getElementById("cl-balance-wrap")!;
      const balanceEl = document.getElementById("cl-balance")!;
      balanceWrap.classList.remove("hidden");
      balanceEl.textContent = fmtEuro(debt);
      balanceEl.className =
        "mt-0.5 font-display text-2xl font-bold " +
        (debt > 0 ? "text-amber-700" : "text-emerald-600");
      document.getElementById("cl-balance-hint")!.textContent =
        debt > 0 ? "Άθροισμα απλήρωτων ραντεβού" : "Καμία ανοιχτή οφειλή";

      const now = Date.now();
      const upcoming = list.filter((a) => new Date(a.start_time).getTime() >= now).reverse();
      const past = list.filter((a) => new Date(a.start_time).getTime() < now);

      if (upcoming.length) {
        document.getElementById("upcoming-wrap")!.classList.remove("hidden");
        document.getElementById("upcoming-list")!.innerHTML = upcoming.map(apptItem).join("");
      }
      if (past.length) {
        document.getElementById("past-wrap")!.classList.remove("hidden");
        document.getElementById("past-list")!.innerHTML = past.map(apptItem).join("");
      }
      document.getElementById("history-empty")!.classList.toggle("hidden", list.length > 0);
    }
  }

  // ── Bulk payment of ticked unpaid appointments ──
  const bulkBar = document.getElementById("bulk-pay-bar")!;
  const bulkCountEl = document.getElementById("bulk-count")!;
  const bulkTotalEl = document.getElementById("bulk-total")!;
  const bulkMethodSelect = document.getElementById("bulk-method") as HTMLSelectElement;
  const bulkPayBtn = document.getElementById("bulk-pay-btn") as HTMLButtonElement;

  function selectedBulkBoxes(): HTMLInputElement[] {
    return Array.from(
      document.querySelectorAll<HTMLInputElement>("[data-bulk-pay]:checked"),
    );
  }

  function updateBulkBar() {
    const boxes = selectedBulkBoxes();
    const total = boxes.reduce((sum, b) => sum + Number(b.dataset.amount ?? 0), 0);
    bulkCountEl.textContent = String(boxes.length);
    bulkTotalEl.textContent = fmtEuro(total);
    bulkBar.classList.toggle("hidden", boxes.length === 0);
  }

  document.addEventListener("change", (e) => {
    if ((e.target as HTMLElement).matches?.("[data-bulk-pay]")) updateBulkBar();
  });

  bulkPayBtn.addEventListener("click", async () => {
    const boxes = selectedBulkBoxes();
    if (!boxes.length) return;
    const ids = boxes.map((b) => b.value);
    const total = boxes.reduce((sum, b) => sum + Number(b.dataset.amount ?? 0), 0);
    const method = bulkMethodSelect.value as "cash" | "card" | "other";
    const methodLabel = { cash: "Μετρητά", card: "Κάρτα", other: "Άλλο" }[method];
    if (
      !confirm(
        `Πληρωμή ${ids.length} ραντεβού — σύνολο ${fmtEuro(total)} (${methodLabel});`,
      )
    )
      return;

    bulkPayBtn.disabled = true;
    const { error } = await supabase
      .from("appointments")
      .update({ is_paid: true, payment_method: method })
      .in("id", ids);
    bulkPayBtn.disabled = false;

    if (error) {
      alert(`Αποτυχία πληρωμής: ${error.message}`);
      return;
    }
    bulkBar.classList.add("hidden");
    load();
  });

  function renderProfile(p: Patient) {
    document.title = `${p.name} | ORC Admin`;
    document.getElementById("cl-name")!.textContent = p.name;
    document.getElementById("cl-avatar")!.textContent =
      p.name.split(/\s+/).slice(0, 2).map((w) => w[0]?.toUpperCase() ?? "").join("");

    const phoneEl = document.getElementById("cl-phone") as HTMLAnchorElement;
    if (p.phone) {
      phoneEl.textContent = p.phone;
      phoneEl.href = `tel:${p.phone}`;
      phoneEl.classList.remove("hidden");
    } else {
      phoneEl.textContent = "";
      phoneEl.removeAttribute("href");
      phoneEl.classList.add("hidden");
    }
    const emailEl = document.getElementById("cl-email") as HTMLAnchorElement;
    if (p.email) {
      emailEl.textContent = p.email;
      emailEl.href = `mailto:${p.email}`;
      emailEl.classList.remove("hidden");
    } else {
      emailEl.textContent = "";
      emailEl.removeAttribute("href");
      emailEl.classList.add("hidden");
    }
  }

  const editModal = document.getElementById("edit-client-modal")!;
  const editName = document.getElementById("edit-cl-name") as HTMLInputElement;
  const editPhone = document.getElementById("edit-cl-phone") as HTMLInputElement;
  const editEmail = document.getElementById("edit-cl-email") as HTMLInputElement;
  const editErr = document.getElementById("edit-client-error")!;

  function openEditModal() {
    if (!currentPatient) return;
    editName.value = currentPatient.name;
    editPhone.value = currentPatient.phone ?? "";
    editEmail.value = currentPatient.email ?? "";
    editErr.classList.add("hidden");
    editModal.classList.remove("hidden");
    editModal.classList.add("flex");
  }
  function closeEditModal() {
    editModal.classList.add("hidden");
    editModal.classList.remove("flex");
  }

  document.getElementById("edit-client-btn")!.addEventListener("click", openEditModal);
  editModal.querySelectorAll("[data-close-edit]").forEach((el) =>
    el.addEventListener("click", closeEditModal),
  );

  document.getElementById("edit-client-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!id) return;
    const name = editName.value.trim();
    if (name.length < 2) {
      editErr.textContent = "Το όνομα πρέπει να έχει τουλάχιστον 2 χαρακτήρες.";
      editErr.classList.remove("hidden");
      return;
    }
    const btn = (e.target as HTMLFormElement).querySelector("button[type=submit]") as HTMLButtonElement;
    btn.disabled = true;
    editErr.classList.add("hidden");
    const { data, error } = await supabase
      .from("patients")
      .update({
        name,
        phone: editPhone.value.trim() || null,
        email: editEmail.value.trim() || null,
      })
      .eq("id", id)
      .select("*")
      .single();
    btn.disabled = false;
    if (error || !data) {
      editErr.textContent = error?.message ?? "Αποτυχία αποθήκευσης.";
      editErr.classList.remove("hidden");
      return;
    }
    currentPatient = data as Patient;
    renderProfile(currentPatient);
    closeEditModal();
  });

  document.getElementById("delete-client-btn")!.addEventListener("click", async () => {
    if (!id || !currentPatient) return;
    const { count } = await supabase
      .from("appointments")
      .select("id", { count: "exact", head: true })
      .eq("patient_id", id);
    const n = count ?? appointmentCount;
    const extra = n > 0 ? ` Θα διαγραφούν και τα ${n} ραντεβού.` : "";
    if (!confirm(`Διαγραφή του πελάτη «${currentPatient.name}»;${extra}`)) return;
    if (n > 0 && !confirm("Η διαγραφή είναι οριστική. Συνέχεια;")) return;

    const btn = document.getElementById("delete-client-btn") as HTMLButtonElement;
    btn.disabled = true;
    const { data: attached } = await supabase
      .from("patient_files")
      .select("storage_path")
      .eq("patient_id", id);
    const paths = (attached ?? []).map((f) => f.storage_path as string).filter(Boolean);
    if (paths.length) {
      await supabase.storage.from(FILES_BUCKET).remove(paths);
    }
    const { error } = await supabase.from("patients").delete().eq("id", id);
    btn.disabled = false;
    if (error) {
      alert(`Η διαγραφή απέτυχε: ${error.message}`);
      return;
    }
    window.location.href = "/admin/clients";
  });

  // ── Save notes ──
  const saveBtn = document.getElementById("save-notes") as HTMLButtonElement;
  const notesStatus = document.getElementById("notes-status")!;
  saveBtn.addEventListener("click", async () => {
    if (!id) return;
    saveBtn.disabled = true;
    notesStatus.textContent = "Αποθήκευση…";
    const notes = (document.getElementById("cl-notes") as HTMLTextAreaElement).value;
    const { error } = await supabase.from("patients").update({ notes }).eq("id", id);
    saveBtn.disabled = false;
    notesStatus.textContent = error ? "Σφάλμα αποθήκευσης" : "Αποθηκεύτηκε ✓";
    setTimeout(() => (notesStatus.textContent = ""), 2500);
  });

  // ── Client files & photos ──
  const filesStatus = document.getElementById("files-status")!;
  const filesError = document.getElementById("files-error")!;
  const filesPhotos = document.getElementById("files-photos")!;
  const filesDocs = document.getElementById("files-docs")!;
  const filesEmpty = document.getElementById("files-empty")!;
  const filesInput = document.getElementById("cl-files-input") as HTMLInputElement;
  const lightbox = document.getElementById("file-lightbox")!;
  const lightboxImg = document.getElementById("file-lightbox-img") as HTMLImageElement;
  const lightboxCaption = document.getElementById("file-lightbox-caption")!;

  function isImageFile(mime: string | null | undefined, name: string) {
    if (mime?.startsWith("image/")) return true;
    return /\.(jpe?g|png|webp|gif|heic|heif)$/i.test(name);
  }

  function fileAllowed(file: File) {
    const mime = (file.type || "").toLowerCase();
    if (FILE_ALLOWED_MIME.has(mime)) return true;
    return /\.(jpe?g|png|webp|gif|heic|heif|pdf|docx?)$/i.test(file.name);
  }

  function safeFileName(name: string) {
    const trimmed = name.trim() || "file";
    return trimmed.replace(/[^\w.\-Α-Ωα-ωΆ-Ώά-ώ]+/g, "_").slice(0, 80);
  }

  function fmtBytes(n: number | null | undefined) {
    if (n == null || Number.isNaN(n)) return "";
    if (n < 1024) return `${n} B`;
    if (n < 1024 * 1024) return `${Math.round(n / 1024)} KB`;
    return `${(n / (1024 * 1024)).toFixed(1)} MB`;
  }

  function fileMetaLine(f: PatientFile) {
    const who = creatorDisplayName(f.uploaded_by) ?? f.uploaded_by ?? "";
    const when = new Date(f.created_at).toLocaleDateString("el-GR", {
      day: "numeric", month: "short", year: "numeric",
    });
    const size = fmtBytes(f.size_bytes);
    return [who, when, size].filter(Boolean).join(" · ");
  }

  async function renderFiles(rows: PatientFile[]) {
    filesError.classList.add("hidden");
    const paths = rows.map((f) => f.storage_path);
    let urlByPath = new Map<string, string>();
    if (paths.length) {
      const { data: signed, error } = await supabase.storage
        .from(FILES_BUCKET)
        .createSignedUrls(paths, FILE_SIGNED_TTL);
      if (error) {
        filesError.textContent = error.message;
        filesError.classList.remove("hidden");
      }
      for (const row of signed ?? []) {
        if (row.path && row.signedUrl) urlByPath.set(row.path, row.signedUrl);
      }
    }
    patientFiles = rows.map((f) => ({ ...f, signedUrl: urlByPath.get(f.storage_path) }));

    const photos = patientFiles.filter((f) => isImageFile(f.mime_type, f.file_name));
    const docs = patientFiles.filter((f) => !isImageFile(f.mime_type, f.file_name));

    filesPhotos.innerHTML = photos.map((f) => {
      const src = f.signedUrl ?? "";
      return `
        <li class="overflow-hidden rounded-xl bg-sand ring-1 ring-slate-100">
          <button type="button" data-open-file="${f.id}" class="block w-full">
            <img src="${escHtml(src)}" alt="${escHtml(f.file_name)}" class="aspect-square w-full object-cover bg-slate-100" />
          </button>
          <div class="flex items-start justify-between gap-1 px-2 py-1.5">
            <p class="min-w-0 truncate text-[11px] text-charcoal-muted">${escHtml(f.file_name)}<br>${escHtml(fileMetaLine(f))}</p>
            <button type="button" data-delete-file="${f.id}" class="flex h-8 w-8 flex-none items-center justify-center rounded-full text-red-600 hover:bg-red-50" aria-label="Διαγραφή">
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 4h10M6 4V3h4v1M6.5 7v5M9.5 7v5M4.5 4l.7 9h5.6l.7-9"/></svg>
            </button>
          </div>
        </li>`;
    }).join("");

    filesDocs.innerHTML = docs.map((f) => {
      const href = f.signedUrl ?? "#";
      return `
        <li class="flex items-center gap-3 rounded-xl bg-sand px-3 py-2.5">
          <a href="${escHtml(href)}" target="_blank" rel="noopener" class="min-w-0 flex-1">
            <p class="truncate font-display text-sm font-semibold text-charcoal">${escHtml(f.file_name)}</p>
            <p class="text-[11px] text-charcoal-muted">${escHtml(fileMetaLine(f))}</p>
          </a>
          <button type="button" data-delete-file="${f.id}" class="flex h-9 w-9 flex-none items-center justify-center rounded-full text-red-600 hover:bg-red-50" aria-label="Διαγραφή">
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 4h10M6 4V3h4v1M6.5 7v5M9.5 7v5M4.5 4l.7 9h5.6l.7-9"/></svg>
          </button>
        </li>`;
    }).join("");

    filesPhotos.classList.toggle("hidden", photos.length === 0);
    filesPhotos.classList.toggle("grid", photos.length > 0);
    filesDocs.classList.toggle("hidden", docs.length === 0);
    filesEmpty.classList.toggle("hidden", patientFiles.length > 0);
  }

  async function reloadFiles() {
    if (!id) return;
    const { data, error } = await supabase
      .from("patient_files")
      .select("*")
      .eq("patient_id", id)
      .order("created_at", { ascending: false });
    if (error) {
      filesError.textContent = error.message;
      filesError.classList.remove("hidden");
      return;
    }
    await renderFiles((data ?? []) as PatientFile[]);
  }

  filesInput.addEventListener("change", async () => {
    if (!id) return;
    const picked = Array.from(filesInput.files ?? []);
    filesInput.value = "";
    if (!picked.length) return;

    filesError.classList.add("hidden");
    filesInput.disabled = true;
    const rejected: string[] = [];
    const ready = picked.filter((file) => {
      if (file.size > FILE_MAX_BYTES) {
        rejected.push(`${file.name} (πάνω από 15 MB)`);
        return false;
      }
      if (!fileAllowed(file)) {
        rejected.push(`${file.name} (μη επιτρεπτός τύπος)`);
        return false;
      }
      return true;
    });
    if (rejected.length) {
      filesError.textContent = rejected.join(" · ");
      filesError.classList.remove("hidden");
    }
    if (!ready.length) {
      filesInput.disabled = false;
      return;
    }

    filesStatus.textContent = "Ανέβασμα…";
    try {
    for (let i = 0; i < ready.length; i++) {
      const file = ready[i]!;
      filesStatus.textContent = `Ανέβασμα ${i + 1}/${ready.length}…`;
      const path = `${id}/${crypto.randomUUID()}-${safeFileName(file.name)}`;
      const { error: upErr } = await supabase.storage.from(FILES_BUCKET).upload(path, file, {
        contentType: file.type || undefined,
        upsert: false,
      });
      if (upErr) {
        filesError.textContent = `${file.name}: ${upErr.message}`;
        filesError.classList.remove("hidden");
        continue;
      }
      const { error: rowErr } = await supabase.from("patient_files").insert({
        patient_id: id,
        storage_path: path,
        file_name: file.name,
        mime_type: file.type || null,
        size_bytes: file.size,
        uploaded_by: adminEmail || null,
      });
      if (rowErr) {
        await supabase.storage.from(FILES_BUCKET).remove([path]);
        filesError.textContent = `${file.name}: ${rowErr.message}`;
        filesError.classList.remove("hidden");
      }
    }
    } finally {
      filesStatus.textContent = "";
      filesInput.disabled = false;
    }
    await reloadFiles();
  });

  document.addEventListener("click", async (e) => {
    const t = e.target as HTMLElement;
    const openBtn = t.closest<HTMLElement>("[data-open-file]");
    if (openBtn) {
      const file = patientFiles.find((f) => f.id === openBtn.dataset.openFile);
      if (!file?.signedUrl) return;
      lightboxImg.src = file.signedUrl;
      lightboxImg.alt = file.file_name;
      lightboxCaption.textContent = `${file.file_name} · ${fileMetaLine(file)}`;
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      return;
    }
    const delBtn = t.closest<HTMLElement>("[data-delete-file]");
    if (delBtn) {
      const file = patientFiles.find((f) => f.id === delBtn.dataset.deleteFile);
      if (!file) return;
      if (!confirm(`Διαγραφή του αρχείου «${file.file_name}»;`)) return;
      const { error: stErr } = await supabase.storage.from(FILES_BUCKET).remove([file.storage_path]);
      const { error: dbErr } = await supabase.from("patient_files").delete().eq("id", file.id);
      if (stErr || dbErr) {
        filesError.textContent = (stErr ?? dbErr)!.message;
        filesError.classList.remove("hidden");
        return;
      }
      await reloadFiles();
    }
  });

  function closeLightbox() {
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    lightboxImg.src = "";
  }
  lightbox.querySelectorAll("[data-close-lightbox]").forEach((el) =>
    el.addEventListener("click", closeLightbox),
  );
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });

  load();
</script>
