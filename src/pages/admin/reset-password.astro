---
import "../../styles/global.css";
import "../../styles/admin.css";
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1d3e62" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="ORC Admin" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/admin/manifest.webmanifest" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Νέος κωδικός | ORC Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="admin-body flex min-h-dvh items-center justify-center bg-sand px-4" style="padding-top: env(safe-area-inset-top); padding-bottom: env(safe-area-inset-bottom)">
    <div class="w-full max-w-sm">
      <div class="mb-8 flex flex-col items-center">
        <img src="/orc-logo.png" alt="ORC" class="h-16 w-auto" />
        <h1 class="mt-4 font-display text-xl font-bold text-charcoal">Νέος κωδικός</h1>
        <p class="mt-1 text-center text-sm text-charcoal-muted">Όρισε νέο κωδικό για το admin</p>
      </div>

      <p id="reset-status" class="rounded-2xl bg-white p-6 text-center text-sm text-charcoal-muted shadow-sm ring-1 ring-slate-100">
        Έλεγχος συνδέσμου…
      </p>

      <form id="reset-form" class="hidden rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
        <label for="password" class="mb-1 block text-sm font-medium text-charcoal">Νέος κωδικός</label>
        <input
          id="password" name="password" type="password" autocomplete="new-password" required minlength="6"
          class="w-full rounded-lg border border-slate-300 px-3 py-3 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30"
        />

        <label for="password2" class="mb-1 mt-4 block text-sm font-medium text-charcoal">Επιβεβαίωση</label>
        <input
          id="password2" name="password2" type="password" autocomplete="new-password" required minlength="6"
          class="w-full rounded-lg border border-slate-300 px-3 py-3 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30"
        />

        <p id="reset-error" class="mt-3 hidden text-sm text-red-600"></p>

        <button
          type="submit" id="reset-btn"
          class="mt-5 min-h-12 w-full rounded-full bg-spine px-6 py-3.5 font-display font-semibold text-white transition active:scale-[0.99] hover:bg-spine-600 disabled:cursor-not-allowed disabled:opacity-60"
        >
          Αποθήκευση
        </button>
      </form>

      <p class="mt-6 text-center text-sm">
        <a href="/admin/login/" class="font-medium text-spine underline">Πίσω στη σύνδεση</a>
      </p>
    </div>

    <script>
      import { getSupabase, setRememberMe, resetSupabaseClient } from "../../lib/supabase";

      const statusEl = document.getElementById("reset-status")!;
      const form = document.getElementById("reset-form") as HTMLFormElement;
      const errEl = document.getElementById("reset-error")!;
      const btn = document.getElementById("reset-btn") as HTMLButtonElement;

      const params = new URLSearchParams(window.location.search);
      const hash = new URLSearchParams(window.location.hash.replace(/^#/, ""));
      const urlError =
        hash.get("error_description") ||
        params.get("error_description") ||
        hash.get("error") ||
        params.get("error");

      function showError(message: string) {
        statusEl.classList.remove("hidden");
        statusEl.textContent = message;
        statusEl.classList.add("text-red-600");
        form.classList.add("hidden");
      }

      function showForm() {
        statusEl.classList.add("hidden");
        form.classList.remove("hidden");
        history.replaceState({}, "", "/admin/reset-password/");
      }

      if (urlError) {
        showError(
          urlError.includes("expired") || urlError.includes("otp")
            ? "Ο σύνδεσμος έληξε. Στείλε νέο reset από το login."
            : "Ο σύνδεσμος δεν είναι έγκυρος. Στείλε νέο reset από το login.",
        );
      } else {
        setRememberMe(true);
        resetSupabaseClient();
        const supabase = getSupabase();
        let opened = false;

        const openIfReady = () => {
          if (opened) return;
          opened = true;
          showForm();
        };

        supabase.auth.onAuthStateChange((event, session) => {
          if (event === "PASSWORD_RECOVERY" || (session && event === "SIGNED_IN")) {
            openIfReady();
          }
        });

        supabase.auth.getSession().then(({ data: { session } }) => {
          if (session) openIfReady();
        });

        window.setTimeout(() => {
          if (!opened) {
            showError("Ο σύνδεσμος έληξε ή δεν οδηγεί σε αλλαγή κωδικού. Στείλε νέο από το login.");
          }
        }, 4000);

        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          errEl.classList.add("hidden");
          const fd = new FormData(form);
          const password = String(fd.get("password") || "");
          const password2 = String(fd.get("password2") || "");
          if (password.length < 6) {
            errEl.textContent = "Ο κωδικός πρέπει να έχει τουλάχιστον 6 χαρακτήρες.";
            errEl.classList.remove("hidden");
            return;
          }
          if (password !== password2) {
            errEl.textContent = "Οι κωδικοί δεν ταιριάζουν.";
            errEl.classList.remove("hidden");
            return;
          }
          btn.disabled = true;
          btn.textContent = "Αποθήκευση…";
          const { error } = await supabase.auth.updateUser({ password });
          if (error) {
            errEl.textContent = error.message === "New password should be different from the old password."
              ? "Διάλεξε διαφορετικό κωδικό από τον παλιό."
              : "Δεν αποθηκεύτηκε ο κωδικός. Δοκίμασε ξανά.";
            errEl.classList.remove("hidden");
            btn.disabled = false;
            btn.textContent = "Αποθήκευση";
            return;
          }
          window.location.replace("/admin");
        });
      }
    </script>
  </body>
</html>
