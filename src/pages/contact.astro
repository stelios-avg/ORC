---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { SITE } from "../config/site";
import { useTranslations } from "../i18n";

const lang = "el" as const;
const t = useTranslations(lang);
const c = t.contactPage;
const mapsQuery = encodeURIComponent(SITE.address);
---

<Layout lang={lang} title={t.seo.contactTitle} description={t.seo.contactDesc}>
  <PageHeader eyebrow={c.eyebrow} title={c.title} subtitle={c.subtitle} />

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <h2 class="font-display text-2xl font-bold text-charcoal">{c.visitTitle}</h2>
          <p class="mt-3 text-charcoal-muted">{c.visitSubtitle}</p>

          <dl class="mt-8 space-y-6">
            {[
              { label: c.addressLabel, icon: "M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0118 0z M12 10m-3 0a3 3 0 106 0 3 3 0 00-6 0", value: t.address, href: undefined },
              { label: c.phoneLabel,   icon: "M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 015.19 12.91a19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0122 16.92z", value: SITE.phone, href: SITE.phoneHref },
              { label: c.emailLabel,   icon: "M4 4h16v16H4z M22 6l-10 7L2 6", value: SITE.email, href: `mailto:${SITE.email}` },
            ].map(({ label, icon, value, href }) => (
              <div class="flex items-start gap-4">
                <span class="flex h-11 w-11 flex-none items-center justify-center rounded-xl bg-spine-50 text-spine">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icon}/></svg>
                </span>
                <div>
                  <dt class="text-sm font-semibold text-charcoal">{label}</dt>
                  <dd>
                    {href
                      ? <a href={href} class="text-charcoal-muted transition hover:text-spine">{value}</a>
                      : <span class="text-charcoal-muted">{value}</span>}
                  </dd>
                </div>
              </div>
            ))}

            <div class="flex items-start gap-4">
              <span class="flex h-11 w-11 flex-none items-center justify-center rounded-xl bg-spine-50 text-spine">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              </span>
              <div>
                <dt class="text-sm font-semibold text-charcoal">{c.hoursLabel}</dt>
                <dd class="text-charcoal-muted">
                  <ul class="space-y-1">
                    {t.hours.map((h) => (
                      <li class="flex gap-3"><span class="w-24">{h.day}</span><span>{h.time}</span></li>
                    ))}
                  </ul>
                </dd>
              </div>
            </div>
          </dl>

          <button type="button" data-book-trigger
            class="mt-8 inline-flex items-center justify-center rounded-full bg-spine px-7 py-3.5 font-display font-semibold text-white transition hover:bg-spine-600">
            {c.cta}
          </button>
        </div>

        <div class="rounded-2xl bg-sand p-8">
          <h2 class="font-display text-2xl font-bold text-charcoal">{c.messageTitle}</h2>
          <p class="mt-2 text-sm text-charcoal-muted">{c.messageSubtitle}</p>
          <form class="mt-6 space-y-4" id="contact-form" novalidate>
            <div>
              <label for="c-name" class="mb-1 block text-sm font-medium text-charcoal">{c.nameLabel}</label>
              <input id="c-name" name="name" type="text" required class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30"/>
            </div>
            <div>
              <label for="c-email" class="mb-1 block text-sm font-medium text-charcoal">{c.emailFormLabel}</label>
              <input id="c-email" name="email" type="email" required class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30"/>
            </div>
            <div>
              <label for="c-message" class="mb-1 block text-sm font-medium text-charcoal">{c.messageLabel}</label>
              <textarea id="c-message" name="message" rows="4" required class="w-full resize-none rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-charcoal focus:border-spine focus:outline-none focus:ring-2 focus:ring-spine/30"></textarea>
            </div>
            <button type="submit" class="w-full rounded-full bg-spine px-6 py-3 font-display font-semibold text-white transition hover:bg-spine-600">
              {c.submitBtn}
            </button>
            <p id="contact-status" class="hidden text-sm text-spine"></p>
          </form>
        </div>
      </div>

      <div class="mt-12 overflow-hidden rounded-2xl ring-1 ring-slate-100">
        <iframe title={c.mapTitle} class="h-80 w-full" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
          src={`https://maps.google.com/maps?q=${mapsQuery}&output=embed`}></iframe>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form   = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status");
  const successMsg = form?.closest("section")?.querySelector<HTMLElement>("[data-success-msg]")?.textContent || "Thanks!";
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }
    if (status) { status.textContent = successMsg; status.classList.remove("hidden"); }
    form.reset();
  });
</script>
