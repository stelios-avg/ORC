---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { useTranslations } from "../i18n";

const lang = "el" as const;
const t = useTranslations(lang);
const s = t.servicesPage;
---

<Layout lang={lang} title={t.seo.servicesTitle} description={t.seo.servicesDesc}>
  <PageHeader eyebrow={s.eyebrow} title={s.title} subtitle={s.subtitle} image="/images/page-hero.png" />

  {/* ── Stats row ── */}
  <section class="border-b border-slate-100 bg-white py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
        {s.stats.map((stat, i) => (
          <div class="stat-item text-center" style={`--si:${i}`}>
            <p class="font-display text-4xl font-extrabold text-spine sm:text-5xl">{stat.value}</p>
            <p class="mt-2 text-sm font-medium uppercase tracking-wide text-charcoal-muted">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Services grid — video background ── */}
  <section class="relative overflow-hidden bg-spine-900 py-20">
    <video
      class="absolute inset-0 h-full w-full object-cover lg:hidden"
      data-svc-bg-mobile
      autoplay muted loop playsinline preload="metadata"
      aria-hidden="true"
    >
      <source src="/videos/hero-mobile.mp4" type="video/mp4" />
    </video>
    <video
      class="absolute inset-0 hidden h-full w-full object-cover lg:block"
      data-svc-bg-desktop
      autoplay muted loop playsinline preload="metadata"
      aria-hidden="true"
    >
      <source src="/videos/hero.mp4" type="video/mp4" />
    </video>
    <script is:inline>
      (() => {
        var desktop = window.matchMedia("(min-width: 1024px)").matches;
        var v = document.querySelector(desktop ? "[data-svc-bg-mobile]" : "[data-svc-bg-desktop]");
        if (v) v.remove();
      })();
    </script>
    <div class="absolute inset-0 bg-spine-900/75"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 text-center">
        <p class="mb-2 font-display text-xs font-semibold uppercase tracking-widest text-spine-200">{s.servicesLabel}</p>
        <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">{s.servicesTagline}</h2>
      </div>
      <div class="grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-3">
        {s.list.map((svc, i) => (
          <div class="svc-card group flex flex-col rounded-2xl bg-white/[0.06] p-4 ring-1 ring-white/10 transition duration-300 hover:bg-white/[0.11] hover:-translate-y-1 sm:p-7" style={`--ci:${i}`}>
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-spine/20 p-2 sm:h-14 sm:w-14 sm:p-2.5">
              <img src={s.icons[i]} alt={svc.title} class="h-full w-full object-contain brightness-200 saturate-0" />
            </div>
            <h3 class="mt-3 font-display text-sm font-semibold text-white sm:mt-5 sm:text-lg">{svc.title}</h3>
            <p class="mt-1.5 hidden flex-1 text-sm leading-relaxed text-white/60 sm:block">{svc.desc}</p>
            <ul class="mt-2 space-y-1 sm:mt-4 sm:space-y-1.5">
              {svc.points.map((p) => (
                <li class="flex items-start gap-1.5 text-xs text-white/70 sm:text-sm">
                  <span class="mt-1.5 h-1 w-1 flex-none rounded-full bg-spine-300 sm:h-1.5 sm:w-1.5"/>
                  {p}
                </li>
              ))}
            </ul>
            <button type="button" data-book-trigger
              class="mt-4 inline-flex w-full items-center justify-center rounded-full border border-white/30 px-3 py-2 font-display text-xs font-semibold text-white transition hover:border-white hover:bg-white hover:text-spine-900 sm:mt-6 sm:px-5 sm:py-2.5 sm:text-sm">
              {s.bookBtn}
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Why choose us ── */}
  <section class="bg-white py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
        {/* Image */}
        <div class="why-img order-2 lg:order-1 flex justify-center">
          <div class="relative h-80 w-80 overflow-hidden rounded-[40%_60%_55%_45%/50%_45%_55%_50%] bg-spine-50 sm:h-96 sm:w-96">
            <img src={s.whyImage} alt={s.whyTitle}
              class="h-full w-full object-contain p-8"
              onerror="this.closest('div').classList.add('flex','items-center','justify-center'); this.remove();" />
          </div>
        </div>
        {/* Text */}
        <div class="why-text order-1 lg:order-2">
          <p class="mb-3 font-display text-xs font-semibold uppercase tracking-widest text-spine">{s.whyLabel}</p>
          <h2 class="font-display text-3xl font-bold text-charcoal sm:text-4xl">{s.whyTitle}</h2>
          <p class="mt-4 text-charcoal-muted">{s.whyDesc}</p>
          <ul class="mt-8 space-y-4">
            {s.whyPoints.map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-full bg-spine text-white">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M3 8l3.5 3.5L13 4"/>
                  </svg>
                </span>
                <span class="text-charcoal">{point}</span>
              </li>
            ))}
          </ul>
          <button type="button" data-book-trigger
            class="mt-9 inline-flex items-center justify-center rounded-full bg-spine px-7 py-3.5 font-display font-semibold text-white transition hover:bg-spine-600">
            {s.cta}
          </button>
        </div>
      </div>
    </div>
  </section>

  {/* ── CTA bottom ── */}
  <section class="bg-sand py-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h2 class="font-display text-2xl font-bold text-charcoal sm:text-3xl">{s.unsureTitle}</h2>
      <p class="mt-3 text-charcoal-muted">{s.unsureSubtitle}</p>
      <button type="button" data-book-trigger
        class="mt-7 inline-flex items-center justify-center rounded-full bg-spine px-7 py-3.5 font-display font-semibold text-white transition hover:bg-spine-600">
        {s.cta}
      </button>
    </div>
  </section>
</Layout>

<style>
  .stat-item {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--si) * 90ms);
  }
  .stat-item.visible { opacity: 1; transform: none; }

  .svc-card {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.3s ease,
      box-shadow 0.3s ease,
      translate 0.3s ease;
    transition-delay: calc(var(--ci) * 100ms);
  }
  .svc-card.visible { opacity: 1; transform: none; }

  .why-img {
    opacity: 0;
    transform: translateX(-24px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .why-img.visible { opacity: 1; transform: none; }

  .why-text {
    opacity: 0;
    transform: translateX(24px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 120ms;
  }
  .why-text.visible { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .stat-item, .svc-card, .why-img, .why-text { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("visible"); io.unobserve(e.target); } });
  }, { threshold: 0.1 });
  document.querySelectorAll(".stat-item, .svc-card, .why-img, .why-text").forEach((el) => io.observe(el));
</script>
