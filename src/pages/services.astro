---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { useTranslations } from "../i18n";

const lang = "el" as const;
const t = useTranslations(lang);
const s = t.servicesPage;
---

<Layout lang={lang} title={t.seo.servicesTitle} description={t.seo.servicesDesc}>
  <PageHeader eyebrow={s.eyebrow} title={s.title} subtitle={s.subtitle} image="/images/page-hero.png" />

  {/* ── Services grid ── */}
  <section class="relative overflow-hidden bg-sand py-20 sm:py-24">
    <div class="svc-ambient svc-ambient-a" aria-hidden="true"></div>
    <div class="svc-ambient svc-ambient-b" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="mb-2 font-display text-xs font-semibold uppercase tracking-widest text-spine">{s.servicesLabel}</p>
        <h2 class="font-display text-3xl font-bold text-charcoal sm:text-4xl">{s.servicesTagline}</h2>
      </div>
      <div class="mt-14 grid grid-cols-2 gap-x-4 gap-y-12 sm:gap-x-10 sm:gap-y-16 lg:grid-cols-3 lg:gap-x-14">
        {s.list.map((svc, i) => (
          <article class="svc-card group relative flex h-full flex-col" style={`--ci:${i}`}>
            <span class="pointer-events-none absolute -right-1 -top-8 select-none font-display text-5xl font-extrabold leading-none text-spine/15 sm:-top-10 sm:text-7xl" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="svc-icon-wrap relative mx-auto h-[4.75rem] w-[4.75rem] sm:h-28 sm:w-28 lg:mx-0 lg:h-32 lg:w-32">
              <div class="svc-icon-shadow absolute inset-1 bg-spine/20" aria-hidden="true"></div>
              <div class="svc-icon-blob relative flex h-full w-full items-center justify-center bg-spine-50">
                <img src={s.icons[i]} alt="" class="h-[68%] w-[68%] object-contain transition duration-500 group-hover:scale-110" />
              </div>
            </div>
            <h3 class="mt-4 font-display text-sm font-semibold text-charcoal transition-colors duration-300 group-hover:text-spine sm:mt-6 sm:text-2xl">
              {svc.title}
            </h3>
            <p class="mt-2 hidden text-sm leading-relaxed text-charcoal-muted sm:block">{svc.desc}</p>
            <ul class="mt-3 flex-1 space-y-1.5 sm:mt-5 sm:space-y-2.5">
              {svc.points.map((p, pi) => (
                <li class="svc-point flex items-start gap-1.5 text-xs text-charcoal sm:gap-2.5 sm:text-sm" style={`--pi:${pi}`}>
                  <span class="mt-1.5 h-1 w-1 flex-none rounded-full bg-spine sm:mt-2 sm:h-1.5 sm:w-1.5" />
                  {p}
                </li>
              ))}
            </ul>
            <button type="button" data-book-trigger
              class="mt-4 inline-flex min-h-10 items-center gap-2.5 sm:mt-8 sm:min-h-12 sm:gap-4">
              <span class="h-7 w-7 flex-none rounded-full bg-spine transition-transform duration-500 ease-out group-hover:scale-[1.65] sm:h-9 sm:w-9 sm:group-hover:scale-[1.85]"></span>
              <span class="font-display text-xs font-semibold text-charcoal transition-colors duration-300 group-hover:text-spine sm:text-base">
                {s.bookBtn}
              </span>
            </button>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ── Why choose us ── */}
  <section class="bg-white py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
        {/* Image — photo clipped to the organic graphic, not a square frame */}
        <div class="why-img order-2 lg:order-1 flex justify-center">
          <div class="why-blob-wrap relative h-80 w-80 sm:h-[26rem] sm:w-[26rem]">
            <div class="why-blob-shadow absolute inset-3 translate-x-3 translate-y-4 bg-spine/25" aria-hidden="true"></div>
            <div class="why-blob relative h-full w-full overflow-hidden bg-spine-50 shadow-lg shadow-spine/10">
              <img
                src={s.whyImage}
                alt={s.whyTitle}
                class="h-full w-full object-cover object-[center_28%]"
                loading="lazy"
              />
            </div>
          </div>
        </div>
        {/* Text */}
        <div class="why-text order-1 lg:order-2">
          <p class="mb-3 font-display text-xs font-semibold uppercase tracking-widest text-spine">{s.whyLabel}</p>
          <h2 class="font-display text-3xl font-bold text-charcoal sm:text-4xl">{s.whyTitle}</h2>
          <p class="mt-4 text-charcoal-muted">{s.whyDesc}</p>
          <ul class="mt-8 space-y-4">
            {s.whyPoints.map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-full bg-spine text-white">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M3 8l3.5 3.5L13 4"/>
                  </svg>
                </span>
                <span class="text-charcoal">{point}</span>
              </li>
            ))}
          </ul>
          <button type="button" data-book-trigger
            class="mt-9 inline-flex items-center justify-center rounded-full bg-spine px-7 py-3.5 font-display font-semibold text-white transition hover:bg-spine-600">
            {s.cta}
          </button>
        </div>
      </div>
    </div>
  </section>

  {/* ── CTA bottom ── */}
  <section class="bg-sand py-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h2 class="font-display text-2xl font-bold text-charcoal sm:text-3xl">{s.unsureTitle}</h2>
      <p class="mt-3 text-charcoal-muted">{s.unsureSubtitle}</p>
      <button type="button" data-book-trigger
        class="mt-7 inline-flex items-center justify-center rounded-full bg-spine px-7 py-3.5 font-display font-semibold text-white transition hover:bg-spine-600">
        {s.cta}
      </button>
    </div>
  </section>
</Layout>

<style>
  .svc-card {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--ci) * 120ms);
  }
  .svc-card.visible { opacity: 1; transform: none; }

  .svc-icon-blob,
  .svc-icon-shadow,
  .svc-ambient {
    border-radius: 40% 60% 55% 45% / 50% 45% 55% 50%;
  }
  .svc-icon-blob {
    animation: blob-morph 11s ease-in-out infinite;
    animation-delay: calc(var(--ci) * -4s);
  }
  .svc-icon-shadow {
    animation: blob-morph 15s ease-in-out infinite reverse;
    animation-delay: calc(var(--ci) * -2.5s);
  }
  .svc-card.visible .svc-icon-wrap {
    animation: blob-float 8s ease-in-out infinite;
    animation-delay: calc(var(--ci) * 0.35s);
  }

  .svc-point {
    opacity: 0;
    transform: translateY(8px);
  }
  .svc-card.visible .svc-point {
    animation: svc-point-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(220ms + var(--pi) * 45ms);
  }

  .svc-ambient {
    position: absolute;
    pointer-events: none;
  }
  .svc-ambient-a {
    left: -9rem;
    top: 12%;
    height: 22rem;
    width: 22rem;
    background: rgb(29 62 98 / 0.07);
    animation: blob-morph 22s ease-in-out infinite, blob-float 16s ease-in-out infinite;
  }
  .svc-ambient-b {
    right: -8rem;
    bottom: 6%;
    height: 18rem;
    width: 18rem;
    background: rgb(29 62 98 / 0.05);
    animation: blob-morph 26s ease-in-out infinite reverse, blob-float 19s ease-in-out infinite reverse;
  }

  .why-img {
    opacity: 0;
    transform: translateX(-24px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .why-img.visible { opacity: 1; transform: none; }

  .why-text {
    opacity: 0;
    transform: translateX(24px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 120ms;
  }
  .why-text.visible { opacity: 1; transform: none; }

  .why-blob,
  .why-blob-shadow {
    border-radius: 40% 60% 55% 45% / 50% 45% 55% 50%;
  }
  .why-blob {
    animation: blob-morph 12s ease-in-out infinite;
  }
  .why-blob-shadow {
    animation: blob-morph 16s ease-in-out infinite reverse;
  }
  .why-img.visible .why-blob-wrap {
    animation: blob-float 9s ease-in-out infinite;
  }

  @keyframes blob-morph {
    0%, 100% { border-radius: 40% 60% 55% 45% / 50% 45% 55% 50%; }
    25% { border-radius: 58% 42% 48% 52% / 42% 58% 48% 52%; }
    50% { border-radius: 48% 52% 62% 38% / 58% 42% 52% 48%; }
    75% { border-radius: 42% 58% 40% 60% / 48% 52% 58% 42%; }
  }
  @keyframes blob-float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(8px, -12px); }
  }
  @keyframes svc-point-in {
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-card, .why-img, .why-text { opacity: 1; transform: none; transition: none; }
    .svc-point { opacity: 1; transform: none; animation: none; }
    .svc-icon-blob, .svc-icon-shadow, .svc-card.visible .svc-icon-wrap,
    .svc-ambient, .why-blob, .why-blob-shadow, .why-img.visible .why-blob-wrap { animation: none; }
  }
</style>

<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("visible"); io.unobserve(e.target); } });
  }, { threshold: 0.1 });
  document.querySelectorAll(".svc-card, .why-img, .why-text").forEach((el) => io.observe(el));
</script>
